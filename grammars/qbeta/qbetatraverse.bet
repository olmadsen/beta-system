ORIGIN 'qbetacfl';
BODY 'qbetatraversebody';

(* Skeleton file for traversal of ASTs based on
 * grammar 'qbeta'.
 * Take a copy of this file and fill out the do-parts.
 * Do NOT edit this file directly as it will be overwritten
 * when the grammar is processed again.
 *)
--LIB: attributes--

qbeta_traverse: 
  (# ast: @astInterface (* An instance of the AST interface *);
     qbeta: @ast.qbeta;

     do_Module: (* cons *)
       (# M: ^qbeta.Module
       enter M[]
       <<SLOT do_Module_body: DoPart>>
       #);
     do_ObjectDescriptor: (* cons *)
       (# O: ^qbeta.ObjectDescriptor
       enter O[]
       <<SLOT do_ObjectDescriptor_body: DoPart>>
       #);
     do_Super: (* optional *)
       (# a: ^astinterface.ast;
       enter a[]
       <<SLOT do_Super_body: DoPart>>
       #);
     do_Items: (* list *)
       (# I: ^qbeta.Items
       enter I[]
       <<SLOT do_Items_body: DoPart>>
       #);
     do_ItemOpt: (* optional *)
       (# a: ^astinterface.ast;
       enter a[]
       <<SLOT do_ItemOpt_body: DoPart>>
       #);
     do_Item: (* alternation *)
       (# I: ^qbeta.Item
       enter I[]
       <<SLOT do_Item_body: DoPart>>
       #);
     do_Decl: (* alternation *)
       (# D: ^qbeta.Decl
       enter D[]
       <<SLOT do_Decl_body: DoPart>>
       #);
     do_MandatoryParameter: (* cons *)
       (# M: ^qbeta.MandatoryParameter
       enter M[]
       <<SLOT do_MandatoryParameter_body: DoPart>>
       #);
     do_OptionalParameter: (* cons *)
       (# O: ^qbeta.OptionalParameter
       enter O[]
       <<SLOT do_OptionalParameter_body: DoPart>>
       #);
     do_ReturnDatum: (* cons *)
       (# R: ^qbeta.ReturnDatum
       enter R[]
       <<SLOT do_ReturnDatum_body: DoPart>>
       #);
     do_VirtualAttribute: (* alternation *)
       (# V: ^qbeta.VirtualAttribute
       enter V[]
       <<SLOT do_VirtualAttribute_body: DoPart>>
       #);
     do_VirtualDataItem: (* cons *)
       (# V: ^qbeta.VirtualDataItem
       enter V[]
       <<SLOT do_VirtualDataItem_body: DoPart>>
       #);
     do_VirtualPattern: (* cons *)
       (# V: ^qbeta.VirtualPattern
       enter V[]
       <<SLOT do_VirtualPattern_body: DoPart>>
       #);
     do_Names: (* list *)
       (# N: ^qbeta.Names
       enter N[]
       <<SLOT do_Names_body: DoPart>>
       #);
     do_Binding: (* alternation *)
       (# B: ^qbeta.Binding
       enter B[]
       <<SLOT do_Binding_body: DoPart>>
       #);
     do_FurtherBinding: (* cons *)
       (# F: ^qbeta.FurtherBinding
       enter F[]
       <<SLOT do_FurtherBinding_body: DoPart>>
       #);
     do_FinalBinding: (* cons *)
       (# F: ^qbeta.FinalBinding
       enter F[]
       <<SLOT do_FinalBinding_body: DoPart>>
       #);
     do_LocalAttribute: (* alternation *)
       (# L: ^qbeta.LocalAttribute
       enter L[]
       <<SLOT do_LocalAttribute_body: DoPart>>
       #);
     do_LocalDataItemI: (* cons *)
       (# L: ^qbeta.LocalDataItemI
       enter L[]
       <<SLOT do_LocalDataItemI_body: DoPart>>
       #);
     do_LocalDataItemII: (* cons *)
       (# L: ^qbeta.LocalDataItemII
       enter L[]
       <<SLOT do_LocalDataItemII_body: DoPart>>
       #);
     do_LocalPattern: (* cons *)
       (# L: ^qbeta.LocalPattern
       enter L[]
       <<SLOT do_LocalPattern_body: DoPart>>
       #);
     do_DataKind: (* alternation *)
       (# D: ^qbeta.DataKind
       enter D[]
       <<SLOT do_DataKind_body: DoPart>>
       #);
     do_ConstantKind: (* cons *)
       (# C: ^qbeta.ConstantKind
       enter C[]
       <<SLOT do_ConstantKind_body: DoPart>>
       #);
     do_VariableKind: (* cons *)
       (# V: ^qbeta.VariableKind
       enter V[]
       <<SLOT do_VariableKind_body: DoPart>>
       #);
     do_ObjectSpecification: (* alternation *)
       (# O: ^qbeta.ObjectSpecification
       enter O[]
       <<SLOT do_ObjectSpecification_body: DoPart>>
       #);
     do_Exp: (* alternation *)
       (# E: ^qbeta.Exp
       enter E[]
       <<SLOT do_Exp_body: DoPart>>
       #);
     do_Assignment: (* cons *)
       (# A: ^qbeta.Assignment
       enter A[]
       <<SLOT do_Assignment_body: DoPart>>
       #);
     do_AttributeDenotation: (* alternation *)
       (# A: ^qbeta.AttributeDenotation
       enter A[]
       <<SLOT do_AttributeDenotation_body: DoPart>>
       #);
     do_ObjectDenotation: (* cons *)
       (# O: ^qbeta.ObjectDenotation
       enter O[]
       <<SLOT do_ObjectDenotation_body: DoPart>>
       #);
     do_ArgumentsOpt: (* optional *)
       (# a: ^astinterface.ast;
       enter a[]
       <<SLOT do_ArgumentsOpt_body: DoPart>>
       #);
     do_Arguments: (* alternation *)
       (# A: ^qbeta.Arguments
       enter A[]
       <<SLOT do_Arguments_body: DoPart>>
       #);
     do_FunctionalArgs: (* cons *)
       (# F: ^qbeta.FunctionalArgs
       enter F[]
       <<SLOT do_FunctionalArgs_body: DoPart>>
       #);
     do_exps: (* list *)
       (# e: ^qbeta.exps
       enter e[]
       <<SLOT do_exps_body: DoPart>>
       #);
     do_RemoteAttribute: (* cons *)
       (# R: ^qbeta.RemoteAttribute
       enter R[]
       <<SLOT do_RemoteAttribute_body: DoPart>>
       #);
     do_BinaryAttribute: (* cons *)
       (# B: ^qbeta.BinaryAttribute
       enter B[]
       <<SLOT do_BinaryAttribute_body: DoPart>>
       #);
     do_ThisObject: (* cons *)
       (# T: ^qbeta.ThisObject
       enter T[]
       <<SLOT do_ThisObject_body: DoPart>>
       #);
     do_SingularObjectInvocation: (* cons *)
       (# S: ^qbeta.SingularObjectInvocation
       enter S[]
       <<SLOT do_SingularObjectInvocation_body: DoPart>>
       #);
     do_Invocation: (* alternation *)
       (# I: ^qbeta.Invocation
       enter I[]
       <<SLOT do_Invocation_body: DoPart>>
       #);
     do_AttributeDenotationX: (* cons *)
       (# A: ^qbeta.AttributeDenotationX
       enter A[]
       <<SLOT do_AttributeDenotationX_body: DoPart>>
       #);
     do_BracketedExp: (* cons *)
       (# B: ^qbeta.BracketedExp
       enter B[]
       <<SLOT do_BracketedExp_body: DoPart>>
       #);
     do_Property: (* cons *)
       (# P: ^qbeta.Property
       enter P[]
       <<SLOT do_Property_body: DoPart>>
       #);
     do_ExpsOpt: (* optional *)
       (# a: ^astinterface.ast;
       enter a[]
       <<SLOT do_ExpsOpt_body: DoPart>>
       #);
     do_Slot: (* cons *)
       (# S: ^qbeta.Slot
       enter S[]
       <<SLOT do_Slot_body: DoPart>>
       #);
     do_Dots: (* cons *)
       (# D: ^qbeta.Dots
       enter D[]
       <<SLOT do_Dots_body: DoPart>>
       #);
     do_Constant: (* alternation *)
       (# C: ^qbeta.Constant
       enter C[]
       <<SLOT do_Constant_body: DoPart>>
       #);
     do_NameDcl: (* cons *)
       (# N: ^qbeta.NameDcl
       enter N[]
       <<SLOT do_NameDcl_body: DoPart>>
       #);
     do_NameApl: (* cons *)
       (# N: ^qbeta.NameApl
       enter N[]
       <<SLOT do_NameApl_body: DoPart>>
       #);
     do_NumberLiteral: (* cons *)
       (# N: ^qbeta.NumberLiteral
       enter N[]
       <<SLOT do_NumberLiteral_body: DoPart>>
       #);
     do_StringLiteral: (* cons *)
       (# S: ^qbeta.StringLiteral
       enter S[]
       <<SLOT do_StringLiteral_body: DoPart>>
       #);
     do_SpecialChars: (* list *)
       (# S: ^qbeta.SpecialChars
       enter S[]
       <<SLOT do_SpecialChars_body: DoPart>>
       #);
     do_Specialchar: (* alternation *)
       (# S: ^qbeta.Specialchar
       enter S[]
       <<SLOT do_Specialchar_body: DoPart>>
       #);
     do_Plus: (* cons *)
       (# P: ^qbeta.Plus
       enter P[]
       <<SLOT do_Plus_body: DoPart>>
       #);
     do_Minus: (* cons *)
       (# M: ^qbeta.Minus
       enter M[]
       <<SLOT do_Minus_body: DoPart>>
       #);
     do_Mult: (* cons *)
       (# M: ^qbeta.Mult
       enter M[]
       <<SLOT do_Mult_body: DoPart>>
       #);
     do_Divx: (* cons *)
       (# D: ^qbeta.Divx
       enter D[]
       <<SLOT do_Divx_body: DoPart>>
       #);
     do_Exl: (* cons *)
       (# E: ^qbeta.Exl
       enter E[]
       <<SLOT do_Exl_body: DoPart>>
       #);
     do_Amp: (* cons *)
       (# A: ^qbeta.Amp
       enter A[]
       <<SLOT do_Amp_body: DoPart>>
       #);

     do_nameDecl: (* lexem *)
       (# n: ^astinterface.nameDecl;
          getText: (# exit n.getText #);
       enter n[] 
       do INNER;
       #);
     do_nameAppl: (* lexem *)
       (# n: ^astinterface.nameAppl;
          getText: (# exit n.getText #);
       enter n[] 
       do INNER;
       #);
     do_const: (* lexem *)
       (# c: ^astinterface.const;
          getText: (# exit c.getText #);
          getValue: (# exit c.getValue #);
       enter c[] 
       do INNER;
       #);
     do_string: (* lexem *)
       (# s: ^astinterface.string;
          getText: (# exit s.getText #);
       enter s[] 
       do INNER;
       #);
     init: (* Initialization of astLevel and parser *)
       (# 
       <<SLOT qbeta_init_body: DoPart>>
       #);
  #);
