ORIGIN 'qbetatraverse';

--LIB: attributes--

GrammarPath: (# exit '~beta/grammars/qbeta/qbeta' #);
BobsTab:     (# exit '~beta/grammars/qbeta/qbeta-parser.btab' #);

-- do_Module_body: DoPart --
do M.getNameDcl -> do_NameDcl;
   M.getDataKind -> do_DataKind;

-- do_ObjectDescriptor_body: DoPart --
do O.getSuper -> do_Super;
   O.getItems -> do_Items;

-- do_Super_body: DoPart --
do (if a.kind<>ast.kinds.optional then
       a[] -> do_AttributeDenotation;
   if);

-- do_Items_body: DoPart --
do I.newscan
   (#
   do current[] -> do_Item;
   #);

-- do_ItemOpt_body: DoPart --
do (if a.kind<>ast.kinds.optional then
       a[] -> do_Item;
   if);

-- do_Item_body: DoPart --
do (if I.symbol
       (* sub-alternation <Decl>: *)
    // qbeta.MandatoryParameter then
       I[] -> do_MandatoryParameter;
    // qbeta.ReturnDatum then
       I[] -> do_ReturnDatum;
    // qbeta.OptionalParameter then
       I[] -> do_OptionalParameter;
       (* sub-alternation <Binding>: *)
    // qbeta.Furtherbinding then
       I[] -> do_Furtherbinding;
    // qbeta.FinalBinding then
       I[] -> do_FinalBinding;
       (* End sub-alternation <Binding> *)
       (* sub-alternation <LocalAttribute>: *)
    // qbeta.LocalDataItem then
       I[] -> do_LocalDataItem;
    // qbeta.LocalPattern then
       I[] -> do_LocalPattern;
       (* End sub-alternation <LocalAttribute> *)
       (* End sub-alternation <Decl> *)
       (* sub-alternation <Exp>: *)
    // qbeta.Assignment then
       I[] -> do_Assignment;
       (* sub-alternation <Invocation>: *)
    // qbeta.AttributeDenotationX then
       I[] -> do_AttributeDenotationX;
    // qbeta.SingularObjectInvocation then
       I[] -> do_SingularObjectInvocation;
       (* End sub-alternation <Invocation> *)
    // qbeta.BracketedExp then
       I[] -> do_BracketedExp;
       (* sub-alternation <Constant>: *)
    // qbeta.IntegerConst then
       I[] -> do_IntegerConst;
    // qbeta.FloatConst then
       I[] -> do_FloatConst;
    // qbeta.CharConst then
       I[] -> do_CharConst;
    // qbeta.StringLiteral then
       I[] -> do_StringLiteral;
       (* End sub-alternation <Constant> *)
       (* End sub-alternation <Exp> *)
    // qbeta.Property then
       I[] -> do_Property;
    // qbeta.Slot then
       I[] -> do_Slot;
    // qbeta.Dots then
       I[] -> do_Dots;
    if);

-- do_Decl_body: DoPart --
do (if D.symbol
    // qbeta.MandatoryParameter then
       D[] -> do_MandatoryParameter;
    // qbeta.ReturnDatum then
       D[] -> do_ReturnDatum;
    // qbeta.OptionalParameter then
       D[] -> do_OptionalParameter;
       (* sub-alternation <Binding>: *)
    // qbeta.Furtherbinding then
       D[] -> do_Furtherbinding;
    // qbeta.FinalBinding then
       D[] -> do_FinalBinding;
       (* End sub-alternation <Binding> *)
       (* sub-alternation <LocalAttribute>: *)
    // qbeta.LocalDataItem then
       D[] -> do_LocalDataItem;
    // qbeta.LocalPattern then
       D[] -> do_LocalPattern;
       (* End sub-alternation <LocalAttribute> *)
    if);

-- do_MandatoryParameter_body: DoPart --
do M.getVirtualAttribute -> do_VirtualAttribute;

-- do_OptionalParameter_body: DoPart --
do O.getVirtualAttribute -> do_VirtualAttribute;

-- do_ReturnDatum_body: DoPart --
do R.getnames -> do_names;
   R.getDataKind -> do_DataKind;

-- do_VirtualAttribute_body: DoPart --
do (if V.symbol
    // qbeta.VirtualDataItem then
       V[] -> do_VirtualDataItem;
    // qbeta.VirtualPattern then
       V[] -> do_VirtualPattern;
    if);

-- do_VirtualDataItem_body: DoPart --
do V.getnames -> do_names;
   V.getDataKind -> do_DataKind;

-- do_VirtualPattern_body: DoPart --
do V.getnames -> do_names;
   V.getObjectSpecification -> do_ObjectSpecification;

-- do_Names_body: DoPart --
do N.newscan
   (#
   do current[] -> do_NameDcl;
   #);

-- do_Binding_body: DoPart --
do (if B.symbol
    // qbeta.Furtherbinding then
       B[] -> do_Furtherbinding;
    // qbeta.FinalBinding then
       B[] -> do_FinalBinding;
    if);

-- do_FurtherBinding_body: DoPart --
do F.getNameApl -> do_NameApl;
   F.getObjectSpecification -> do_ObjectSpecification;

-- do_FinalBinding_body: DoPart --
do F.getNameApl -> do_NameApl;
   F.getObjectSpecification -> do_ObjectSpecification;

-- do_LocalAttribute_body: DoPart --
do (if L.symbol
    // qbeta.LocalDataItem then
       L[] -> do_LocalDataItem;
    // qbeta.LocalPattern then
       L[] -> do_LocalPattern;
    if);

-- do_LocalDataItem_body: DoPart --
do L.getnames -> do_names;
   L.getDataKind -> do_DataKind;

-- do_LocalPattern_body: DoPart --
do L.getnames -> do_names;
   L.getObjectDescriptor -> do_ObjectDescriptor;

-- do_DataKind_body: DoPart --
do (if D.symbol
    // qbeta.ConstantKind then
       D[] -> do_ConstantKind;
    // qbeta.VariableKind then
       D[] -> do_VariableKind;
    if);

-- do_ConstantKind_body: DoPart --
do C.getObjectSpecification -> do_ObjectSpecification;

-- do_VariableKind_body: DoPart --
do V.getObjectSpecification -> do_ObjectSpecification;

-- do_ObjectSpecification_body: DoPart --
do (if O.symbol
    // qbeta.ObjectDescriptor then
       O[] -> do_ObjectDescriptor;
       (* sub-alternation <AttributeDenotation>: *)
    // qbeta.ObjectDenotation then
       O[] -> do_ObjectDenotation;
    // qbeta.Remote then
       O[] -> do_Remote;
    // qbeta.BinaryMethod then
       O[] -> do_BinaryMethod;
    // qbeta.ThisObject then
       O[] -> do_ThisObject;
       (* End sub-alternation <AttributeDenotation> *)
    if);

-- do_Exp_body: DoPart --
do (if E.symbol
    // qbeta.Assignment then
       E[] -> do_Assignment;
       (* sub-alternation <Invocation>: *)
    // qbeta.AttributeDenotationX then
       E[] -> do_AttributeDenotationX;
    // qbeta.SingularObjectInvocation then
       E[] -> do_SingularObjectInvocation;
       (* End sub-alternation <Invocation> *)
    // qbeta.BracketedExp then
       E[] -> do_BracketedExp;
       (* sub-alternation <Constant>: *)
    // qbeta.IntegerConst then
       E[] -> do_IntegerConst;
    // qbeta.FloatConst then
       E[] -> do_FloatConst;
    // qbeta.CharConst then
       E[] -> do_CharConst;
    // qbeta.StringLiteral then
       E[] -> do_StringLiteral;
       (* End sub-alternation <Constant> *)
    if);

-- do_Assignment_body: DoPart --
do A.getAttributeDenotation -> do_AttributeDenotation;
   A.getExp -> do_Exp;

-- do_AttributeDenotation_body: DoPart --
do (if A.symbol
    // qbeta.ObjectDenotation then
       A[] -> do_ObjectDenotation;
    // qbeta.Remote then
       A[] -> do_Remote;
    // qbeta.BinaryMethod then
       A[] -> do_BinaryMethod;
    // qbeta.ThisObject then
       A[] -> do_ThisObject;
    if);

-- do_ObjectDenotation_body: DoPart --
do O.getNameApl -> do_NameApl;
   O.getArgumentsOpt -> do_ArgumentsOpt;

-- do_ArgumentsOpt_body: DoPart --
do (if a.kind<>ast.kinds.optional then
       a[] -> do_Arguments;
   if);

-- do_Arguments_body: DoPart --
do (if A.symbol
    // qbeta.FunctionalArgs then
       A[] -> do_FunctionalArgs;
    if);

-- do_FunctionalArgs_body: DoPart --
do F.getexps -> do_exps;

-- do_exps_body: DoPart --
do e.newscan
   (#
   do current[] -> do_Exp;
   #);

-- do_Remote_body: DoPart --
do R.getAttributeDenotation -> do_AttributeDenotation;
   R.getObjectDenotation -> do_ObjectDenotation;

-- do_BinaryMethod_body: DoPart --
do B.getAttributeDenotation -> do_AttributeDenotation;
   B.getSpecialChar -> do_SpecialChar;
   B.getExp -> do_Exp;

-- do_Specialchar_body: DoPart --
do (if S.symbol
    // qbeta.Plus then
       S[] -> do_Plus;
    // qbeta.Minus then
       S[] -> do_Minus;
    // qbeta.Mult then
       S[] -> do_Mult;
    // qbeta.Div then
       S[] -> do_Div;
    if);

-- do_Plus_body: DoPart --
do 

-- do_Minus_body: DoPart --
do 

-- do_Mult_body: DoPart --
do 

-- do_Div_body: DoPart --
do 

-- do_ThisObject_body: DoPart --
do T.getNameApl -> do_NameApl;

-- do_SingularObjectInvocation_body: DoPart --
do S.getObjectDescriptor -> do_ObjectDescriptor;

-- do_Invocation_body: DoPart --
do (if I.symbol
    // qbeta.AttributeDenotationX then
       I[] -> do_AttributeDenotationX;
    // qbeta.SingularObjectInvocation then
       I[] -> do_SingularObjectInvocation;
    if);

-- do_AttributeDenotationX_body: DoPart --
do A.getAttributeDenotation -> do_AttributeDenotation;

-- do_BracketedExp_body: DoPart --
do B.getExp -> do_Exp;

-- do_Property_body: DoPart --
do P.getNameApl -> do_NameApl;

-- do_Slot_body: DoPart --
do S.getNameApl -> do_NameApl;

-- do_Dots_body: DoPart --
do 

-- do_Constant_body: DoPart --
do (if C.symbol
    // qbeta.IntegerConst then
       C[] -> do_IntegerConst;
    // qbeta.FloatConst then
       C[] -> do_FloatConst;
    // qbeta.CharConst then
       C[] -> do_CharConst;
    // qbeta.StringLiteral then
       C[] -> do_StringLiteral;
    if);

-- do_NameDcl_body: DoPart --
do N.getNameDecl -> do_NameDecl;

-- do_NameApl_body: DoPart --
do N.getNameAppl -> do_NameAppl;

-- do_IntegerConst_body: DoPart --
do I.getConst -> do_Const;

-- do_FloatConst_body: DoPart --
do 

-- do_CharConst_body: DoPart --
do C.getString -> do_String;

-- do_StringLiteral_body: DoPart --
do S.getString -> do_String;

-- qbeta_init_body: DoPart --
do ast.astLevelInit;
   (* Alternative to using findGrammar: *)
   ('qbeta', '.qbeta', GrammarPath->ast.expandToFullPath)
     -> ast.registergrammar;
   qbeta.init; 
   BobsTab -> ast.expandToFullPath -> qbeta.parser.initialize
   (# SplitString::(# do true->value #);
   #);
