--- qbeta : aGrammar : metagrammar ---
Grammar qbeta:

Option
  version  = 1
  comBegin = '--'
  comEnd   = '?'
  stringChar = '"' 
  splitString = true
  suffix = '.qbeta'

Rule

<Module> ::= <NameDcl> ':' 'obj' <DataKind>;

<ObjectDescriptor> ::= <Super> '{' <Items> '}';

<Super> ::? <AttributeDenotation>; (* or Invocation? *)

<Items> ::+  <ItemOpt> ';' ;
<ItemOpt> ::? <Item> ; 
<Item> ::| <Decl> | <Exp> | <Property> | <Slot> | <Dots>;

<Decl> ::| <MandatoryParameter>
         | <ReturnDatum>
         | <OptionalParameter>
         | <Binding>
         | <LocalAttribute>
         ;

<MandatoryParameter> ::= 'in' <VirtualAttribute>;
<OptionalParameter> ::= <VirtualAttribute>;
<ReturnDatum> ::= 'out' <names> ':' <DataKind> ;

<VirtualAttribute> ::| <VirtualDataItem> | <VirtualPattern>;
<VirtualDataItem> ::= <names> ':<' <DataKind>;
<VirtualPattern> ::= 'def' <names> ':<' <ObjectSpecification>;

<Names> ::* <NameDcl> ',' ;

<Binding> ::| <Furtherbinding> | <FinalBinding> ;
<FurtherBinding> ::= <NameApl> '::<' <ObjectSpecification>;
<FinalBinding> ::= <NameApl> '::' <ObjectSpecification>;

<LocalAttribute> ::| <LocalDataItem> | <LocalPattern>;
<LocalDataItem> ::= <names> ':' <DataKind>;
<LocalPattern> ::= 'def' <names> ':' <ObjectDescriptor>;

<DataKind> ::| <ConstantKind> | <VariableKind>;
<ConstantKind> ::= <ObjectSpecification>;
<VariableKind> ::= 'var' <ObjectSpecification> ;

<ObjectSpecification> ::| <ObjectDescriptor>
                        | <AttributeDenotation>
                        ;

<Exp> ::| <Assignment> | <Invocation> | <BracketedExp> | <Constant>;

<Assignment> ::= <AttributeDenotation> ':=' <Exp> ;

(*<Invocation> ::= <ObjectInvocation>;*) (* <Accessor> ;*)

(*<ObjectInvocation> ::| <NameApl>
                    | <IdfArg>
                    | <SpecialInv>
                    | <SingularObjectInvocation>
                    ;
<AttributeDenotation> ::= <NameApl>; 
<IdfArg> ::= <NameApl> '(' <Arguments> ')' ;
<SpecialInv> ::= <Special> <Argument> ;
<Special> ::|  <dot> | <empty> ;
<dot> ::= '.';*)
(*<Accessor> ::= '.' ;*)

<AttributeDenotation> ::| <ObjectDenotation>
                        | <Remote>
                        | <BinaryMethod>
                        | <ThisObject>
                        ;
<ObjectDenotation> ::= <NameApl> <ArgumentsOpt> ;
<ArgumentsOpt> ::? <Arguments> ;
<Arguments> ::| <FunctionalArgs>; (* | <BindingsArgs> ;*)
<FunctionalArgs> ::=  '(' <exps> ')' ;
<exps> ::+ <Exp> ',' ;
(*<BindingsArgs> ::= '{' <Bindings> '}' ;
<Bindings> ::+ <Binding> ';' ;*)

<Remote> ::= <AttributeDenotation> '.' <ObjectDenotation> ;

<BinaryMethod> ::= <AttributeDenotation> <SpecialChar> <Exp> ;
<Specialchar> ::| <Plus> | <Minus>  | <Mult> | <Div> ;
<Plus> ::= '+' ;
<Minus> ::= '-';
<Mult> ::= '*' ;
<Div> ::= '/' ;

<ThisObject> ::= 'this' '(' <NameApl> ')' ;
(* No, not as super *)
<SingularObjectInvocation> ::= <ObjectDescriptor>; (* including bindings *)

<Invocation> ::| <AttributeDenotationX> | <SingularObjectInvocation> ;

<AttributeDenotationX> ::= <AttributeDenotation> ;


<BracketedExp> ::= '(' <Exp> ')' ;

(*<Arguments> ::+ <Argument> ',' ; ( * do we have this or only bindings? * )
<Argument> ::= <Exp>;*)

(*<SingularObjectInvocation> ::= <ObjectDescriptor>;*)

<Property> ::= '%' <NameApl>;

<Slot> ::= '<<' <NameApl> '>>' ;
<Dots> ::= '...' ;

<Constant> ::| <IntegerConst> | <FloatConst> | <CharConst> | <StringLiteral>;
<NameDcl> ::= <NameDecl>;
<NameApl> ::= <NameAppl>;
<IntegerConst>  ::= <Const> ;
<FloatConst> ::= 'F';
<CharConst> ::=  <String> ;
<StringLiteral> ::= <String>
