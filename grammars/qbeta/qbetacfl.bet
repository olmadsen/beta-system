ORIGIN '~beta/newmps/astlevel'
--astInterfaceLib: attributes--

qbeta: TreeLevel
  (# <<SLOT qbetaAttributes:attributes>>;
     Module: cons
       (# getNameDcl: getson1(# #);
          putNameDcl: putson1(# #);
          getDataKind: getson2(# #);
          putDataKind: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Module)[] -> V.visit_Module #);
       exit 1
       #);
     ObjectDescriptor: ObjectSpecification
       (# getSuper: getson1(# #);
          putSuper: putson1(# #);
          getItems: getson2(# #);
