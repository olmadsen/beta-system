ORIGIN '~beta/basiclib/betaenv'
---program:descriptor---
(# Address:
      (# street: ^Text;
         print:<
            (#
            do inner;
               street[]->putline;
            #);
         init:<
            (# adr: ^Text enter adr[] do inner #)
      #);
   Person:
      (# name: ^Text;
         adr: @ Address
             (# print::
                  (# 
                  do name[] -> putline;
                  #);
                init:: (# do adr[] -> street[] #)
             #);
         init:
            (# N,S: ^Text
            enter(N[],S[])
            do N[] -> name[]; S[] -> adr.init
            #);
         print: (# do adr.print#)
      #);
   P: ^Person;
   A: ^Address
do &Person[] -> P[];
   ('Mary','CPH') -> P.init;
   P.print;
   P.adr[] -> A[];
   A.print;
   A.loc[] -> P[];
   P.print
#)