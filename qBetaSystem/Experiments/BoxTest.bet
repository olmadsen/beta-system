ORIGIN '~beta/basiclib/betaenv';
INCLUDE '~beta/containers/list';
---program:descriptor---
(# V: @ integer; (* Primitive integer *)
   B1: ^IntegerObject; (* Boxed integer *)
   B2: @IntegerObject;
   S: ^Object
do 111 -> V;
   &IntegerObject[] -> B1[];
   V -> B1;
   B1 -> B2;
   112 -> B2;  (* no effect on B1 *)
   V -> putint;
   ' ' -> put;
   B1 -> putint;
   ' ' -> put;
   B2 -> putint;
   newline;
   B2[] -> B1[];
   114 -> B2;
   B1 -> putint;
   ' ' -> put;
   B2 -> putint;
   newline;
#)