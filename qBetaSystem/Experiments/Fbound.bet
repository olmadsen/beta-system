ORIGIN '~beta/basiclib/betaenv'
---lib:attributes--- 
(* F-bound Example from the ECOOP'99 paper by Kresten Krab Thorup & Mads Torgersen
 * Unifying Genericity - Combining the Benefits of Virtual Types and Parameterized Classes
 *)
Ordered:
   (# S:< Object;
      leq:<
        (# o: ^S; b: @ Boolean;
        enter o[]
        do 'Ordered:leq:' -> puttext;
            inner leq
        exit b
        #)
   #);
Point: Ordered
   (# S:: Point;
      x,y: @ integer;
      leq::
         (# (* o: ^Point *)
         do 'Point:leq:\n' -> puttext;
            (x <= o.x) and (y <= o.y) -> b
         #);
      print: (#do x -> putint; ','->put; y -> putint; newline #);
   enter(x,y)
   #);
Cowboy: Ordered
    (# S:: Cowboy;
       name: ^Text;
       leq:: (#do 'Cowboy:leq:\n' -> puttext; name[] -> o.name.equal -> b #);
       print: (#do 'Cowboy: '->puttext; name[] -> puttext; newline #);
    enter name[]
    #);
Comparator:
    (# M:< Ordered; (* No Ordered(M) *)
       Compare:
          (# e,f: ^ M; b: @ Boolean;
          enter(e[],f[])
          do f[] -> e.leq -> b 
             (* we cannot ensure that e.leq.o[] has the same type as f[]
              * A qua-check will be generated  *)
          exit b
          #);
    #);
---program:descriptor---
(# cp: @ Comparator(# M:: Point #);
   cc: @ Comparator(# M:: Cowboy #);
   p1,p2: @ Point;
   c1,c2: @ Cowboy;
do (10,12) -> p1; (10,12) -> p2; 'Jesse James' -> C1; 'Jesse James' -> C2;
   '**** Fbound ****' -> putline;
   p1.print;
   p2.print;
   (if ((p1[],p2[])->cp.compare) then 'Point:equal\n' -> putline if);
   c1.print;
   c2.print;
   (if ((c1[],c2[]) -> cc.compare) then 'Cowboy:equal\n' -> putline if);
   (***** The following is not accepted by the compiler! *)
   (*(if ((p1[],c2[]) -> cp.compare) then 'Point=Cowboy:equal\n' -> putline if);*)
#)
