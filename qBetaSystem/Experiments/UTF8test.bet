INCLUDE '~beta/basiclib/file';
INCLUDE '~beta/basiclib/numberio'
---program:descriptor---
(# ch,prevCh: @char;
   F: @File
do (for i: 255 repeat
        i->putint; ':'->put; i->put; ' ' ->put; (2,i) -> putBased; ' ' -> put; (16,i) -> putbased; newline;
   for);
   (*
   'hello.bet'->F.name;
   F.openRead;
   L: (if not F.eos then
          F.get -> ch; ch-> put; ' ' -> put; (10,ch) -> putBased(#do 6 -> width #);
          ' ' -> put; (2,ch) -> putbased(#do 10 -> width #);
          ' ' -> put; (16,ch) -> putbased(#do 10 -> width #);  
          (if prevCH = 194 then '! '-> puttext;  ch -> putint; ' ' -> put; ch  -> put; 167 ->put if);
          newline;
          ch -> prevCh;
          restart l
    if)*)
#)