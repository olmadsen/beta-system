ORIGIN '~beta/basiclib/betaenv'
---program:descriptor---
(# foo:
      (# V: < A;
         F: ##A
       enter F##
       do V; ',' -> put; F
      #);
    bar: foo
      (# V:: A1 #);
    A:(# c1: @char do 'A:'->puttext; 'W' -> c1; inner A #);
    A1: A (# do 'A1:'-> puttext; ch -> put; c1 -> put; 'E'-> ch; #);
    A2: A(# do 'A2:'-> puttext; ch -> put #);
    ch: @char
do 'Q' -> ch;
   A2## -> bar
#)