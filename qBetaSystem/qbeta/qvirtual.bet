ORIGIN 'qabstractSyntaxTree';
INCLUDE 'assert'
---astlib:attributes---
(* The patterns here are called from semchecker via 
 * semchecker::ObjectInvocation::getVqual, which is called from
 * checker::ObjectInvocation:check to get the qualification of a given OI
 * or is it Pattern?
 *)
OGsequence: SuperOGsequence
  (* Represents a pattern sequence as described in the OOPSLA article:
   *    Semantic Analysis of Virtual Classes and Nested Classes
   * 
   * In the qBeta implementation, we use a sequence of ObjectDescriptors
   *    [OG1, OG2, ... OGn]
   * where in the simple form
   *    OG1.super = OG2, OG2.super = OG3, ..., OGn-1.super = OGn
   * OG1 is enclosing the application qualified by the virtual
   * where we want to find the most specific binding.
   * To handle remote access, an OGsequence may in general have nested OGs:
   *       [OG1, OG2, ..., OGn-1, nest(OGn)]
   * meaning that OGn is nested within OGn-1.
   * OGn within nest(OGn) may have super patterns:
   *       [OG1, OG2, ..., OGn-1, nest(OGn),OGn+1, ...,OGm]
   *)
  (# thisOGS:: OGsequence;
     (*DOG: ^ObjectSpecification;*)
     (*pred: ^OGsequence;*)
     isRemote: @boolean;
     (*isNest: @Boolean;*)
     innerDOG: ^ObjectDescriptor; (* what is this? Defined in ENC when pred=none *)
     pathToSuper:
       (# OGsuper: ^ObjectDescriptor; on,pn: @integer; E: ^Exp; 
          D: ^Decl; ptn: ^Pattern; i: @integer; isR: @boolean;
       do (if traceGetVqual then 
              '**** pathToSuper: '->puttext; 
              (if DOG.super.isImplSuper then 'implicitSuper: ' -> puttext if);
              '"'->put; DOG.super.dopt -> puthead; 
              '" of:DOG: ' -> puttext; DOG.doPT -> putheadN;
              (if innerDOG[] <> none then
                  '**   innerDOG: ' -> puttext; innerDOG.doPT -> putheadN
          if)if);
          (if not DOG.isChecked then
              (* this happens*) (*'!!! DOG is not checked' -> putline; DOG.dopt  -> putheadN;*)
              (none,DOG.origin[],DOG.origin[],true) -> DOG.check;
          if);
          L:
            DOG.super.scanExps
            (# emitDump: 
                  (# isArg: @Boolean enter isArg
                  do '**** innerDOG:'->dumpT; isArg->dumpB;
                      innerDOG.dopt->putHeadN; 
                      ('DOG.super.scan',0,0) -> print
                  #)
            do (if traceGetVqual then '**   exp:'->dumpT; current.dopt -> dumpTN if);
               (i + 1 -> i) > 1 -> isR;
               current[] -> E[];
               (if (current[] = innerDOG[]) then emitDump;
                   leave L
               if);
               (if (innerDOG[] <> none) and (E.args[] <> none) then
                   E.args.scanSons
                   (#
                   do (if (current[] = innerDOG[]) then true -> emitDump;
                          leave L
            if)#)if)#);
          (if DOG.super.isImplSuper then
              DOG.super.ATd[] -> D[];
              0 -> on;
              DOG.super.pn -> pn; 
              (if D.OG.IS.isEmpty then
                  (if traceGetVqual then
                      '**** implicitSuper:'->dumpT; pn -> dumpI; D.OG.IS.isEmpty->dumpB; 
                      D.OG.super.on -> dumpI; D.OG.super.pn->dumpI; D.dopt->dumpTN;
                  if);
                  D.OG.super.on -> on; (D.OG.super.last).pn + pn -> pn
              if); 
           else
              (if traceGetVqual then
                 (* if E.isEmpty, we have DOG = (OG(Invocation('???') ...)*)
                 '**   pathToSuper:E:"' -> puttext; E.dopt -> puthead; 
                 '" E.on=' -> puttext; E.on -> putint;
                 ' E.pn=' -> puttext; E.pn -> putint;
                 ' DOG.super.pn='->puttext; DOG.super.pn -> putint;
                 ' isR=' -> puttext; isR -> putboolean; newline;
              if);
              E.ATd[] -> D[];
              E.on -> on; 
              E.pn -> pn; 
          if);
          L:
          (if true
           // D[] = none then 
              (*'!!!! pathToSuper:super.ATd is none' -> putline;*)
              ObjectDecl[] -> D[] -> ptn[]
           // D.isPattern then D[] -> ptn[]
           // D.isNameDecl then 
              (# ND: ^NameDecl
              do (*'****nameDecl:'->puttext; D.dopt -> putline;*)
                 (* only if nameListInDcl *)
                 D[] -> ND[];
                 ND.ATd[] -> D[]; 
                 restart L
              #)
           else 
              '!!!! pathToSuper:super.ATd is not Pattern or is empty: ' 
                -> putline;
              DOG.doPT -> puthead;
              leave pathToSuper
          if);
          ptn.OG[] -> OGsuper[];
          (if traceGetVqual then
              '**   pathToSuper:end:super.last: "'->puttext; 
              (if DOG.super.isImplSuper then 'implicitSuper'->puttext else E.dopt -> puthead if);
              '" :on='->puttext; on ->putint;
              ':pn='->puttext; pn -> putint;
              ':isR='->puttext; isR->putboolean;
              ':ptn.isVirt=' -> puttext; ptn.isVirtual -> putBoolean; 
              ' ptn:' -> puttext; ptn.doPT -> putheadN;
              (* print*)
          if);
       exit(OGsuper[],on,pn,isR)
       #);
     encLevel: @integer;
     inINV: BooleanValue
        (# N: ^Node
        enter N[]
        do L: (if true
               // N.isInvocation and (N.noOfSons > 1) then
                  '**** inINV:'->dumpT; N.doPP->dumpTN; true->value
               // N.isItems then
               else 
                  N.father[] -> N[];
                  restart L
              if)
        #);
     ENC:
       (* ENC[D] = [D.origin]
        * ENC[D1,D2,...,Dn] = PRE(j) o ENC(i) 0 ENC[D1,D2,...,Dn-1]
        *    where Path(Dn) = (i,j)
        *)
       (# encOGS: ^OGsequence; OGsuper,superDOG: ^ObjectDescriptor; 
          level,onx,pnx: @integer; isR: @boolean; id: ^Text; org: ^Scope;
          getEncOG: 
             (* chek for DOG = OD(Invocation(BracketedExp(Invocation *)
             (# inv: ^Invocation;  OI: ^ObjectInvocation; BE: ^BracketedExp; prev: ^Exp; N: ^Node;
                encOG: ^ObjectDescriptor;
                setEncOG:
                   (# superInv: ^Invocation; prev: ^Exp
                   enter superInv[] 
                   do superInv.scanSons (#do (if not isLast then current[] -> prev[] if)#);
                      (if traceGetVqualShort then
                          '**** ENC:head:remoteOD:'->dumpT; DOG.dopt->putheadN;
                          prev.ATD.dopt->putheadN;
                      if);
                      prev.ATd.OG[] -> encOG[]
                   #)
             do (if (DOG.super.noOfSons > 1)  then 
                    DOG.super -> setEncOG
                 else
                    org.encOG[] -> encOG[]; (* simple case without remoteOD *)
                    (if (DOG.super.noOfSons = 1) and not DOG.super.isEmpty then
                        DOG.super.last -> N[];
                        (if N.isBracketedExp then
                            N[] -> BE[];
                            (if (BE.NoOfSons = 1) and (BE.son[]->N[]).isInvocation then
                                (if N.noOfSons > 1 then
                                    N[] -> setEncOG
                                if)
                            if)
                        if)
                 if)if)
             exit encOG[]
             #)
       enter(id[],level)
       do (if traceGetVqual then ('**** ENC:'->(id.copy).prepend,0,level) -> print if);
          (if true 
           // pred[] = none then (* head *)
              (* ENC([D]) = [D.origin] *)
              (DOG.origin[] <> none,'ENC: DOG.origin is none!')
                 -> assertFail(#do DOG.doPT -> dumpTN; print#);
              ((DOG.origin[]->org[]).encOG[] <> none,'ENC: DOG.origin.encOG is none!')-> assert;
              (if traceGetVqualShort then
                  '**** ENC:head:'->dumpT; DOG.super.noOfSons-> dumpI; DOG.dopt->putheadN
              if);
              (if false and (DOG.super.noOfSons > 1) then 
                 (# remoteD: ^Decl; prev: ^Exp
                  do DOG.super.scanSons (#do (if not isLast then current[] -> prev[] if)#);
                     (if prev.ATd.isDecl then
                         (prev.ATd.OG[],false,none) -> OGsequence -> encOGS[];
                         (if traceGetVqualShort then
                            '**** ENC:head:remoteOD:'->dumpT; DOG.dopt->putheadN;
                             prev.ATD.dopt->putheadN;
                  if)if)#)
              else
                 (if false then
                    (getEncOG,false,none) -> OGsequence -> encOGS[];
                 else
                    (org.encOG[],false,none) -> OGsequence -> encOGS[];
              if)if);
              DOG[] -> encOGS.innerDOG[] (* head.DOG? *)
           // isNest then
              (* ENC([D1,D2,...,Dn-1,nest(Dn)]) = [D1,D2,...,Dn-1] *)
              pred[] -> encOGS[];
           // isRemote then (* ENC([D1,D2,...,Dn-1,R1.R2.R3.Q]) *)
              pred.DOG[] -> superDog[]; (* superDOG = Dn-1, DOG = Q *)
              (DOG[],superDog[],pred[],level) -> Remote -> encOGS[]
           else
              (* ENC([D1,D2,...,Dn-1,Dn]) = PRE[pn] o ENC[on] o ENC([D1,D2,...,Dn-1])
               * where path(Dn-1.super) = (on,pn)
               *)
              pred.pathToSuper -> (OGsuper[],onx,pnx,isR);
              (* thisOGS = [D1,D2,...,Dn-1,Dn], Dn = DOG *)
              (if traceGetVqual then
                  '**   ENC:pred: '-> puttext; 
                  ' pred.DOG: ' -> puttext; pred.DOG.doPT -> putheadN;
                  '**   OGsuper: ' -> puttext; OGsuper.dopt -> PutheadN
              if);
              (id[],level + 1) -> pred.ENC -> encOGS[];
              (if traceGetVqual then 
                  '**   ENC:[pnx=' -> puttext;  pnx -> putint;
                  ']oENC[onx=' -> puttext; onx -> putint; 
                  ']' -> put;newline 
              if);
              (if isR then '!!!! ComputeOGs:isR:Check it!'->putline if);
              (for i: onx repeat (id[],level + i) -> encOGS.ENC -> encOGS[] for);
              (for i: pnx repeat level -> encOGS.PRE -> encOGS[] for);
          if);
          (if traceGetVqual then ('**   ENC:result:',0,level) -> encOGS.print if)
       exit encOGS[]
       #);

     Remote:
       (* this(OGs) = [D1,D2,...,Dn,R1.R2.R3.Q]
        * superDOG = Dn, predOGS = [D1,D2,...,Dn], thisDOG = Q
        * superDOG = predOGS.DOG, thisDOG = this(OGsequence).DOG; they need not be parameters
        * remote([D1,D2,...,Dn],R) = nest(app(super[j] o enc[i]([D1,D2,...,Dn]),Sa),Rd)
        *    where path(Ra) = (Rd,0,j), Rd: ref Sa
        *  remote([D1,D2,...,Dn],R.Q) = nest(app(super[j] o remote([D1,D2,...,Dn,R),Ta,Td)))
        *    where path(Qa) = (Qd,0,j), Qd: ref Ta
        *)
       (# superDOG,thisDOG,OGx: ^ObjectDescriptor; predOGS,Sx: ^OGsequence; level: @integer
       enter(thisDOG[],superDOG[],predOGS[],level)
       do (if traceGetVqualShort then 
              ('**** Remote:predOGS',0,level) -> predOGS.print;
              ('**   superOGS',0,level) -> print;
          if);
          ('remote:A',level) -> predOGS.ENC -> predOGS[];
          L: superDOG.super.scanExps
            (# E: ^Exp; D: ^SuperDataItem
            do current[] -> E[]; 
               (if (E.ATd.asDecl).OG[] = thisDOG[] then 
                   (* move to below, if not isLast - but what is this? *)
                   (if traceGetVqualShort then
                       '**** remote:got:thisDOG:' -> puttext;
                       thisDOG.dopt -> putheadN;
                       ('remote:',0,level) -> predOGS.print;
                   if);
                   leave L;
               if);
               (if traceGetVqualShort then
                   '**   remote:scanSons:E:"' -> puttext; 
                   E.dopt -> puttext; '" E.ATd.label:' -> puttext; E.ATd.label -> puttext;
                   ' E.on: '->puttext; E.on ->putint;
                   ' E.pn: ' -> puttext; E.pn -> putint;
                   ' E.ATd:' -> putline; E.ATd.dopt -> putline;
               if);
               (if not isLast then
                   (* remote([D1,D2,...,Dn],R) = nest(app(super[j] o enc[i]([D1,D2,...,Dn]),Sa),Sd)
                    *    where path(Ra) = (Rd,i,j), Rd: ref Sa; Sd: ...
                    *)
                   (* DOG = R.Q where Q is not remote and R = R1.R2.Rn, n >=1 *)
                   (if traceGetVqual then
                       '**   remote:first:'-> dumpT; E.on->dumpI; E.pn->dumpI; E.doPT->dumpTN
                    if);
                   (for i: E.on repeat ('remote:B',level + i) -> predOGS.ENC -> predOGS[] for);
                   (for i: E.pn repeat level -> predOGS.PRE -> predOGS[] for);
                   (* Is E.ATd ok? We have Ra => Rd: ref Sa; ... Sa => Sd: ...
                    * E.ATd = Rd: ref Sa - should perhaps be?
                    * But append seems ok!? Is OGx below ok?
                    *);
                   (E.ATd.asDecl,level) -> predOGS.append -> (predOGS[],OGx[]);
                   predOGS[] -> Sx[];                 
                   (OGx[],true,Sx[]) -> OGsequence -> predOGS[];
           if)#);
          (if traceGetVqual then ('**** remote:END',0,level) -> predOGS.print if)
       exit predOGS[]
       #);  
     append:
       (# D: ^Decl(*SuperDataItem*); S,Sx: ^OGsequence; OGx: ^ObjectDescriptor; 
          MI: ^ModuleItem; ATd: ^decl; level: @integer; DI: ^DataItem
       enter(D[],level)
       do  (if traceGetVqual then
              '**** append:label: '->puttext; D.label -> puttext; 
               ' dcl: ' -> puttext; D.dopt -> putheadN;
               '**   isEmpty: '  -> puttext; D.OG.IS.isEmpty -> putboolean;
               '\n**   hasVargs: ' -> puttext; D.OG.hasVirtualArgs ->putboolean;
               newline
          if);
          (if D.isModuleItem then (D[]->MI[]).MD[] -> D[] if); 
          this(OGsequence)[] -> S[];
          (if D.OG.IS.isEmpty
              and
              (not D.OG.hasVirtualArgs
              or D.isDataItem and not (D[]->Di[]).isConst)
              (* We need to understand this! 
               * For ChemicalPlantSystem, not isConst is needed
               * For CityLink, we dont need it!?
               *)
              then
              D.OG.super.scanExps(*ons*)
              (# i: @integer; E: ^Exp
              do (if (i + 1 -> i) > 1 then
                     (if toFix then
                         '!!!!  append:dataItem:remote not implemented:'
                           ->putline;
                         D.dopt -> putline;
                     if);
                     S[] -> Sx[];
                     (OGx[],true,Sx[]) -> OGsequence -> S[];
                 if);
                 current -> E[];
                 (if (E.ATd.asDecl).isModuleItem then
                     (E.ATd.asDecl->MI[]).MD[] -> ATd[]
                  else
                     E.ATd.asDecl -> ATd[];
                 if);
                 (if traceGetVqual then
                     '**   append:scan:E: "'->puttext; E.doPT -> puttext;
                     '" on=' -> puttext; E.on -> putint;
                     ' E.pn='->puttext; E.pn -> putint; ' E.ATd.OG: "'->puttext;
                     (if E.ATd[] <> none then                         
                         ATd.OG.dopt -> puthead
                      else
                         'none:'->putline
                     if)
                 if);
                 (for i: E.on repeat ('append:',level + i) -> S.ENC -> S[] for);
                 (for i: E.pn repeat level -> S.PRE -> S[] for);
                 (ATd.asDecl).OG[] -> OGx[]
              #)
           else
              D.OG[] -> OGx[]
          if);          
          (if traceGetVqual then '**   append:END:\n' -> puttext if);
       exit(S[],OGx[])
       #);
     PRE:
       (# S: ^OGsequence; 
          OGx,qual: ^ObjectDescriptor; onx,pnx: @integer; isR: @boolean;
          level: @integer
       enter level
       do (if traceGetVqual then ('**** PRE: ',0,level) -> print if);
          pathToSuper -> (OGx[],onx,pnx,isR);
          (OGx[],false, this(OGsequence)[]) -> OGsequence -> S[]; 
          isR -> S.isRemote;
          (if traceGetVqual then 
              '**   PRE:onx,pnx,isR:'->puttext; onx->putint; ','->put; 
              pnx->putint;','->put; isR->putBoolean; 
              ' OGx:'->putline; OGx.dopt -> putheadN;
              ('**   PRE:result:',0,level) -> S.print
          if)
       exit S[]
       #);
     newFindBinding::
       (# OGx: ^ObjectDescriptor
       do (if traceGetVqual then
              '**** newFindBinding: ' -> puttext;
              vDcl.dopt -> putheadN;
          if);
          vDcl[] -> searchBinding -> qual[];
          (if false then
              '**** newFindBinding:end: ' -> puttext;
              vDcl.dopt -> putheadN;
          if);
          (if qual[] = none then
              (if traceGetVqual then
                  '!!!! No binding found in OGsequence! Use: '->puttext;
                  vDcl.doPT -> putheadN
              if);
              vDcl.OG[] -> qual[];
           else
              (if traceGetVqual then
                  '**** newFindBinding:found: ' -> puttext; qual.dopt ->putheadN
              if)
          if)
       #);
     searchBinding:
       (# vDcl: ^Pattern; qual: ^ObjectDescriptor
       enter vDcl[] 
       do (if traceGetVqual then
              '**** searchBinding: ' -> puttext; vDcl.dopt -> putheadn; print;
          if);
          (if isNest or (pred[] = none) then
           else
              vDcl[] -> pred.searchBinding -> qual[]
          if);
          (if qual[] = none then
              (vDcl[],DOG[]) -> checkDOG -> qual[]
          if)
       exit qual[]
       #);
     checkDOG:
       (* check for binding of vDcl in DOG *)
       (# vDcl: ^Pattern; DOG,qual: ^ObjectDescriptor;
       enter(vDcl[],DOG[])
       do (if traceGetVqual then
              '**   checkDOG: ' -> puttext; DOG.OGid-> puttext; ' ' -> put;
              dog.doPT -> putheadN;
              '**   father:'->puttext;
              DOG.father.dopt -> puthead
          if);
          (if false then
              '**** beingChecked:'->dumpt; dog.beingchecked->putboolean;
              ' isChecked:'->dumpt; dog.isChecked -> putboolean; newline;
              (none,DOG.origin[],DOG.origin[],true) -> DOG.check;
          if);
          checkForBinding:
            (# Ex:^Exp; OGs: ^ObjectDescriptor; argNo: @integer; ND: ^NameDecl
            do DOG.IS.scanDecls
               (# ptn,P: ^Pattern
               do (if currentDcl.isPatternDecl then
                      currentDcl[] -> ptn[];
                      (if false and not ptn.isChecked and not ptn.beingChecked then
                          '**** qvirtual:doCheck: ' -> dumpT; 
                          ptn.dopt -> putheadN;
                          (none,ptn.origin[],ptn.origin[],true) -> ptn.check;
                      if);
                      (if ptn.isVirtual then
                          (if false and traceGetVqual then
                              '**   try: ' -> puttext; ptn.dopt -> puthead
                          if);
                          ptn[] -> P[];
                          loop: 
                            (if vDcl[] = P[] then
                                (if traceGetVqual then
                                    '\n ==== FOUND BINDING: =====' -> putline;
                                    ptn.dopt -> putheadn;
                                if);
                                (if ptn.OG.IS.isEmpty then
                                    (* Should we include 
                                     * not ptn.OG.hasVirtualArgs?
                                     *)
                                    (if ptn.beingChecked then
                                        ptn.OG.super.scanExps(*Sons*)
                                        (# OI: ^ObjectInvocation; D: ^Decl
                                        do (current[]->OI[]).ptnID[]
                                             -> DOG.IS.doSearch -> D[];
                                           D.asDecl -> ptn[];
                                        #)
                                     else
                                        (if nameListInDcl then
                                            (ptn.OG.super.ATd[]-> ND[]).ATd[]
                                              -> ptn[];
                                         else
                                            ptn.OG.super.ATd[] -> ptn[];
                                        if);
                                if)if);
                                ptn.OG[] -> qual[];
                                true -> hasBinding;
                                (*print; qual.dopt -> puthead;*)
                                leave checkForBinding
                             else
                                (* probably check ptn.vDcl recursively *)
                                (if P.vDcl[] = none then
                                    (if P.ptnKind // FinalPtn // FurtherPtn then
                                        (if false then
                                            '**** virtual:Binding:P.vDcl:none:'
                                              ->dumpTN;
                                            P.dopt -> putheadN;
                                            '**** beingChecked:'->dumpt; 
                                            ptn.beingchecked->putboolean;
                                            ' isChecked:'->dumpt; 
                                            ptn.isChecked -> putboolean;
                                            newline;
                                        if);
                                        (none,ptn.origin[],ptn.origin[],true) 
                                          -> P.check;
                                if)if);
                                (if (P.vDcl[] -> P[]) <> none then
                                    restart loop
               if)if)if)if)#);
               (* check possible binding in arguments of DOG.super.last *)
               LLL:
                 (if DOG.IS.superDesc[] <> none then
                     DOG.super.last -> Ex[];
                     DOG.IS.superDesc.father[] -> OGs[];
                     (if traceGetVqual then
                         '**   Ex: ' -> puttext; Ex.dopt -> putheadN;;
                         '**   Ex.OGs.super:'->putline;
                         OGs.dopt -> putheadN;
                     if);
                     (if (Ex.args[] <> none) and (Ex.args.noOfSons > 0) then
                         OGs.IS.scanNonBoundItemArgs
                         (# 
                         do argNo + 1 -> argNo;
                            (if traceGetVqual then
                                '**   currentArg: ' -> puttext;
                                currentArg.dopt->putheadN;
                            if);
                            (if currentArg[] = vDcl[] then
                                Ex.args.scanArgs
                                (# i: @integer
                                do i + 1 -> i;
                                   (if i = argNo then
                                       (if traceGetVqual then
                                           '**   superArg: ' -> puttext; 
                                           current.label -> puttext;
                                           ' '->put; current.dopt-> putline;
                                       if);
                                       (if traceGetVqual then
                                           '\n==== FOUND BINDING IN ARG: ' 
                                             -> putline;
                                           current.dopt -> putheadn;
                                       if);
                                       current.getQual -> qual[];
                                       true -> hasBinding;
                                       (*print; qual.dopt -> putline;*)
                                       leave LLL
            if)#)if)#)if)if)#)
       exit qual[]
       #);
     getOGstart:: 
       (* Return the start OG of this OGsequence from where a virtual binding
        * has to be searched. For a simple OGs with no nesting:
        *    [OG1, OG2, ... OGn]
        * the start is OG1.
        * If nesting appers:
        *    [OG1, OG2, ..., OGn-1, nest(OGn),OGn+1, ...,OGm]
        * the start is OGn asssuming no isNest(OGk), n < k and k <= m
        *)
       (#
       do (if traceGetVqual then
              '**** getOGstart: ' -> putline; print
          if);
          (if isNest then
              DOG[] -> qual[]
           else
              (if pred[] <> none then
                  pred.getOGstart -> qual[]
               else
                  DOG[] -> qual[]
          if)if);
          (if traceGetVqual then
              '**** getOGstart:isNest: ' -> puttext; isNest -> putboolean;
              ' qual: ' -> puttext; qual.doPT -> puthead;
          if)
       #);     
     print::
       (# (*msg: ^text; L,level: @integer *)
       do (if msg[] <> none  then msg[] -> puttext if);
          (if L = 0 then '[' -> put; level -> putint; ':'->put if);
          (if pred[] <> none then (none, L + 1,level) -> pred.print if);
          (if isRemote then 'r:' -> puttext if);
          (if isNest then 'nest(' -> puttext if);
          DOG.OGid -> puttext;
          (if hasBinding then '&' -> put if);
          (if isNest then ')' -> put if);
          (if L = 0 then ']' -> put; newline else ',' -> put if)
       #);
  exit this(OGsequence)[]
  #);

