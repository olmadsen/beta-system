ORIGIN 'qabstractSyntaxTree';
INCLUDE 'assert'
---astlib:attributes---
(* The patterns here are called from semchecker via 
 * semchecker::ObjectInvocation::getVqual, which is called from
 * checker::ObjectInvocation:check to get the qualification of a given OI or is it Pattern?
 *)
OGsequence: SuperOGsequence
  (* Represents a pattern sequence as described in the OOPSLA article:
   *    Semantic Analysis of Virtual Classes and Nested Classes
   * 
   * In the qBeta implementation, we use a sequence of ObjectDescriptors
   *    [OD1, OD2, ..., ODn]
   * where in the simple form
   *    OD1.super = OD2, OD2.super = OG3, ..., ODn-1.super = ODn
   * OD1 is enclosing the application qualified by the virtual
   * where we want to find the most specific binding.
   * To handle remote access, an OGsequence may in general have nested OGs:
   *       [OD1, OD2, ..., ODn-1, nest(ODn)]
   * meaning that ODn is nested within ODn-1.
   * ODn within nest(ODn) may have super patterns:
   *       [OD1, OD2, ..., ODn-1, nest(ODn),ODn+1, ...,ODm]
   * Parameters, where this(OGsequence) = [OD1, OD2, ..., ODn]
   *    DOG = ODn, 
   *    isNest: if true then ODn is nested in ODn-1,
   *    pred = [OD1, OD2, ..., ODn-1], possibly none
   *)
  (# thisOGS:: OGsequence;
     isRemote: @boolean; (* DOG is a remote super of pred.DOG *)
     enclosingOG: ^ObjectDescriptor; (* enclosingOG.origin.encOG* = OD1, i.e. the immediate 
                                   * encloser of the application qualified by the virtual
                                   * none for ODi, i > 1 and sometimes also for i = 1 ???
                                   *)
     pathToSuper:
       (# superOD: ^ObjectDescriptor; on,pn,implSuperON,implSuperPN: @integer; E: ^Exp; 
          D: ^Decl; ptn: ^Pattern; i: @integer; isR: @boolean;
       do (*'\n!!!! OBSOLETE: pathToSUper:'->putline;  DOG.doPT -> putheadN;*)
          (if tracegetvqualShort then 
              '**** pathToSuper: '->puttext; 
              (if DOG.super.isImplSuper then 'implicitSuper: ' -> puttext if);
              '"'->put; DOG.super.dopt -> puthead; '" of:DOG: ' -> puttext; DOG.doPT -> putheadN;
              (if enclosingOG[] <> none then
                  '**   enclosingOG: ' -> puttext; enclosingOG.doPT -> putheadN
          if)if);
          (if not DOG.isChecked then
              (* this happens*) (none,DOG.origin[],DOG.origin[],true) -> DOG.check;
          if);
          L:
            DOG.super.scanExps
            (# emitDump: 
                  (# isArg: @Boolean enter isArg
                  do (if true then 
                         ('**** enclosingOG:',isArg)->dumpTB; enclosingOG.dopt->putHeadN; 
                         ('pathToSuper:got:enclosingOG:',0,0) -> print
                  if)#);
                enclosingOGinArgs: BooleanValue
                   (* check if enclosingOG is an argument of E - but why ? *)
                   (# E: ^Exp; 
                   enter E[]
                   do L: (if (E[] = enclosingOG[])->value then (* do we ever come here? *)
                             emitDump; 
                             leave L
                          else
                            (if (enclosingOG[] <> none) and (E.args[] <> none) then
                                E.args.scanSons
                                (#
                                do (if (E[] = enclosingOG[])-> value then 
                                       true -> emitDump; 
                                       leave L; 
                   if)#)if)if)#)
            do (if tracegetvqualShort then '**   pathToSuper:exp:'->dumpT; current.dopt -> dumpTN if);
               (i + 1 -> i) > 1 -> isR;
               current[] -> E[];
               (if E[] -> enclosingOGinArgs then leave L if);
            #);
          (if DOG.super.isImplSuper then
              DOG.super.ATd[] -> D[]; (* D is a virtaul pattern/binding *)
              0 -> on;
              DOG.super.pn -> pn; 
              (if newVbinding and D.OG.IS.isEmpty then (* D has the form V:< A, no mainpart *)
                  D.OG.super.on -> implSuperON; (D.OG.super.last).pn -> implSuperPN;
              if); 
           else
              E.ATd[] -> D[];
              E.on -> on; 
              E.pn -> pn; 
          if);
          (if tracegetvqualShort then
              '**   pathToSuper:E:' -> dumpT; 
              (if DOG.super.isImplSuper then '#'->dumpT else  E.dopt -> puthead if);
              (' isR',isR) -> dumpTB;
              ('on',on) -> dumpTI; ('pn',pn) -> dumpTI;
              ('implSuperON',implSuperON)->dumpTI; ('implSuperPN',implSuperPN)->dumpTI; 
              '\n**   D = DOG.super.ATd:'->dumpT; 
              (if D[] = none then 'none'->dumpTN else D.dopt->putHeadN if);
          if);
          L:
          (if true
           // D[] = none then 
              (*'!!!! pathToSuper:super.ATd is none' -> putline;*)
              ObjectDecl[] -> D[] -> ptn[]
           // D.isPattern then D[] -> ptn[]
           // D.isNameDecl then 
              (# ND: ^NameDecl
              do (*'****nameDecl:'->puttext; D.dopt -> putline;*)
                 (* only if nameListInDcl *)
                 D[] -> ND[];
                 ND.ATd[] -> D[]; 
                 restart L
              #)
           else 
              '!!!! pathToSuper:super.ATd is not Pattern or is empty: '  -> putline;
              DOG.doPT -> puthead;
              leave pathToSuper
          if);
          ptn.OG[] -> superOD[];
          (if tracegetvqualShort then
              '**   pathToSuper:end:super:'->dumpT; 
              (if DOG.super.isImplSuper then '#'->dumpT else E.dopt -> puthead if);
              ('super.on',on)->dumpTI; ('super.pn',pn)->dumpTI; ('isR',isR)->dumpTB;
              ('super.ATd.isVirt',ptn.isVirtual)->dumpTB; 'super.ATd:'->dumpT; ptn.doPT->putheadN;
          if);
       exit(superOD[],on,pn,isR,implSuperON,implSuperPN)
       #);
     encLevel: @integer;
     ENC:
       (* ENC[D] = [D.origin]
        * ENC[D1,D2,...,Dn] = PRE(j) o ENC(i) 0 ENC[D1,D2,...,Dn-1], Path(Dn) = (i,j)
        *)
       (# encOGS,OGSx: ^OGsequence; superOD,predDOG: ^ObjectDescriptor; 
          level,superON,superPN,implSuperON,implSuperPN: @integer; 
          isR: @boolean; id: ^Text; org: ^Scope;
          getEncOGX: 
             (# inv: ^Invocation;  OI: ^ObjectInvocation; BE: ^BracketedExp; prev: ^Exp; N: ^Node;
                encOG: ^ObjectDescriptor; OSx: ^OGsequence;
                setEncOG:
                   (* superInv = R1.R2.R3.P; assigns a reference to encOG *)
                   (# superInv: ^Invocation; prev: ^Exp; theATd: ^Decl
                   enter superInv[] 
                   do superInv.scanSons (#do (if not isLast then current[] -> prev[] if)#);
                      prev.getATd -> theATd[];
                      (if traceGetVqualShort then
                          '**** ENC:head:remoteOD:prev:'->dumpT; prev.doPT->dumpTN; 
                          '**   DOG:'->dumpT; DOG.dopt->putheadN;
                          '**   prev.ATd:'->dumpT; theATd.dopt->putheadN;
                          '**   theATd.OG.hasVirtualArgs:'->dumpT;theATd.OG.hasVirtualArgs->dumpB; newline;
                          '**   prev.ATd.OG.isEmpty:'->dumpT;  theATd.OG.IS.isEmpty->dumpB;
                          ' not (theATd.OG.super.getATd).OG.hasVirtualArgs:'->dumpT; 
                          (if not theATd.OG.super.isEmpty then
                              not (theATd.OG.super.getATd).OG.hasVirtualArgs->dumpB 
                           else 'false'->dumpT if); newline;
                      if);
                      theATd.OG[] -> encOG[];
                      (* prev.ATd = ref/obj ObjSpec where ObjSpec = Foo{...}, Foo(#Bar),
                       * Go to ObjSpec.decl if no items and no virtuals args; also for R: ref Foo(#bar)
                       *)
                      (if theATd.OG.IS.isEmpty and not theATd.OG.hasVirtualArgs
                                 (*not (theATd.OG.super.getATd).OG.hasVirtualArgs*) then 
                          '**   getEncOG:call:getVqual:'->dumpT; theATd.OG.super.doPT -> dumpTN;
                          (if true then 
                              (DOG[],false,(enclosingOG[],false,none)->OGsequence) -> theATd.OG.super.getVqual -> (OSx[],encOG[])
                           else
                              (theATd.OG.super.getATd).OG[] -> encOG[];
                          if);
                          (if traceGetVqualShort then '**   superDecl:'->dumpT; encOG.doPT -> putHeadN
                      if)if);
                      (if traceGetVqualShort then 
                          '**   encOG:'->dumpT; encOG.doPT -> putHeadN ;
                          '**   org.encOG:'->dumpT; org.encOG.dopt->putHeadN;
                   if)#)
             do (if traceGetVqualShort then 
                    '**** ENC:getEncOG:'->dumpT; ('super.isRemote',DOG.super.noOfSons > 1)->dumpTB; 
                    'id:'->dumpT; id[]->dumpTN; '**   DOG:'->dumpT; DOG.dopt->putHeadN;
                if);
                (if (DOG.super.noOfSons > 1)  then (* remote super *)
                    DOG.super -> setEncOG
                else (* no super or simple super: T{...} *)
                    org.encOG[] -> encOG[]; 
                if)
             exit encOG[]
                #); 
          handleHeadX: (* DOG = R.P{...}; R: ref S; S: S0{ ... }*)
             (# trace: (#exit true #); Ra,Sa: ^Exp; Rd,Sd: ^Decl; n: @integer; OGx: ^ObjectDescriptor;
             do (if (DOG.super.noOfSons > 1)  then (* remote super *)
                    (if trace then '**   ENC:handleHead:DOG:'->dumpT; DOG.dopt ->putHeadN; if);
                    DOG.super.scanSons
                    (#
                    do n + 1 -> n;
                       (if not isLast then 
                           current[] -> Ra[];
                           Ra.getATd -> Rd[]; (* Ra = R, Rd = R: ref S, Rd.OG.super = S *)
                           Rd.OG.super.last -> Sa[];
                           Sa.ATd[] -> Sd[];
                           (if trace then
                                '**  handleHead:n:'->dumpT; n->dumpI; 
                                Ra.on -> dumpI; Ra.pn -> dumpI;
                                '\n**   enclosingOG:'->dumpT; enclosingOG.dopt ->putHeadN; 
                                '\n**   Ra:'->dumpT; Ra.doPT -> dumpTN;
                                '**   Ra.ATd:'->dumpT; Ra.ATd.dopt->putHeadN;
                                '**   Ra.ATd.OG.super:'->dumpT; Rd.OG.super.dopt->dumpTN;
                                '**   Rd.OG.super.pn:'->dumpT; (Rd.OG.super.last).pn -> dumpI; 
                                (if Sd[] <> none then '\n**   Sd:'->dumpT; Sd.dopt->putHeadN if);
                                '**   DOG.super.last.pn:'->dumpT; (DOG.super.last).pn->dumpI; 
                           if);
                           (if n = 1 then
                               DOG[] -> OGx[];
                               (for Ra.on + 1 repeat OGx.origin.encOG[] -> OGx[] for);
                               (OGx,false,none) -> OGSequence -> encOGS[];
                           else (* Ra.on = 0 *)
                               (if trace then
                                   '\n**   R1.R2.R3:Ra.on:'->dumpT; Ra.on -> dumpI; Ra.dopt->dumpTN;
                               if);
                               (for Ra.on repeat encOGS.ENC -> encOGS[] for);
                           if);
                           (for Ra.pn repeat encOGS.PRE -> encOGS[] for); 
                           (* we need the qualification of Rd;  Perhaps just call Rd.getVqual 
                            * must handle setting of nest in last if-imp *)
                           (if Rd.OG.IS.isEmpty then (* missing Rd.OG.super if remote *)
                               (for Rd.OG.super.on repeat 
                                     ('handleHead:virtual',level) -> encOGS.ENC -> encOGS[] 
                               for);
                               (for (Rd.OG.super.last).pn repeat encOGS.PRE -> encOGS[] for);
                               (Rd.OG.super.last).ATd[] -> Sd[];
                           else
                               Rd[] -> Sd[]
                           if);
                           (if trace then '\n**   Sd:'->dumpT; Sd.dopt->putheadN if);
                           (if Sd.isVirtual then
                               '**   Sd:isVirtual:'->dumpTN;
                               (Sd.OG[],true,encOGS[])->OGsequence -> encOGS[];
                               encOGS.print;
                               (enclosingOG[],false,encOGS[]) -> (Rd.OG.super.last).getVqual -> (encOGS[],OGx[]);
                               '**   OGx:'->dumpT; OGx.dopt->putHeadN; encOGS.print;
                           else
                              (Sd.OG[],true,encOGS[]) -> OGsequence -> encOGS[];
                          if);
                          (if trace then '**   handleHead:Sd:'->dumpTN; Sd.dopt -> dumpTN; (Sd.OG.super.last).pn -> dumpI; encOGS.print if)
                     else
                        (if trace then '**   handleHead:remote:last:'->dumpT; current.dopt->dumpTN if);
                    if)#); (* current = DOG.super.last *)
                    (if trace then 
                        '**   before:last:'->dumpT;(DOG.super.last).dopt->dumpT; (DOG.super.last).pn->dumpI; encOGS.print
                    if);
                    (for (DOG.super.last).pn repeat encOGS.PRE -> encOGS[] for);
                    (* do we need and extra ENC here? No: org.encOG below is NOt ENC *)
                    (if trace then '**   handleHead:END' -> dumpT; encOGS.print if)
                else (* no super or simple super: T{...} *)
                   (org.encOG[],false,none) -> OGsequence -> encOGS[];
                if);
             #);
          handleHead: (* DOG = R.P{...}; R: ref S; S: S0{ ... }*)
             (# trace: (#exit traceGetVqualShort #); Ra,Sa: ^Exp; Rd,Sd: ^Decl; n: @integer; OGx: ^ObjectDescriptor;
             do (if (DOG.super.noOfSons > 1)  then (* remote super *)
                    (if trace then '**   ENC:handleHead:DOG:'->dumpT; DOG.dopt ->putHeadN; if);
                    DOG.super.scanSons
                    (#
                    do n + 1 -> n;
                       (if not isLast then 
                           current[] -> Ra[];
                           Ra.getATd -> Rd[]; (* Ra = R, Rd = R: ref S, Rd.OG.super = S *)
                           Rd.OG.super.last -> Sa[];
                           Sa.ATd[] -> Sd[];
                           (if trace then
                                '**   handleHead:n:'->dumpT; n->dumpI; 'Ra:'->dumpT; Ra.doPT -> dumpT; Ra.on->dumpI; Ra.pn->dumpI;
                                '\n**   Rd:'->dumpT; Rd.dopt->putHeadN;
                                '**   Sa:'->dumpT; Sa.on->dumpI; Sa.pn->dumpI; Sa.doPT->dumpTN; 
                                '**   Sd:'->dumpTN; Sd.dopt->dumpTN;
                           if);
                           (if n = 1 then
                               DOG[] -> OGx[];
                               (for Ra.on + 1 repeat OGx.origin.encOG[] -> OGx[] for);
                               (OGx,false,none) -> OGSequence -> encOGS[];
                           else (* Ra.on = 0 *)
                               (Ra.on = 0,'Ra.on > 0, n > 1') -> AssertOrFail;
                               (for Ra.on repeat encOGS.ENC -> encOGS[] for);
                           if);
                           (for Ra.pn repeat encOGS.PRE -> encOGS[] for); 
                           (for Sa.on repeat encOGS.ENC -> encOGS[] for);
                           (for Sa.pn repeat encOGS.PRE -> encOGS[] for);
                           (if false and Rd.OG.IS.isEmpty then (* missing Rd.OG.super if remote *)
                               (for Rd.OG.super.on repeat 
                                     ('handleHead:virtual',level) -> encOGS.ENC -> encOGS[] 
                               for);
                               (for (Rd.OG.super.last).pn repeat encOGS.PRE -> encOGS[] for);
                               (Rd.OG.super.last).ATd[] -> Sd[];
                           else
                               (*Rd[] -> Sd[]*)
                           if);
                           (if Sd.isVirtual then
                               '**   Sd:isVirtual:'->dumpTN;
                               (Sd.OG[],true,encOGS[])->OGsequence -> encOGS[];
                               encOGS.print;
                               (enclosingOG[],false,encOGS[]) -> (Rd.OG.super.last).getVqual -> (encOGS[],OGx[]);
                               '**   OGx:'->dumpT; OGx.dopt->putHeadN; encOGS.print;
                           else
                              (Sd.OG[],true,encOGS[]) -> OGsequence -> encOGS[];
                          if);
                          (if trace then '**   handleHead:end:n:'->dumpT; n->dumpI; encOGS.print if)
                     else
                        (if trace then '**   handleHead:remote:last:'->dumpT; current.dopt->dumpTN if);
                        current[] -> Ra[] (* the remote pattern *)
                    if)#); (* current = DOG.super.last *)
                    (if trace then 
                        '**   before:last:remotePtn:'->dumpT; Ra.dopt->dumpT; 'Ra.pn:'->dumpT; Ra.pn->dumpI; encOGS.print
                    if);
                    (for Ra.pn repeat encOGS.PRE -> encOGS[] for);
                    (if trace then '**   handleHead:END' -> dumpT; encOGS.print if)
                else (* no super or simple super: T{...} *)
                   (org.encOG[],false,none) -> OGsequence -> encOGS[];
                if);
             #)
       enter(id[],level)
       do (if traceGetVqualShort then 
              '**** ENC:'->dumpT; ('isHead',pred[] = none)->dumpTB; ('isNest',isNest)->dumpTB;
              ('isRemote',isRemote)->dumpTB; newline;
              (if id[] = none then ''-> id[] if);
              ('**   ENC:OGS:'->(id.copy).prepend,0,level) -> print
           if);
          (if true 
           // pred[] = none then (* head *) 
              (* ENC([D]) = [D.origin] *)
              (DOG.origin[] <> none,'ENC: DOG.origin is none!') -> AssertOrFail(#do DOG.doPT->dumpTN; print #);
              ((DOG.origin[]->org[]).encOG[] <> none,'ENC: DOG.origin.encOG is none!')-> assert;
              (if false and newVbinding then
                  (if true then
                      handleHead
                  else
                     (getEncOGX,false,none) -> OGsequence -> encOGS[];
                  if)
              else
                  (org.encOG[],false,none) -> OGsequence -> encOGS[];
              if);
              enclosingOG[] -> encOGS.enclosingOG[]; (* the enclosing OD from the inital call of getVqual 
                                              * why not enclosingOG[] -> encOGS.enclosingOG *)
             (if false and (DOG[] <> enclosingOG[]) then (* they differ ! *)
                '\n!!!! OBS! DOG[] <> enclosingOG[]' -> dumpTN; 
                DOG.dopt -> putHeadN; enclosingOG.doPT -> putHeadN;
                print if)
           // isNest then (* ENC([D1,D2,...,Dn-1,nest(Dn)]) = [D1,D2,...,Dn-1] *)
              pred[] -> encOGS[];
           // isRemote then (* ENC([D1,D2,...,Dn-1,R1.R2.R3.Q]) *)
              (* ENC([D1,D2,...,Dn-1,R.P]) = remote(enc([D1,D2,...,Dn-1]),R) *)
              (pred[]<>none,'ENC:isRemote:pred is none') -> assertOrFail(#do print #);
              pred.DOG[] -> predDOG[]; (* predDOG = Dn-1, DOG = Q *)
              (if newVbinding then 
                  (if traceGetVqualShort then
                      ('**   ENC:isRemote:',0,0)->print
                  if);
                  DOG[] -> pred.handleRemote -> encOGS[];
              else
                  (DOG[],predDOG[],('isRemote',level)-> pred.ENC,level) -> Remote -> encOGS[];
              if) 
           else
              (* ENC([D1,D2,...,Dn-1,Dn]) = PRE[pn] o ENC[on] o ENC([D1,D2,...,Dn-1])
               * where path(Dn-1.super) = (on,pn)
               *)
              pred.getpathToSuper -> (superOD[],superON,superPN,isR,implSuperON,implSuperPN);
              (* OBS! superOD must be the vNameDecl if implSuperON/implSuperPN > 0, but superOD is not used!? *)
              (* thisOGS = [D1,D2,...,Dn-1,Dn], Dn = DOG *)
              (if tracegetvqualShort then
                  '**   ENC:pred:'-> dumpT; 'pred.DOG:' -> dumpT; pred.DOG.doPT -> putheadN;
                  '**   superOD:' -> dumpT; superOD.dopt -> putheadN
              if);
              (id[],level + 1) -> pred.ENC -> encOGS[];
              (if traceGetVqualShort then
                  ('**   ENC:[superPN=',superPN)->dumpTI; ('] o ENC[superON=',superON)->dumpTI; ']'->put; newline
              if);
              (if isR then '!!!! ComputeOGs:isR:Check it!'->dumpTN; print; DOG.dopt->dumpTN if);
              (for i: superON repeat (id[],level + i) -> encOGS.ENC -> encOGS[] for);
              (for i: superPN repeat level -> encOGS.PRE -> encOGS[] for);
              (if (implSuperON > 0) or (implSuperPN > 0) then
                  (if traceGetVqualShort then
                      '**** ENC:vName:A:'->dumpT; implSuperON->dumpI; implSuperPN->dumpI; newline;
                      ('**   encOGS:A',0,0) -> encOGS.print
              if)if);
              (for i: implSuperON repeat (id[],level + i) -> encOGS.ENC -> encOGS[] for);
              (for i: implSuperPN repeat level -> encOGS.PRE -> encOGS[] for);
              (if (implSuperON > 0) or (implSuperPN > 0) then
                  (if traceGetVqualShort then
                      '**** ENC:vName:B:'->dumpT; implSuperON->dumpi; implSuperPN->dumpI; newline;
                      ('**   encOGS:B',0,0) -> encOGS.print
          if)if)if);
          (if traceGetVqualShort then ('**   ENC:result:',0,level) -> encOGS.print if)
       exit encOGS[]
       #);
    
     Remote:
       (* Remote is a function and need not be an attribute of OGsequence
        * Issue: why do we need thisDOG as a pamateter?
        * this(OGs) = [D1,D2,...,Dn,R1.R2.R3.Q]
        * predDOG = Dn, predOGS = [D1,D2,...,Dn], NO! enc([D1,D2,...,Dn]), thisDOG = Q
        * predDOG = predOGS.DOG, thisDOG = this(OGsequence).DOG; they need not be parameters
        * Simple case: remote([D1,D2,...,Dn],Ra) where Dn = Ra.P{...}
        * remote([D1,D2,...,Dn],Ra) = nest(app(super[j] o enc[i]([D1,D2,...,Dn]),Sa),Rd)
        *    where path(Ra) = (Rd,0,j), Rd: ref Sa
        *  remote([D1,D2,...,Dn],R.Q) = nest(app(super[j] o remote([D1,D2,...,Dn,R),Ta,Td)))
        *    where path(Qa) = (Qd,0,j), Qd: ref Ta
        *)
       (# predDOG,thisDOG,OGx: ^ObjectDescriptor; predOGS,Sx: ^OGsequence; level: @integer
       enter(thisDOG[],predDOG[],predOGS[],level)
       do (if traceGetVqualShort then 
               '**** REMOTE:predDOG:'->dumpT; predDOG.dopt->putHeadN;
              ('**   REMOTE:predOGS',0,level) -> predOGS.print;
              ('**   REMOTE:superOGS',0,level) -> print; (* not correct *)
          if);
          L: predDOG.super.scanExps  (* Ra.P.scanExps *)
            (# Ra: ^Exp; Rd: ^Decl; n: @integer
            do current[] -> Ra[]; Ra.getATd -> Rd[]; n + 1 -> n;
               (if traceGetVqualShort then
                   '**   remote:scanSons:n:'->dumpT; n->dumpI; 'Ra:'->dumpT; Ra.dopt->dumpQ; 
                   ('Ra.on',Ra.on)->dumpTI; ('Ra.pn',Ra.pn)->dumpTI; 'Rd:'->putline; Rd.dopt->dumpTN;
               if);
               (if (Ra.ATd.asDecl).OG[] = thisDOG[] then 
                   (* move to below, if not isLast - but what is this?
                    * enc([D1,D2,...,Dn,R.Q] = remote(enc([D1,D2,...,Dn-1]),R)
                    * predOGS  = [T1,T2,...,Tm] enclosing - predOGs is not a precise name, should predEncOGS!?
                    * this(OG) = [D1,D2,...,Dn], Yes, but not used, remote is a function
                    * predDOG  = R.Q{...} where Dn: R.Q{...}
                    * thisDOG  = R.Q in 
                    *)
                   (if newVbinding or traceGetVqualShort then
                       '**** REMOTE:got:thisDOG:'->dumpT; thisDOG.dopt -> putheadN;
                       ('REMOTE:LEAVE',0,level) -> predOGS.print;
                   if);
                   leave L;
               if);
               (if not isLast then
                   (* remote([D1,D2,...,Dn],R) = nest(app(super[j] o enc[i]([D1,D2,...,Dn]),Sa),Sd)
                    *    where path(Ra) = (Rd,i,j), Rd: ref Sa; Sd: ...
                    *)
                   (* DOG = R.Q where Q is not remote and R = R1.R2.Rn, n >=1 *)
                   (if newVbinding and (n > 1) then 
                       '!!!! REMOTE:BUM: n > 1: '->dumpT; predDOG.dopt->putheadN;
                   if);
                   (if traceGetVqualShort then
                       '**   REMOTE:Ra.on,pn:'-> dumpT;  Ra.on->dumpI; Ra.pn->dumpI; newline;
                       '**   Ra:'->dumpT; Ra.doPT->dumpTN;
                       ('predOGS:',0,0)->predOGS.print
                    if);
                   (for i: Ra.on repeat ('remote:B',level + i) -> predOGS.ENC -> predOGS[] for);
                   (for i: Ra.pn repeat level -> predOGS.PRE -> predOGS[] for);
                   (* Is Ra.ATd ok? We have Ra => Rd: ref Sa; ... Sa => Sd: ...
                    * Ra.ATd = Rd: ref Sa - should perhaps be?
                    * But append seems ok!? Is OGx below ok?
                    *);
                   (if tracegetvqualShort then
                       ('**   REMOTE:before:append:',0,0)->predOGS.print;
                       '**   Ra:'->dumpT; Ra.dopt->dumpQ; 'Rd:'->dumpt; Rd.dopt->dumptn
                   if);
                   (thisDOG[],Ra.getATd,level) -> predOGS.append -> (predOGS[],OGx[]);
                   (if tracegetvqualShort then
                       ('**   REMOTE:after:append:',0,0)->predOGS.print; '**   OGx:'->dumpt; OGx.dopt->dumptn;
                       '**     predDOG:'->dumpT; predDOG.dopt -> putheadN; 
                       '**   predDOG.last:'->dumpT; (predDOG.super.last).label->dumpT; 
                       (predDOG.super.last).dopt->dumpT; ('pn',(predDOG.super.last).pn)->dumpTI; newline
                   if);
                   (if (predDOG.super.last).pn > 0 then
                       (* This does not makes sense since this path is only takne if not last;
                        * For R1.R2.P, we have followed R2.pn, so why follow P.pn?
                        * And this will happen for Ra = R1 and Ra = R2
                        * And using pn-1 looks like a hack
                        *)
                        (if false and (n > 1) and ((predDOG.super.last).pn > 1) then 
                            '**** n>1, (predDOG.super.last).pn > 0 ' -> dumpTN;
                            '**** REMOTE:predDOG:'->dumpT; predDOG.dopt->putHeadN;
                            '**   Ra:'->dumpT; Ra.dopt -> dumpT; n -> dumpI; newline;
                            '**   predDOG.super.last:'->dumpT; (predDOG.super.last).dopt->dumpTN;
                            ('**   REMOTE:predOGS',0,level) -> predOGS.print;
                        if);
                        (for i: (predDOG.super.last).pn - 1 repeat level -> predOGS.PRE -> predOGS[] for);
                        (if traceGetVqualShort then ('**   xtendedOGS:',0,0) -> predOGS.print if)
                   if);
                   predOGS[] -> Sx[];
                   (if false then
                       '**   mkNest:'->dumpT; OGx.dopt->putheadN; Rd.dopt->putHeadN;
                       Sx.print;
                   if);   
                   (OGx[],true,Sx[]) -> OGsequence -> predOGS[]; (* Is true always correct here? *)
                   (if false or traceGetVqualShort then
                       ('**   REMOTE:next:OGS:',0,0) -> predOGS.print
           if)if)#);
          (if newVbinding or tracegetvqualShort then ('**** REMOTE:END',0,level) -> predOGS.print if)
       exit predOGS[]
       #);  
     append:
       (* Append path from D.super to decl of super
        * D may be a dataItem: R: ref/obj ...
        *   or a pattern returning a datum: P: { ..., out R: ref/obj ... }
        * append([D1,D2,...,Dn],Qa) = super[j] o enc[i]([D1,D2,...,Dn]), path(Qa) = (Qd,i,j)
        * append([D1,D2,...,Dn],R.Qa) = remote(super[j],R), path(Qa) = (Qd,0,j)
        *)
       (# superDecl: ^Decl(*SuperDataItem*); S,Sx: ^OGsequence; encOG,OGx: ^ObjectDescriptor; 
          MI: ^ModuleItem; QATd: ^decl; level: @integer; DI: ^DataItem
       enter(encOG[],superDecl[],level)
       do  (if tracegetvqualShort then
               '**** append:superDecl: '->puttext; superDecl.dopt ->putheadN;
               ('**   superDecl.OG.IS.isEmpty',superDecl.OG.IS.isEmpty)->dumpTB;
               ('hasVargs',superDecl.OG.hasVirtualArgs)->dumpTB; newline
          if);
          (if false then 
              (not superDecl.isPattern,'OGsequence:append:invoked with pattern:')
                 -> assert(#do superDecl.dopt -> putHeadN #)
          if);
          (if superDecl.isModuleItem then (superDecl[]->MI[]).MD[] -> superDecl[] if); 
          this(OGsequence)[] -> S[];
          (if superDecl.OG.IS.isEmpty and 
              (not superDecl.OG.hasVirtualArgs or superDecl.isDataItem and not (superDecl[]->Di[]).isConst)
              (* We need to understand this! 
               * For ChemicalPlantSystem, not isConst is needed
               *   handles theSchedule: ref Schedule, IS.isEmpty, Schedule hasVirtualArgs, but not isConst
               * For CityLink, we dont need it!?
               * D: obj/ref S, S is a pattern
               *)
              then
              (if superDecl.OG.hasVirtualArgs then
                  (if tracegetvqualShort and superDecl.isDataItem and not (superDecl[]->Di[]).isConst then
                      '**** virtual:append:'->dumpT; superDecl.dopt->dumpTN
              if)if);
              superDecl.OG.super.scanExps(*sons*)
              (# i: @integer; Qa: ^Exp
              do (if (i + 1 -> i) > 1 then
                     (if toFix then
                         '!!!!  append:dataItem:remote not implemented:' ->putline; superDecl.dopt -> putline;
                     if);
                     S[] -> Sx[]; (* Sx is not used - remove this statement *)
                     (OGx[],true,S[]) -> OGsequence -> S[];
                 if);
                 current -> Qa[]; Qa.getATd -> QATd[];
                 (if tracegetvqualShort then
                     '**   append:scan:Qa: "'->puttext; Qa.dopt ->dumpT; '" on='->dumpT; Qa.on->dumpI;
                      'Qa.pn='->dumpT; Qa.pn->dumpI; newline; ('Qa.ATd',Qa.ATd[])->putPT;
                      '**   QATd:'->dumpT; QATd.dopt->putHeadN;
                  if);
                 (for i: Qa.on repeat ('append:',level + i) -> S.ENC -> S[] for);
                 (for i: Qa.pn repeat level -> S.PRE -> S[] for);
                 (if QATd.isVirtual and QATd.OG.IS.isEmpty then
                     (encOG[],isNest,S[]) -> QATd.getVqual -> (S[],OGx[]);
                     (if (*true or *) tracegetvqualShort then
                        '**   append:QATd.isVirtual:i:'->dumpT; i -> dumpI; newline;
                        '**   QATd:'->dumpT; QATd.dopt->putHeadN;
                        '**   encOG:'->dumpT; encOG.doPT -> putheadN;
                        '**   enclosingOG:'->dumpT; (getenclosingOG).doPT -> putheadN;
                        '**   enclosingOG:at:nest:'->dumpT; (true->getenclosingOG).doPT -> putheadN;
                        '**   OGx:'->dumpT; OGx.dopt->putHeadN;
                        S.print
                     if)
                 else
                    (QATd.asDecl).OG[] -> OGx[]
                 if)
              #)
           else
              (* Qd: obj S{ ... }, singular; Qd: obj S, S has virtual args => implict singular
               * what about Qd: ref S; where S may be virtaul or non-virtual
               *)
              superDecl.OG[] -> OGx[];
                 (if false then 
                     '**   append:singular:'->dumpT; OGx.dopt->putHeadN;
                 if);
              (if tracegetvqualShort then '**   append:singular_or_virtualArgs:'->dumpTN if);
          if);          
          (if tracegetvqualShort then '**   append:END:OGx:' -> dumpT; OGx.dopt->putHeadN  if);
       exit(S[],OGx[])
       #);
     PRE: (* this(OG) = [D1,D2,...,Dn], Dn = D{...} or R.D{ ... } *)
       (# S: ^OGsequence; superOD: ^ObjectDescriptor; 
          superON,superPN,implSuperON,implSuperPN: @integer; isR: @boolean;
          level: @integer
       enter level
       do (if tracegetvqualShort then ('**** PRE: ',0,level) -> print if);
          (if true then
               getPathToSuper -> (superOD[],superON,superPN,isR,implSuperON,implSuperPN); 
          else (* path to D or D in R.D, OGx = D *)
               pathToSuper -> (superOD[],superON,superPN,isR,implSuperON,implSuperPN);
          if);
          (if false and ((implSuperON > 0) or (implSuperPN > 0)) then '**   PRE:implcitSuperPTN:'->dumpTN if);
          (superOD[],false, this(OGsequence)[]) -> OGsequence -> S[]; 
          isR -> S.isRemote;
          (if tracegetvqualShort then 
              '**   PRE:superON:'->dumpT; superON->dumpI; 'superPN:'->dumpT; superPN->dumpI; 
              'isR:'->dumpT; isR->dumpB;
              ' superOD:'->dumpT; superOD.dopt -> putheadN; ('**   PRE:END:',0,level) -> S.print
          if)
       exit S[]
       #);
     getPathToSuper:
        (# superOD: ^ObjectDescriptor; on,pn,implSuperON,implSuperPN: @integer; isR: @boolean;
           OIexp: ^Exp; D: ^Decl; ptn: ^Pattern; 
        do (if traceGetVqualShort then
                '**** getPathToSuper:BEGIN:'->dumpT; 
                (if DOG.super.isImplSuper then 'implicitSuper:' -> dumpT if);
                'DOG:'->dumpT; DOG.doPT->putHeadN;
           if);
           (if not DOG.isChecked then
               (* this happens*) (none,DOG.origin[],DOG.origin[],true) -> DOG.check;
           if);
           DOG.super.scanExps
             (# n: @integer
             do (n + 1 -> n) > 1 -> isR;
                current[] -> OIexp[];
             #);
           (if DOG.super.isImplSuper then
               DOG.super.ATd[] -> D[]; (* D is a virtual pattern/binding *)
               0 -> on;
               DOG.super.pn -> pn; 
               (if newVbinding and D.OG.IS.isEmpty then (* D has the form V:< A, no mainpart *)
                   D.OG.super.on -> implSuperON; (D.OG.super.last).pn -> implSuperPN;
               if); 
            else
               OIexp.ATd[] -> D[]; (* same as DOG.super.ATd ? *)
               OIexp.on -> on; 
               OIexp.pn -> pn; 
           if);
          L:
           (if true
            // D[] = none then 
               (*'!!!! getPathToSuper:super.ATd is none' -> putline;*)
               ObjectDecl[] -> D[] -> ptn[]
            // D.isPattern then D[] -> ptn[]
            // D.isNameDecl then 
               (# ND: ^NameDecl
               do (*'****nameDecl:'->puttext; D.dopt -> putline;*)
                  (* only if nameListInDcl *)
                  D[] -> ND[];
                  ND.ATd[] -> D[]; 
                  restart L
               #)
            else 
               '!!!! getPathToSuper:super.ATd is not Pattern or is empty: '  -> putline;
               DOG.doPT -> puthead;
               leave L
           if);
           ptn.OG[] -> superOD[];
           (if traceGetVqualShort then
              '**   getPathToSuper:END:super:'->dumpT; 
              (if DOG.super.isImplSuper then '#'->dumpT else OIexp.dopt -> puthead if);
              (' super.on',on)->dumpTI; ('super.pn',pn)->dumpTI; ('isR',isR)->dumpTB;
              ('on1',implSuperON)->dumpTI; ('pn1',implSuperPN)->dumpTI;
              ('super.ATd.isVirt',ptn.isVirtual)->dumpTB; 'super.ATd:'->dumpT; ptn.doPT->putheadN;
          if);
        exit(superOD[],on,pn,isR,implSuperON,implSuperPN)
        #);
     handleRemote:
        (# trace: (# exit traceGetVqualShort #); encOGS: ^OGsequence; thisDOG: ^ObjectDescriptor;
           possibleBindings: BooleanValue
              (* R1: obj T{... }, R2: ref T(#A), R3: obj T(#A) -> TRUE
               * R4: ref T, R5: obj T -> FALSE
               *)
              (# D: ^Decl
              enter D[]
              do (if D.OG.IS.isEmpty then
                    (if not D.OG.super.isEmpty and D.OG.super.hasVirtualArgs then (* R2, R3 *)
                        (if trace then
                            '**** possibleBindings:TRUE:'->dumpT; D.dopt->dumpTN;
                        if);
                        true -> value;
                        leave possibleBindings
                    if) (* else R4, R5 *)
                 else (* R1 *)
                    true -> value
              if)#)
        enter thisDOG[]
        do (if trace then
               '**** handleRemote:DOG:'->dumpTN; DOG.doPT->dumpTN;
               '**   thisDOG:'->dumpTN; thisDOG.doPT -> putHeadN; print;
           if);
           ENC -> encOGS[];
           DOG.super.scanExps
              (# n: @integer; Ra,Sa: ^Exp; Rd,Sd: ^Decl; OGx: ^ObjectDescriptor;
              do n + 1 -> n;
                 current[] -> Ra[];
                 (if false and ((Ra.ATd.asDecl).OG[] = thisDOG[]) then
                     (* we still do not understand what to do here; see also remote *)
                     '!!!! We got thisDOG:'->dumpT; n->dumpI; newline; encOGS.print
                 if);
                 (if not isLast then
                     (if trace then
                         '**   handleRemote:n:'->dumpT; n->dumpI;
                         'Ra:'->dumpT; Ra.doPT->dumpT; Ra.on->dumpI; Ra.pn->dumpI;
                     if);
                     (if n = 1 then
                         (for Ra.on repeat encOGS.enc -> encOGS[] for)
                     else (* Ra.on = 0 *)
                         (Ra.on = 0,'Ra.on > 0, n > 1') -> AssertOrFail
                     if);
                     (for Ra.pn repeat encOGS.PRE -> encOGS[] for); 
                     Ra.getATd -> Rd[]; (* Ra = R, Rd = R: ref S, S: S0{...} or S:< V  *)
                     (if trace then '\n**   Rd:'->dumpT; Rd.dopt->putHeadN if);
                     (enclosingOG[],false,encOGS[]) ->  Rd.getVqual -> (encOGS[],OGx[]);
                     (OGx[],true,encOGS[]) -> OGsequence -> encOGS[];
                     (if trace then
                          '**   getVqual:'->dumpT; Ra.dopt->dumpT; Rd.dopt->putHeadN;
                          '**           :'->dumpT;encOGS.print;
                     if);
                     (if FALSE then
                     (if not (Rd[] -> possibleBindings) then
                        (* Rd: ref T, Rd: obj T *)
                        Rd.OG.super.last -> Sa[]; (* must handle super as remote *)
                        Sa.ATd[] -> Sd[]; (* Sd: S0a:{...} *)
                        (if true or trace then
                            '**   Sa:'->dumpT; Sa.on->dumpI; Sa.pn->dumpI; Sa.doPT->dumpT;
                            'Sd:'->dumpTN; Sd.dopt->putHeadN;
                        if);
                        (for Sa.on repeat encOGS.ENC -> encOGS[] for);
                        (for Sa.pn repeat encOGS.PRE -> encOGS[] for);
                        (if Sd.isVirtual then (* TO BE FIXED *)
                            (if false then '\n!!!! Sd:isVirtual:'->dumpTN if);
                            (Sd.OG[],true,encOGS[])->OGsequence -> encOGS[];
                            (if false then encOGS.print if);
                            (enclosingOG[],false,encOGS[]) -> (Rd.OG.super.last).getVqual -> (encOGS[],OGx[]);
                            (if false then
                                '**   OGx:'->dumpT; OGx.dopt->putHeadN; encOGS.print;
                                '**   Sd.OG:'->dumpT; Sd.OG.dopt->dumpTN; Sd.OG.father.dopt->dumpTN;
                            if);
                            (OGx[],true,encOGS[]) -> OGsequence -> encOGS[];
                            (if false then encOGS.print if)
                        else
                            (Sd.OG[],true,encOGS[]) -> OGsequence -> encOGS[]; 
                        if);
                     else (* Really Rd: obj T(A,...), Rd: ref T(A,...) where A is a pattern *)
                        (if trace then '**   handleRemote:Rd is singular:'->dumpTN if);
                        (Rd.OG[],true,encOGS[]) -> OGsequence -> encOGS[]
                     if);
                     (if true or trace then '**   asOf_Now:'->dumpT; encOGS.print if)
                     if)
                 else
                     (if trace then '**   handleRemote:last:'->dumpT; current.dopt->dumpTN if);
                     (for Ra.pn repeat encOGS.PRE -> encOGS[] for)
              if)#);
              (if trace then '**   handleRemote:END'->dumpT; encOGS.print if)
        exit encOGS[]
        #);
     getenclosingOG:
        (# iDOG: ^ObjectDescriptor; atNest: @Boolean
        enter atNest
        do (if true
            // pred[] = none // isNest and atNest then
               DOG[] -> iDOG[]
           else
               pred.getenclosingOG -> iDOG[]
           if)
        exit iDOG[]
        #);
     newFindBinding::
       (# OGx: ^ObjectDescriptor
       do (if tracegetvqualShort then
              '**** newFindBinding: ' -> puttext;
              vDcl.dopt -> putheadN;
          if);
          vDcl[] -> searchBinding -> qual[];
          (if false then
              '**** newFindBinding:end: ' -> puttext;
              vDcl.dopt -> putheadN;
          if);
          (if qual[] = none then
              (if tracegetvqualShort then
                  '!!!! No binding found in OGsequence! Use: '->puttext;
                  vDcl.doPT -> putheadN
              if);
              vDcl.OG[] -> qual[];
           else
              (if tracegetvqualShort then
                  '**** newFindBinding:found: ' -> puttext; qual.dopt ->putheadN
              if)
          if)
       #);
     searchBinding:
       (# vDcl: ^Pattern; qual: ^ObjectDescriptor
       enter vDcl[] 
       do (if tracegetvqualShort then
              '**** searchBinding: ' -> puttext; vDcl.dopt -> putheadn; print;
          if);
          (if isNest or (pred[] = none) then
           else
              vDcl[] -> pred.searchBinding -> qual[]
          if);
          (if qual[] = none then
              (vDcl[],DOG[]) -> checkDOG -> qual[]
          if)
       exit qual[]
       #);
     checkDOG:
       (* check for binding of vDcl in DOG *)
       (# vDcl: ^Pattern; DOG,qual: ^ObjectDescriptor;
       enter(vDcl[],DOG[])
       do (if tracegetvqualShort then
              '**   checkDOG:' -> dumpT; DOG.doPT -> putheadN;
          if);
          (if false then
              '**** beingChecked:'->dumpt; dog.beingchecked->putboolean;
              ' isChecked:'->dumpt; dog.isChecked -> putboolean; newline;
              (none,DOG.origin[],DOG.origin[],true) -> DOG.check;
          if);
          checkForBinding:
            (# Ex:^Exp; OGs: ^ObjectDescriptor; argNo: @integer; ND: ^NameDecl
            do DOG.IS.scanDecls
               (# ptn,P: ^Pattern
               do (if currentDcl.isPatternDecl then
                      currentDcl[] -> ptn[];
                      (if false and not ptn.isChecked and not ptn.beingChecked then
                          '**** qvirtual:doCheck: ' -> dumpT; 
                          ptn.dopt -> putheadN;
                          (none,ptn.origin[],ptn.origin[],true) -> ptn.check;
                      if);
                      (if ptn.isVirtual then
                          (if false and tracegetvqualShort then
                              '**   try: ' -> puttext; ptn.dopt -> puthead
                          if);
                          ptn[] -> P[];
                          loop: 
                            (if vDcl[] = P[] then
                                (if tracegetvqualShort then
                                    '\n ==== FOUND BINDING: =====' -> putline;
                                    ptn.dopt -> putheadn;
                                if);
                                (if ptn.OG.IS.isEmpty then
                                    (* Should we include not ptn.OG.hasVirtualArgs? *)
                                    (if ptn.beingChecked then
                                        ptn.OG.super.scanExps(*Sons*)
                                        (# OI: ^ObjectInvocation; D: ^Decl
                                        do (current[]->OI[]).ptnID[]
                                             -> DOG.IS.doSearch -> D[];
                                           D.asDecl -> ptn[];
                                        #)
                                     else
                                        (if nameListInDcl then
                                            (ptn.OG.super.ATd[]-> ND[]).ATd[] -> ptn[];
                                         else
                                            ptn.OG.super.ATd[] -> ptn[];
                                        if);
                                if)if);
                                ptn.OG[] -> qual[];
                                true -> hasBinding;
                                (*print; qual.dopt -> puthead;*)
                                leave checkForBinding
                             else
                                (* probably check ptn.vDcl recursively *)
                                (if P.vDcl[] = none then
                                    (if P.ptnKind // FinalPtn // FurtherPtn then
                                        (if false then
                                            '**** virtual:Binding:P.vDcl:none:' ->dumpTN;
                                            P.dopt -> putheadN;
                                            '**** beingChecked:'->dumpt; 
                                            ptn.beingchecked->putboolean;
                                            ' isChecked:'->dumpt; ptn.isChecked -> putboolean;
                                            newline;
                                        if);
                                        (none,ptn.origin[],ptn.origin[],true) -> P.check;
                                if)if);
                                (if (P.vDcl[] -> P[]) <> none then
                                    restart loop
               if)if)if)if)#);
               (* check possible binding in arguments of DOG.super.last *)
               LLL:
                 (if DOG.IS.superDesc[] <> none then
                     DOG.super.last -> Ex[];
                     DOG.IS.superDesc.father[] -> OGs[];
                     (if tracegetvqualShort then
                         '**   Ex: ' -> puttext; Ex.dopt -> putheadN;;
                         '**   Ex.OGs.super:'->putline; OGs.dopt -> putheadN;
                     if);
                     (if (Ex.args[] <> none) and (Ex.args.noOfSons > 0) then
                         OGs.IS.scanNonBoundItemArgs
                         (# 
                         do argNo + 1 -> argNo;
                            (if tracegetvqualShort then
                                '**   currentArg: ' -> puttext; currentArg.dopt->putheadN;
                            if);
                            (if currentArg[] = vDcl[] then
                                Ex.args.scanArgs
                                (# i: @integer
                                do i + 1 -> i;
                                   (if i = argNo then
                                       (if tracegetvqualShort then
                                           '**   superArg: ' -> puttext; 
                                           current.label -> puttext;
                                           ' '->put; current.dopt-> putline;
                                       if);
                                       (if tracegetvqualShort then
                                           '\n==== FOUND BINDING IN ARG: ' -> putline;
                                           current.dopt -> putheadn;
                                       if);
                                       current.getQual -> qual[];
                                       true -> hasBinding;
                                       leave LLL
            if)#)if)#)if)if)#)
       exit qual[]
       #);
     getOGstart:: 
       (* Return the start OG of this OGsequence from where a virtual binding
        * has to be searched. For a simple OGs with no nesting:
        *    [OD1, OD2, ... ODn]
        * the start is OD1.
        * If nesting appers:
        *    [OD1, OD2, ..., ODn-1, nest(ODn),ODn+1, ...,ODm]
        * the start is ODn asssuming no isNest(OGk), n < k and k <= m
        *)
       (#
       do (if tracegetvqualShort then
              '**** getOGstart: ' -> putline; print
          if);
          (if isNest then
              DOG[] -> qual[]
           else
              (if pred[] <> none then
                  pred.getOGstart -> qual[]
               else
                  DOG[] -> qual[]
          if)if);
          (if tracegetvqualShort then
              '**** getOGstart:isNest: ' -> puttext; isNest -> putboolean;
              ' qual: ' -> puttext; qual.doPT -> puthead;
          if)
       #);     
     print::
       (# (*msg: ^text; L,level: @integer *) D: ^ObjectDescriptor
       do (if msg[] <> none  then msg[] -> puttext if);
          (if L = 0 then '[' -> put; level -> putint; ':'->put if);
          (if pred[] <> none then (none, L + 1,level) -> pred.print if);
          (if isRemote then 'r:' -> puttext if);
          (if isNest then 'nest(' -> puttext if);
          DOG.OGid -> puttext;
          (if false and (enclosingOG[] <> none) then 
              '!'->put; enclosingOG[] -> D[];
              L: (if  (D[] = DOG[]) then
                     '+'->put
                 else
                    (if (D.origin[] <> none) then
                        D.origin.encOG[] -> D[]; 
                        restart L 
                    else '-'->put 
          if)if)if);
          (if false and (enclosingOG[] = DOG[]) then '='-> put if);
          (if hasBinding then '&' -> put if);
          (if isNest then ')' -> put if);
          (if L = 0 then ']' -> put; newline else ',' -> put if)
       #);
  do (if pred[] = none then DOG[] -> enclosingOG[] if);
  exit this(OGsequence)[]
  #)
