ORIGIN '~beta/basiclib/betaenv';  
---lib:attributes---
(* aux patterns that may be moved to basiclib or other general lib *)
assert:
  (# pred: @boolean; msg: ^Text
  enter(pred,msg[])
  do (if not pred then 
         '\n!!!! Assertion failure:\n!!   '-> puttext;
         msg[] -> putline; 
         newline;
         inner assert
  if)#);
  assertOrFail: assert(#do inner assertOrFail; (failureTrace,'!!   See qbeta/xbeta.dump') -> stop #)

