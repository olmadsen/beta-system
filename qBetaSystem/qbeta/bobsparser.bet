ORIGIN '~beta/basiclib/betaenv';
INCLUDE '~beta/basiclib/file';
INCLUDE '~beta/sysutils/envstring';
INCLUDE '~beta/bobs/bobs';
---PROGRAM: descriptor---
(**** BOBS parser for qBeta ****
 **   Based on ~beta/bobs/parse.bet
 *)
(# trace: (#exit false #);
   B: @BOBS;
   F: @File;
   TableFileName,T: ^text; 
   BetaLib: (# path: ^text do '$(BETALIB)' -> expandEnvVar -> path[] exit path[] #);
   usage: (##);
   init:
      (#
      do BetaLib -> TableFileName[];
         '/grammars/qbeta/qbeta-parser.btabL' -> TableFileName.append;
         TableFileName[] -> putline;
         (TableFileName[],True,false,false,true,true,false,true) -> B.init;
         (* parameters:
          * (TableFileName[],True,isEos,docParser,dashInNames
          *  ,newlineIsCommentEnd,caseSensitive,splitString) -> B.init;
          *)
          (if NoOfArguments >= 2  then
              2 -> arguments -> F.name; 'Parsing file: '-> puttext; F.name -> putLine;
         else
            'StringFile is missing!' -> putLine; 
            usage;
        if)
      #);
   parse:
      (# Poss: [100] @ integer; legalss: [100] ^Text; Etop: @integer;
        Tparse: B.Parse
          (# Shift::< 
               (#
               do (if trace then 
                      'shift:  ' -> puttext; scan(#do ch -> put #); newline 
               if)#);
             Reduce::<
               (#
               do (if trace then
                      'reduce: ' -> puttext; prodNo -> B.printProd; newline
               if)#);
             Comment::<
               (#
               do (if trace then
                      'comment:' -> puttext; scan(#do ch -> put #); newline
               if)#);
             MarkError::<
               (# B: @boolean
               do (if ((Etop+1 -> Etop) > Poss.range)  then 
                      100 -> Poss.extend;
                      100 -> legalss.extend;
                  if);
                  pos -> Poss[Etop];
                  &text[] -> legalss[Etop][];
                  LegalSymbs.scan
                  (#
                  do thisSymbText -> legalss[Etop].putText;
                     ' ' ->  legalss[Etop].put
                  #)
	       #);
	     FatalError::<(# do 'Bobs parse error!' -> msg.putLine #);
          #); (* Tparse *)
         lst: @file; ok: @Boolean
      do  F.openRead; 
          (0(*Goal*),F[]) ->  Tparse -> ok; 
          F.close;
          (if ok then
            newline; 'No syntax errors!' -> putLine;
          else
             F.openRead; 'errors.lst'->lst.name; lst.openWrite;
            (F[],lst[],false,Poss,Legalss,Etop)->BobsErrorReport ;
            F.close; lst.close;
            'Syntax error(s) in input. See file \'errors.lst\'\n'->Puttext;
          if)
      #)
do '**** BOBS parser for qBeta ****' -> putline;
   init;
   parse
#)
