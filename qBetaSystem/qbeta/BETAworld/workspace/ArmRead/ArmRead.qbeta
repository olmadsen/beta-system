ArmRead: obj
   "ArmRead here:\n".print
   UART_read_isReady:
      %basic 25
      out B: var Boolean
   ch: var Char
   V: var integer
   ch := _get
   put(ch)
   newline
   put('%')
   newline
   V := UART_read_isready
   putint(V)
   newline
   wait: do
       if (! UART_read_isready) :then
          put('#')
          restart(wait)
   ch := _get
   put(ch)
   for (1):to(12) :repeat
       ch := _get
       put(ch)
   coWait: do
      loop: do
         tryRead: obj
            if (UART_read_isready) :then  
               ch := _get
               leave(loop)
            tryRead.suspend
            restart(tryRead)
         tryRead.call
         restart(loop)
      if (ch = '\n') :then
         ... --put('N')
      if (ch = '\r') :then
         ... --put('R')
      put(ch)
      restart(coWait)
