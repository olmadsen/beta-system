LocationEx: obj
   class Address:
      adr: var String
      setAdr(ad: var String):< 
         "setAdr: ".print
         inner(setAdr)
         adr.print
         newline
   class Taxable:
       taxRate: var Integer
       setTaxRate(tr: var integer):< 
          "setTaxRate:".print
          inner(setTaxRate)
          putint(taxRate)
          newline
   class Person(Name: var String):
       theAdr: obj Address
          setAdr::
             adr := ad
       asTaxable: obj Taxable
          setTaxRate::
             taxRate := tr
    
   p: ref Person; a: ref Address; t: ref Taxable; 
   P := Person("Roberto")
   p.theAdr.setAdr("Rome")
   p.asTaxable.setTaxRate(34)
   "**** Get parts\n".print
   a := p.theAdr
   a.setAdr("Berlin")
   t := p.asTaxable
   t.setTaxRate(40)
   "**** Get locations\n".print
   p := location(a)
   p.theAdr.setAdr("Paris")
   p := location(t)
   p.asTaxable.setTaxRate(45)