LocationEx: obj
   class Addressable:
      adr: var String
      setAdr(ad: var String):< 
         "setAdr: ".print
         getName.print
         put(',')
         inner(setAdr)
         adr.print
         newline
      getName-> N: var String:<
         inner(getName)
   class Taxable:
       taxRate: var Integer
       setTaxRate(tr: var integer):< 
          "setTaxRate:".print
          inner(setTaxRate)
          putint(taxRate)
          newline
   class Person(Name: var String):
       theAdr: obj Addressable
          getName::
             n := name
          setAdr::
             adr := ad
       asTaxable: obj Taxable
          setTaxRate::
             taxRate := tr
   class Company(name: var String):
       theAdr: obj Addressable
          getName::
             n := name
          setAdr::
             adr := ad
       asTaxable: obj Taxable
          setTaxRate::
             taxRate := tr
   p: ref Person; c: ref Company; 
   a: ref Addressable; t: ref Taxable; 
   p := Person("Roberto")
   c := Company("LEGO")
   p.theAdr.setAdr("Rome")
   p.asTaxable.setTaxRate(34)
   c.theAdr.setAdr("Sweden")
   c.asTaxable.setTaxRate(25)
   "**** Get parts\n".print
   a := p.theAdr
   a.setAdr("Berlin")
   t := p.asTaxable
   t.setTaxRate(40)
   "**** Get locations\n".print
   p := location(a)
   p.theAdr.setAdr("Paris")
   p := location(t)
   p.asTaxable.setTaxRate(45)
   "**** Company locations\n".print
   c.theAdr.setAdr("Billund")
   c.asTaxable.setTaxRate(34)
   a := c.theAdr
   a.setAdr("Billund I")
   c := location(a)
   c.theAdr.setAdr("Billund II")

