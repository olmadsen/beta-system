Grann: obj
   class Consumer:
      in Type:< Object
      consume:<
         in elm: ref Type
         inner (consume)
   class PipeLine:
      in Type:< Object
      advance:<
         in theConsumer: ref Consumer(#Type)
         out succes: var boolean
         inner (advance)
      scan:
        in theConsumer: ref Consumer(#Type)
        dummy: var boolean
        while (advance(theConsumer)) :repeat
           dummy := true -- kan man slippe for at have en dummy operation her?
   class Deque:
      in Type :< Object
      class Link:
         elm: ref Type
         prev: ref Link
         next: ref Link
      first: ref Link
      last: ref Link
      addFirst(elm: ref Type):
         lnk: ref Link
         lnk := Link
         lnk.elm := elm
         if (first =/= none) :then
            first.prev := lnk
         lnk.next := first
         first := lnk
         if (last = none) :then
            last := first
      class ForwardPipe: PipeLine(#Type)
         current: ref Link
         advance::
            if (current =/= none) :then
               theConsumer.consume(current.elm)
               current := current.next
               succes := true
      forward -> p: ref ForwardPipe:
         p := ForwardPipe
         p.current := first
      class BackwardPipe: PipeLine(#Type)
         current: ref Link
         advance::
            if (current =/= none) :then
               theConsumer.consume(current.elm)
               current := current.prev
               succes := true
      backward -> p: ref BackwardPipe:
         p := BackwardPipe
         p.current := last

   class Person(name: var String):
      display:
         name.print
   printer: obj Consumer(#Person)
      consume::
         elm.display             
   people: obj Deque(#Person)
   people.addFirst(Person("Jane Doe"))
   people.addFirst(Person("John Doe"))
   p1: ref PipeLine(#Person)
   p1 := people.forward
   p1.advance(printer) -- Kan printer være en anonym blok?
   newline
   p1.advance(printer)
   newline
   p2: ref PipeLine(#Person)
   p2 := people.backward
   p2.advance(printer)
   newline
   p2.advance(printer)
   newline

   -- følgende giver betaVM fatal error: ValueStack underflow!
   -- people.forward.scan(printer)
