ObjKindEx: obj
   RecordA:
      x: var integer
      y: var integer
   RecordB:
      in x: var integer
      in y: var integer
      z: var integer
   RecordC:
      x: var integer
      y: var integer
      X := 111
   RecordD:
      in x: var integer
      in y: var integer
      z: var integer
      x := 112
   RecordE: Value
      x: var integer
      y: var integer
   RecordF: Value
      in x: var integer
      in y: var integer
   RecordG: Value
      in x: var integer
      in y: var integer
      x := 999
   RecordH:
      X: obj Adress
   RecordI:
      in x: var integer
      in y: var integer
      x := 1011
      inner(RecordI)
      x := 1015
   RecordJ: RecordI
      x := 1014
   Adress:
      S: var StringLib.String
   fooA:
      x: var integer
      x := 117
   fooB:
      x: var integer
      fooC:
         x := 111
         this(fooB).suspend
         x := 112
      fooC
   r1: ref RecordA
   r2: ref RecordB
   r3: ref RecordC
   r4: ref RecordD
   r5: var RecordE
   r6: var RecordF(1,2)
   r7: var RecordG(3,4)
   r8: ref RecordH
   r9: ref RecordJ
   fooA
   fooB
   "\nA new module ObjKindEx  has been created!".print
