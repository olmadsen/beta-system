NewBindings: obj
    run: 
        DQ1:
            v1:< Object
            QQ0:
                P: 
                    v0:< Object; x: ref v0; y: ref v1;
                    y := v1
                    inner(P)
            DW1:
                QQ1: QQ0
                    ...
                ED1: 
                    S0:
                       R3: ref QQ1
                       R3 := QQ1
                    S1: S0
                       ...
                    B1:< object
                    z: ref v1
                    T0: 
                       R2: ref S1
                       R2x: obj S1
                          ...
                       R2v: ref B1
                       R2 := S1 
                       R2v := S1
                    DR1: 
                       T1: T0
                           ...
                       W0: 
                          gogo: var integer
                       inner(DR1)
                    inner(ED1)
                inner(DW1)
            inner(DQ1)
        DQ2: DQ1
            v1 :: 
                go: 
                   in ch: var char
                   put(ch)
                   put(ch+1)
            DW2: DW1
                ED2: ED1 
                    B1::
                       %ID "B1"
                       R3: ref QQ1
                       R3 := QQ1
                    DR2: DR1
                        R1: ref T1
                        DT1: 
                            B: R1.R2.R3.P
                                v0:: W0
                                y.go('b')
                                inner(B)
                            Bx: R1.R2x.R3.P
                                y.go('g')
                            Bv: R1.R2v.R3.P
                                y.go('i')
                            inner(DT1)
                            Bx
                            Bv
                        R1 := T1
                        inner(DR2)
                    inner(ED2)
                inner(DW2)
            inner(DQ2)
        DQ3: DQ2
           v1 ::<
              bum:
                in ch: var char
                put(ch)
           DW3: DW2
              ED3: ED2
                  DR3: DR2
                      DT2: DT1
                           B1: B
                              y.go('d')
                              y.bum('f')
                           B1
                      DT2
                  DR3
              ED3
           DW3
        put('a')
        DQ3
        fill('k')