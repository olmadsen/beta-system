Critical: obj 
   go: 
      stop: var boolean
      fool: obj 
         one: 
            print: var boolean
            loop: obj 
               a: var integer
               a := a + 1
               if (a = 97) :then 
                  disable
                  print := 1
               if (print) :then 
                  put(a)
               if (a = 106) :then 
                  enable
                  print := 0
               restart(loop)
         put('A')
         fool.suspend
         put('B')
         one
      coco: obj 
         go: 
            print: var boolean
            Loop: obj 
               i: var integer
               i := i + 1
               if (i = 107) :then 
                  disable
                  print := 1
               if (print) :then 
                  put(i)
               if (i = 116) :then 
                  enable
                  print := 0
                  stop := 1
               restart(loop)
         put('Q')
         coco.suspend
         put('W')
         go
      loopC: obj 
         inx: var integer
         put('x')
         fool.attach(40)
         coco.attach(40)
         put('y')
         if (stop) :then {leave(loopC)}
         inx := inx + 1
         if (inx < 3):then
            restart(loopC)
      fill('u')