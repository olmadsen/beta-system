GenericMethod: obj
    Point(x: var integer, y: var integer): Value
       %id "Point"
       translate(dx: var integer, dy: var integer):
          x := x + dx
          y := y + dy
       inner(Point)
    ColorPoint(c: var integer): Point
       %id "ColorPoint"
       ...
    doit(vP:< Point, p: var vP(0,0)) -> v: var vP(0,0):
        doTranslate -> px: var vP(0,0):
            px := p
            px.translate(2,3)
            v := px
        doTranslate
        inner(doit)
    c1: var ColorPoint(0,0,0)
    c2: var ColorPoint(0,0,0)
    c2 := doit(#ColorPoint,c1){v.c := 9}
