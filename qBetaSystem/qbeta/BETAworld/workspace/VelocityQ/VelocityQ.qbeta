VelocityQ: obj Quantity
   %dimension "v", "Length/Time"
   %requires Length,Time
   %Public
   BaseUnit:: MeterPerSecond;
   MeterPerSecond: Unit
      %unit "MpS", "m*s^-1", "m/s", 1
      %Public
      thisUnit:: MeterPerSecond
      print:: 
         "MpS".print
   x: var MeterPerSecond
   x := 12 MpS
   x.print
   newline
   x := 13 "m*s^-1"
   x.print