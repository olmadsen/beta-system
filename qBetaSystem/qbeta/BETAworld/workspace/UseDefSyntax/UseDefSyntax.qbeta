__UseDefSYntax__
UseDefSyntax: obj
   cstBOBS: 117
   X_BOBS: var integer
   def P_BOBS:
      Y_BOBS: 118
   def PPBOBS: P_BOBS
      Z_BOBS: var float
   def Point: Value
     in X:< var integer
     in Y:< var integer
     def print:<
        put('(')
        putint(X)
        put(',')
        putint(Y)
        inner(Print)
        put(')')
   def D3Point: Point
      in Z:< var integer
      print::<
         put(',')
         putint(Z)
   P1: Point{X:: 11; Y::12}
   P2: var Point{X::13; Y::14}
   C1: var D3Point{X:: 15; Y:: 16; Z:: 17}
   def Vehicle: 
      in def xxx:<  Object
      name: var StringLib.String
      def run:
         in Bing:< var Bus 
         "Vehicle:run::".print 
         newline
         Bing.gogo
      "Vehicle:\n".print
      inner(Vehicle)
   def Car: Vehicle {...}
   def Bus: Vehicle { def gogo: { "Bus.gogo:\n".print }}
   def List:
      in def elm:< Object
   xL1: var List -- a reference 
      %id "xL1"
      elm:: Car
   xL2: var List
      %id "xL2"
      elm:: Car
   singular: Vehicle
       xxx:: Car
       "singular\n".print
   def myCar: Car
      xxx:: Car
   JB: Vehicle
      xxx:: myCar
   "\n ==== UsingDefSyntax ====\n".print
   P1.print
   P2.print
   C1.print
   newline
   xL2 := List{%id "lst"; elm:: Car}
   xL1 := xL2
   singular.name := " Volvo "
   singular.name.print
   JB.name := " VW "
   JB.name.print
   aBus: Bus{xxx::Car}
   JB.run{Bing:: aBus}