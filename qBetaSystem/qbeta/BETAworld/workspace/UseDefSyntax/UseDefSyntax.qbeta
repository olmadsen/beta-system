__UseDefParser__
UseDefSyntax: obj
   cstBOBS: 117
   X_BOBS: var integer
   def P_BOBS:
      Y_BOBS: 118
   def PPBOBS: P_BOBS
      Z_BOBS: var float
   def Point: Value
     in X:< var integer
     in Y:< var integer
     def print:<
        put('(')
        putint(X)
        put(',')
        putint(Y)
        inner(Print)
        put(')')
   def D3Point: Point
      in Z:< var integer
      print::<
         put(',')
         putint(Z)
   P1: Point{X:: 11; Y::12}
   P2: var Point{X::13; Y::14}
   C1: var D3Point{X:: 15; Y:: 16; Z:: 17}
   def Vehicle: 
      name: var StringLib.String
   def Car: Vehicle {...}
   def Bus: Vehicle {...}
   def List:
      def elm:< Object
   xL1: var List -- a reference 
      %id "xL1"
      elm:: Car
   xL2: var List
      %id "xL2"
      elm:: Car

   "UsingDefSyntax".print
   P1.print
   P2.print
   C1.print
   xL2 := List{%id "lst"; elm:: Car}
   xL1 := xL2