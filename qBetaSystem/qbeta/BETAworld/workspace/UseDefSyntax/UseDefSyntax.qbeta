__UsePTNSyntax__
UseDefSyntax: obj
   cstBOBS: 117
   X_BOBS: var integer
   ptn P_BOBS:
      Y_BOBS: 118
   ptn PPBOBS: P_BOBS
      Z_BOBS: var float
   ptn Point: Value
     in X:< var integer
     in Y:< var integer
     ptn print:<
        put('(')
        putint(X)
        put(',')
        putint(Y)
        inner(Print)
        put(')')
   ptn D3Point: Point
      in Z:< var integer
      print::<
         put(',')
         putint(Z)
   P1: Point{X:: 11; Y::12}
   P2: var Point{X::13; Y::14}
   C1: var D3Point{X:: 15; Y:: 16; Z:: 17}
   ptn Vehicle: 
      in ptn xxx:<  Object
      name: var StringLib.String
      ptn run:
         in Bing:< var Bus 
         "Vehicle:run::".print 
         newline
         Bing.gogo
      "Vehicle:\n".print
      inner(Vehicle)
   ptn Car: Vehicle {...}
   ptn Bus: Vehicle { ptn gogo: { "Bus.gogo:\n".print }}
   ptn List:
      in ptn elm:< Object
   xL1: var List -- a reference 
      %id "xL1"
      elm:: Car
   xL2: var List
      %id "xL2"
      elm:: Car
   singular: Vehicle
       xxx:: Car
       "singular\n".print
   ptn myCar: Car
      xxx:: Car
   JB: Vehicle
      xxx:: myCar
   "\n ==== UsingDefSyntax ====\n".print
   put('Q')
   P1.print
   put('W')
   P2.print
   C1.print
   newline
   xL2 := List{%id "lst"; elm:: Car}
   xL1 := xL2
   singular.name := " Volvo "
   singular.name.print
   JB.name := " VW "
   JB.name.print
   aBus: Bus{xxx::Car}
   JB.run{Bing:: aBus}