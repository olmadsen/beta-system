__UseDefSyntax__
ArmTest: obj
   def Record:
       ch: var Char
       ch := '!'
   def ArmFoo:
      in armX:< var integer
      in armR:< var Record
      in armY:< var integer
      out armZ: var integer
      put(armX)
      put(armY)
      put(armR.ch)
   def ArmFooX: ArmFoo
      armX:: 100
   R: var Record
   R := Record
   R.ch := 'c'
   ArmFoo
      armX:: 97
      armR :: R
      armY:: 98
   ArmFooX
      armY:: 101
      armR :: Record
      


