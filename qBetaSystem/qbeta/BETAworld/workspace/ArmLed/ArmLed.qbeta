ArmLed: obj 
   pinMode: 
      %external 1
      in pn: var integer
      in mode: var Boolean
   digitalWrite:  -- external function
      %external 2
      in pn: var integer
      in state: var Boolean
   foo: 
      in i: var integer
      i := i * i
   delay: 
      in t: var integer
      t := t - 1
      if (0 < t) :then
         ...
   onCore1: obj 
      %core
      put('[')
      this(onCore1).suspend
      put(']')
      --"Core1 blinking led:\n".print
      pinMode(4,1)
      blink: do
         V: var integer       
         digitalWrite(4,0) -- set the led on pin 4
         digitalWrite(4,1)
         put('1')
         restart(blink)
      "blink:end\n".print
   onCore2: obj 
      %core
      put('<')
      this(onCore2).suspend
      put('>')
      run: do
         put('2')
         restart(run)
   onCore3: obj 
      %core
      loop: do 
         this(onCore3).suspend
         put('3')
         restart(loop)
   Report: 
      delay(1000)
      "Core0 is still here\n".print
      restart(Report)
   "ArmLed is here on core0:\n".print
   fork(onCore1)
   put('$')
   --"after fork(onCore1)\n".print
   fork(onCore2)
   --fork(onCore3)
   put('*')
   --delay(10000)
   --Report
   wait: do
      restart(wait)
   