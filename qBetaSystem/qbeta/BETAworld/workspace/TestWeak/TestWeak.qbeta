__UseDefSyntax__
TestWeak: obj
   def Vehicle:
      %globals
      brand: var StringLib.String
   def Car: Vehicle {owner: var StringLib.String}
   def Bus: Vehicle { noOfPassengers: var integer }
   def Collection:
      in def ElmType:< Object
      def insert:<
          in elm:< var ElmType
          inner(insert)
      get:
         out elm: var ElmType
   def Set: Collection
        ...
   sv1: var Collection{ElmType::< Vehicle}
   sv2: var Collection{ElmType:: Vehicle}
   sv3: var Collection{ElmType::< Car}
   sv4: var Collection{ElmType:: Car}
   sb1: var Set{ElmType::< Vehicle}
   sb2: var Set{ElmType:: Vehicle}
   sb3: var Set{ElmType::< Car}
   sb4: var Set{ElmType:: Car}

 
   sb3 := sb1 
   sb4 := sb1 -- should not work
   sb4 := sb2 -- should not work