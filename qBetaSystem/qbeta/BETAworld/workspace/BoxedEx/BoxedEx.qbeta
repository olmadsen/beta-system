BoxedEx: obj 
   %visible Collections.SetLib
   S: obj Set(#Integer) -- 2
   V: var Integer       -- 3
   B: var Boolean       -- 4
   Point: Value
      x: var integer
      y: var integer
   mkIntB:
      out W: var integer
      W := 119
   P1: var Point         -- 5
   P2: var Point         -- 7
   --putint(mkIntB)
   --V := 116
   --P1 := Point
   --P2 := P1
   B := P1 = P2
   --put('%')
   --B := P1 <= P2
   put('/')
   B := P1 = Point
   ...
   --put('&')
   --S.insert(V)
   --S.insert(117)
   S.scan
      W: var integer
      W := current
      putint(W)
