__UseDefSyntax__
WeakQuaCases: obj
   def Vehicle:
      %globals
      brand: var StringLib.String
   def Car: Vehicle {owner: var StringLib.String}
   def Bus: Vehicle { noOfPassengers: var integer }
   def Collection:
      in def ElmType:< Object
      def insert:<
          in elm:< var ElmType
          inner(insert)
      get:
         out elm: var ElmType
   def Set: Collection
        ...
   sv1: var Collection{ElmType::< Vehicle}
   sv2: var Collection{ElmType:: Vehicle}
   sv3: var Collection{ElmType::< Car}
   sv4: var Collection{ElmType:: Car}
   sb1: var Set{ElmType::< Vehicle}
   sb2: var Set{ElmType:: Vehicle}
   sb3: var Set{ElmType::< Car}
   sb4: var Set{ElmType:: Car}
   sv1 := sv2
   sv1 := sv3
   sv1 := sv4
   sv1 := sb1
   sv1 := sb2
   sv1 := sb3
   sv1 := sb4
   --sv4 := sv1 -- illegal
   --sb4 := sv1 -- illegal
   --sb4 := sv2 -- illegal
   --sb4 := sv3 -- sb4.qua = Set, not sub of sv3.qua = Collection; but run-time qua check?
   --sb4 := sv4 -- same
   sb1 := sb2
   sb1 := sb3
   sb1 := sb4
   sb2 := sb1
   sb2 := sb3
   sb2 := sb4
   --sb3 := sb1 -- illegal
   --sb3 := sb2 -- illegal
   sb3 := sb4
   --sb4 := sb1 -- illegal
   --sb4 := sb2 -- illegal
   sb4 := sb3 
   "\n---- WeakQuaCases ----".print
