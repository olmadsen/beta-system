ArmIO: obj
   printer.putItem("ArmIO\n")
   printer.putItem("Hello world\n")
   --printer.emit
   "----\n".print
   emitter: obj
      msg: var String
      emitter.suspend
      msg := printer.getItem
      if (msg = "") :then
         "emitter:none\n".print
      :else
         msg.scan
            L: do
               if (UART.isReady) :then
                   UART.putCh(current)
               :else
                  put('?')
                  this(emitter).suspend
                  restart(L)
         restart(emitter)
   for (1):to(42):repeat
      emitter.call
   UART: obj
      isReady:
         out B: var Boolean
         B := UART_isReady
         B := false
         if (v = 0) :then
            B := true
         :else
            v := v - 1
      putCh:
         in ch: var char
         put(ch)
         v := 2
      v: var integer
   UART_isReady:
      %basic 24
      out B: var Boolean
   Monitor:
      entry:
         mutex.get
         inner(entry)
         mutex.free
      mutex: obj LockLib.Lock("Mutex")
   printer: obj Monitor
      putItem: entry
         in msg: var String
         msgQ.insert(msg)
      getItem:
         out msg: var String
         if (! msgQ.isEmpty):then
            msg := msgQ.extract
      emit:
         msg: var String
         msgQ.scan 
            current.print
         msg := msgQ.extract
         msg.print
         msg := msgQ.extract
         msg.print
         msg := msgQ.extract
         if (msg == none) :then
            "empty\n".print
      msgQ: obj Collections.OrderedList.OrderedList(#String)
     