ArmIO: obj SimpleIOLib.SimpleIOSystem
   -- Specific code for ARM 
   UART_writerReady:
      %basic 24
      out B: var Boolean
   UART_readerReady:
      %basic 25
      out B: var Boolean
   UART_writer: obj Writer
      writerReady::
         B := UART_writerReady
      write::
         put(ch)
   UART_Reader: obj Reader("UART_reader")
      readerReady::
         B := UART_readerReady
      read::
         ch := _get
   P1: obj Process("P1")
      screen.putItem("Hello world!\n")
      screen.putItem("How are you?\n")
   P2: obj Process("P2")
      screen.putItem("Merry Christmas\n")
   P3: obj Process("P3")
      loop: do
         line: var string
         wait: do   
            line := keyboard.read
            if (line = "") :then
               P3.suspend
               sleep(10)
               restart(wait)
            screen.putItem(">>>" + line + "\n")
         restart(loop)
   "ArmIO\n".print
