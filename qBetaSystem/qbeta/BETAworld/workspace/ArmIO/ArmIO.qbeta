ArmIO: obj SimpleIOLib.SimpleIOSystem
   -- Specific code for ARM 
   UART_isReady:
      %basic 24
      out B: var Boolean
   UART_read_isReady:
      %basic 25
      out B: var Boolean
   anWriter: obj Writer
      writerReady::
         B := UART.writerReady
      write::
         UART.putCh(ch)
   aReader: obj Reader("UART_reader")
      readerReady::
         B := UART.readerReady
      read::
         ch := UART.read
   UART: obj
      writerReady:
         out B: var Boolean
         B := UART_isReady
      putCh:
         in ch: var char
         put(ch)
      readerReady:
         out B: var Boolean
         B := UART_read_isReady
      read:
         out ch: var Char
         ch := _get
      
   P1: obj Process("P1")
      screen.putItem("Hello world!\n")
      screen.putItem("How are you?\n")
   P2: obj Process("P2")
      screen.putItem("Merry Christmas\n")
   P3: obj Process("P3")
      loop: do
         line: var string
         wait: do   
            line := keyboard.read
            if (line = "") :then
               P3.suspend
               sleep(10)
               restart(wait)
            screen.putItem(">>>" + line + "\n")
         restart(loop)
   "ArmIO\n".print
