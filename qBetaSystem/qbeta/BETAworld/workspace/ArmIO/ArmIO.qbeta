ArmIO: obj SimpleIOLib.SimpleIOSystem
   -- Specific code for ARM 
   UART_isReady:
      %basic 24
      out B: var Boolean
   UART_read_isReady:
      %basic 25
      out B: var Boolean
   anEmitter: obj Emitter
      isReady::
         B := UART.isReady
      emit::
         UART.putCh(ch)
   UART: obj
      isReady:
         out B: var Boolean
         B := UART_isReady
      putCh:
         in ch: var char
         put(ch)
   P1: obj Process
      printer.putItem("ArmIO\n")
      printer.putItem("Hello world\n")
   P2: obj Process
      printer.putItem("Merry Christmas\n")
   "ArmIO\n".print
