ParamEx: obj
   Record:
      in n: var char
   a: var integer
   b: var integer
   c: var integer
   d: var integer
   e: var integer
   f: var integer
   rq: ref Record
   ws: ref StringLib.String
   foo:
      in x: var integer
      in r: ref Record
      in s: var StringLib.String
      in y: var integer
      out z: var integer
      z := x + y
   tmpFoo:
      x: var integer
      a := foo(b,rq,ws,foo(d,rq,ws,x))
   func1:
      in xx1: var integer
      in yy1: var integer
      in zz1: var integer
      in vv1: var integer
      out ww1: var integer
      ww1 := xx1 + yy1 + zz1 + vv1
   func2:
      in xx2: var integer
      in yy2: var integer
      out ww2: var integer
      ww2 := xx2 + yy2
   func3:
      in xx3: var integer
      in yy3: var integer
      in zz3: var integer
      out ww3: var integer
      ww3 := xx3 + yy3 + zz3
   func4:
      in xx4: var integer
      in yy4: var integer 
      out ww4: var integer
      ww4 := xx4 + yy4
   tmpFunc:
      Q: var integer
      Q := func1(a,b, \
                     func2(c,d), \
                                 func3(e,f, \
                                            func4(117,118)))
   ...
   --foo(e1,e2,     bar(e3,e4),     fisk(e5,e6,     snorf(e7,e8)))
   a := 90
   d := 1
   a := a + b
   a := a + b * c
   a := foo(b,rq,ws,c)
   tmpFoo
   tmpFunc
   ...
   --a := a + b * foo(a,rq,ws)
   --a := a * b /% (foo(d,e) + f)