MarkEx: obj
    Point: Value
      %ID "Point"
      in x: var integer
      in y: var integer
    SomeThing: 
       %ID "SomeThing"
       q: var 117
       p: val Point(10,11)
    SuperMark:
       %id "SuperMark"
       inner(SuperMark)
    SubMark: SuperMark
       "Mark:".print
       this(SubMark).suspend
       "II:".print
    S: ref SuperMark
    P: var Point(3,4)
    X: obj SomeThing
    "MarkEx\n".print
    S := SubMark
    S.call
    L: do
       gogo:
          "gogo\n".print
       "in do\n".print
    --L.gogo

