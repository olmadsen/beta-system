tinyB: obj
   X:
      Pb:
         koks:<
            "koks".print
            inner(koks)
         inner(Pb)

   W:
      R2: obj
          R3: ref X
          R3 := X
   Aobj: obj
      Q: 
         P:
            kuk:<
               "kuk".print
               inner(kuk)
            inner(P)
      R1: ref W
      AAobj: obj
         R: ref Q
         AAAobj: obj
            DD: R.P
               kuk::<
                 ":kuk. ".print
               inner(DD)
            EE: R1.R2.R3.Pb
               koks::<
                  ":koks".print
               inner(EE)
            AAAAobj: obj
               D : DD
                  ...
                  kuk
               E: EE
                  koks
               R := Q
               R1 := W
               D
               E
   Aobj.AAobj.AAAobj.AAAAobj.E
   
   
      


   
  

