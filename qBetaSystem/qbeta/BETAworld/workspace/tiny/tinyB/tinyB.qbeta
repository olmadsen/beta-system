tinyB: obj
   onStack:
      out top: var integer
      top := markHeap(top)
      inner(onStack)
      top = markHeap(top)
   fool: onStack
      for(1):to(10):repeat
         putint(inx)
         put(' ')
   Point: Value
      in x: var integer
      in y: var integer
   move:
      in pp: var Point(0,0)
      ...
   P1: var Point(0,0)
   P2: var Point(0,0)
   v: var Integer
   P1 := Point(3,4)
   P2 := P1
   move(P1)
   move(Point(8,9))
   --Point(111,112)
   v := markHeap(0);
   --putint(v)
   --newline
   v := fool
   newline
   putint(v)

   

   
   
      


   
  

