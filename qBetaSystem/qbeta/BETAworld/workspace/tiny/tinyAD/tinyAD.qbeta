tinyAD: obj
   Record:
      in id:< var StringLib.String
   Vehicle: 
      in xxx:< ref Record
      name: var StringLib.String
      go:
         xxx.id.print
      run:
         in Bing: ref Bus
         "Run:".print
         Bing.gogo
   Car: Vehicle {...}
   Bus: Vehicle {gogo: { "Go".print }}
   X: obj Record("AAA")
   myCar: obj Car  -- off: 2
      xxx:: X
   JB: obj Vehicle -- off: 3
      xxx:: X
   aBus: obj Bus{xxx:: X}; -- off :4
   put('!')
   JB.go
   put('&')
   JB.run{Bing:: aBus}