tinyE: obj
   Record:
      in tinyFoo: var integer
      tinyBar: var integer
   MySuper:
      VVV:< Object
      entity:
         in key: ref VVV
      Predicate:
         in theSubject: ref entity
         inner(Predicate)
      forALL:
         in pred:< Predicate
         pred(XXX)
      XXX: obj entity(Record(117))
      inner(MySuper)
   MySub: MySuper
      VVV::< Record
      inner(MySub)
   MMM: obj MySub
        forAll(theSubject.key.tinyFoo)
   MMM.forAll(theSubject.key.tinyBar)

   