tinyE: obj
   Record:
      in tinyFoo: var integer
      tinyBar: var integer
      tinyFisk: var integer
   MySuper:
      VVV:< Object
      entity:
         in key: ref VVV
      Predicate:
         in theSubject: ref entity
         inner(Predicate)
      forALL(pred:< Predicate): 
         out B: var Boolean
         pred(XXX)
      XXX: obj entity(Record(117))
      inner(MySuper)
   MySub: MySuper
      VVV::< Record
      inner(MySub)
   MMM: obj MySub
        %ID "MMM"
        forAll(theSubject.key.tinyFoo)
   doMMX:
      MMX: ref MySub
      goMMX:
         MMX := MySub
         MMX.forAll(theSubject.key.tinyFisk)
      goMMX
   MMM.forAll(theSubject.key.tinyBar)
   BBB: var Boolean
   if (MMM.forAll(theSubject.key.tinyBar)) :then
       ...
   doMMX
   