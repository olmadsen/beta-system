__UseDefSyntax__
tinyC: obj
   def put$:
      in vl:< var integer
      in at:< var integer
      "putA:".print
   def put$:
      in vlx:< var integer
      in atx:< var integer
      in def exe:< Object
      "putB:".print
      exe
   put{vl:: 15; at:: 8}   
   put
      vlx:: 15
      atx:: 8
      exe:: 
         "GO:".print
   put{vlx:: 15; atx:: 8; exe:: {"GO:".print}}

     

     
     