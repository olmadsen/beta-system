tinyAB: obj
   Point: Value
      in X:< var integer
      in Y:< var integer
      print:
         putint(X)
         put(',')
         putint(Y)
         newline
   P1: var Point(12,13)
   --P2: var Point(7,8)
   --  z: var integer
   P3: var Point
      X:: 117
      Y:: 118
   P4: var Point
      X:: 101
      Y:: 102
   P1.print
   P3.print
   P4.print
   P3 := P4
   P3.print
   