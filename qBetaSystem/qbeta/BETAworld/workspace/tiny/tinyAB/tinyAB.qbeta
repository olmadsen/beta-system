tinyAB: obj
   Vehicle: 
      name: var StringLib.String
   Car: Vehicle {...}
   Bus: Vehicle {...}
   
   A1:
      %id A1
      V:< Vehicle
   A2: A1
      %id A2 
   A3: A2
      %id A3
   A4: A3
      %id A4
      V::< Car
   B3: A1
      %id "B3" 
   B4: B3
      %id "B4"
      V::< Car
   R1: ref A4
   R2: ref B4

   Point: Value
      in X:< var integer
      in Y:< var integer
      print:
         putint(X)
         put(',')
         putint(Y)
         newline
   Line: Value
      start: var Point(0,0)
      end: var Point(8,9)
      seg: Value
         v:< var integer
      z:< var integer
      s1: var seg
         v:: 11
      s2: var seg
         v:: 12
      s1 := s2
      start := end
   P1: var Point(12,13)
   --P2: var Point(7,8)
   --  z: var integer
   P3: var Point
      X:: 117
      Y:: 118
   P4: var Point
      X:: 101
      Y:: 102
   L1: var Line
      z:: 200
   L2: var Line
      z:: 100
   P1.print
   P3.print
   P4.print
   P3 := P4
   P3.print
   R1 := R2
   L1 := L2
