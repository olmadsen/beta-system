tinyAB: obj
   Vehicle: 
      in xxx:< ref Car
      name: var StringLib.String
      run:
         in Bing: ref Bus
         "Run:".print
         Bing.gogo
   Car: Vehicle {...}
   Bus: Vehicle {gogo: { "Go".print }}
   
   A1:
      %id A1
      V:< Vehicle
      "\nA1\n:".print
      inner(A1)
   A2: A1
      %id A2 
   A3: A2
      %id A3
   A4: A3
      %id A4
      V::< Car
   B3: A1
      %id "B3" 
   B4: B3
      %id "B4"
      V::< Car
   R1: ref A4
   R2: ref B4

   Point: Value
      in X:< var integer
      in Y:< var integer
      print:
         putint(X)
         put(',')
         putint(Y)
         newline
   Line: Value
      start: var Point(0,0)
      end: var Point(8,9)
      seg: Value
         v:< var integer
      z:< var integer
      --s1: var seg
      --   v:: 11
      --s2: var seg
      --   v:: 12
      --s1 := s2
      start := end
   P1: var Point(12,13)
   --P2: var Point(7,8)
   --  z: var integer
   P3: var Point
      X:: 117
      Y:: 118
   P4: var Point
      X:: 101
      Y:: 102
   L1: var Line
      z:: 200
   L2: var Line
      z:: 100
   QWE: A1
      GO:
         "GO".print
      "QWE:".print
   "\n---tinyAB---\n".print
   P1.print
   P3.print
   P4.print
   P3 := P4
   P3.print
   R1 := R2
   L1 := L2
   QWE.go
   myCar: obj Car
      xxx:: Car{xxx:: myCar}
   JB: obj Vehicle
      xxx:: myCar
      --m: var integer
   aBus: obj Bus{xxx:: Car{xxx:: myCar}};
   put('!')
   JB.run{Bing:: aBus}
