tinyP: obj
   MyClass:
      +++:
         in v: ref MyClass
         out R: ref MyClass
         ...
      ++%:
         in v: ref MyClass
         out R: ref MyClass
         ...
      ++&:
         in v: ref MyClass
         out R: ref MyClass
         ...
   A: ref MyClass
   X: obj MyClass
   X1: ref MyClass
   X2: ref MyClass
   X3: ref MyClass
   X4: ref MyClass
   A := X +++ x1 ++% x2 +++ x3 ++& x4
             