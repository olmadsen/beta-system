tinyY: obj
    Point: Value
       in x: var integer
       in y: var integer
       next:
          in d: var integer
          out p: var Point(0,0)
          p.x := x + d
          p.y := y + d 
       print:
          put('(')
          putint(x)
          put(',')
          putint(y)
          put(')')
    p1: var Point(3,4)
    p2: var Point(0,0)
    p1.print
    newline
    p2 := p1.next(5)
    p2.print
    B: var Boolean
    B := p2 = Point(8,9)
    if (B) :then
       \n"Yes".print
    if (p2 = Point(8,9)) :then
       "\nOK".print

  
   
  
     