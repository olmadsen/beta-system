tinyG: obj
   foo:
      in x:< var integer
      in ybobs:< var integer
      inner(foo)
   bar: foo
       in z:< var integer
       "x:".print; putint(x)
       " ybobs:".print; putint(ybobs)
       " z:".print; putint(z)
       newline
       inner(bar)
   snorf: bar
       ybobs :: 117
       local:
          ": local:ybobs:".print
          putint(ybobs)
       "x:".print; putint(x)
       " ybobs:".print; putint(ybobs)
       " z:".print; putint(z)
       local
       newline
   putItXXX: 
       in v:< var integer
       in at:< var integer
       in exe:< Object
       "put:v:".print; putint(v)
       " at:".print; putint(at)
       exe
       newline
   nestA:
        nestB: bar
          putint(ybobs)
        nestB{x:: 7; ybobs:: 8; z:: 9}
   "*** bar:\n".print
   bar{ x:: 11; ybobs:: 12; z:: 13 }  
   "*** snorf:\n".print
   snorf{ x:: 21; z:: 22 }
   "*** putIt:\n".print
   putItXXX{ v:: 31; at:: 32; exe:: {": done".print}} 
   "*** nestA:\n".print
   nestA
   StringGo:
        S1: var StringLib.String
        S1 := "Hello"
        if (S1 = "HeLlo") :then 
           put('?') 
        :else 
           put('u')
        if (S1 = "Hello") :then 
           put('v') 
        :else 
           put('?')
   StringGo