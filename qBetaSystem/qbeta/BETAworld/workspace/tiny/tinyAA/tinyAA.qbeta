tinyAA: obj
   %visible Collections
   mapKoks:
      Domain:< Object
      Entry:
         theDomain: ref Domain
      BooleanInner:
         %inner
         in ptn: ref Object
         out Bb: var Boolean
      Predicate:
         in theSubject: ref Entry; 
         out By: var Boolean
         By := BooleanInner(#Predicate)
      fool:
         in pred:< Predicate
         out BBB: var Boolean
         BBB := pred(Entry)
      inner(mapKoks)
   mapBobs: mapKoks
      domain::
         kuk: var Boolean
   MB: obj mapBobs
   MB.fool(theSubject.theDomain.kuk) && false



