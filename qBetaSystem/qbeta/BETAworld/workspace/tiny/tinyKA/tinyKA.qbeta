tinyKA: obj 
      %requires Collections,MapLib,SetLib
      %visible Collections
      Period:
         ...  
      Expert: 
         ...
      Experts: SetLib.Set(#Expert)
         ... 
      Schedule: MapLib.Map(#Period,#Experts)	 
         ...
      theSchedule: ref Schedule
      PlantInvA:
          out B: var Boolean
          B := theSchedule.forAll({E.theRange.isEmpty }) && true
      put('Q')