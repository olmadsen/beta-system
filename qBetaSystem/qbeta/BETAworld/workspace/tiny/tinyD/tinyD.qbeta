tinyD: obj
   %visible Collections
   %requires MapLib
   Date:
         in year: var integer
         print:
           "date:".print
           putint(year)
   M: obj MapLib.Map(#String,#Date)
   M.add("Olsen",Date(117))
   if (M.forAllII({ theSubject.theRange.year > 116})) :then
          "Age > 16 for all\n".print
   :else
          "Age pred not satisfied\n".print