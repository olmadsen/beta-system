SimpleIOex: obj SimpleIOLib.SimpleIOSystem
   _kbhit:
      %basic 26
      out B: var integer
   getch:
      %basic 27
      out ch: var Char
   anEmitter: obj Emitter
      isReady::
         if (v = 0) :then
            B := true
         :else
            v := v - 1
      emit::
         put(ch)
         v := 2
      v: var integer
      v := 2
   aReader: obj reader("aReader")
      readerReady::
         B := _kbhit
      read::
         ch := getch;
         put(ch)
   P1: obj Process("P1")
      printer.putItem("ArmIO\n")
      --printer.putItem("Hello world\n")
   P2: obj Process("P2")
      ...
      --printer.putItem("Merry Christmas\n")
   P3: obj Process("P3")
      loop: do
         line: var string
         wait: do   
            line := keyboard.read
            if (line = "") :then
               P3.suspend
               sleep(10)
               restart(wait)
            printer.putItem(">>>" + line + "\n")
         restart(loop)
   "SimpleIOex\n".print

