SimpleIOex: obj SimpleIOLib.SimpleIOSystem
   _kbhit:
      %basic 26
      out B: var integer
   getch:
      %basic 27
      out ch: var Char
   anEmitter: obj Emitter
      isReady::
         B := UART.isReady
      emit::
         UART.putCh(ch)
   UART: obj
      isReady:
         out B: var Boolean
         if (v = 0) :then
            B := true
         :else
            v := v - 1
      putCh:
         in ch: var char
         put(ch)
         v := 2
      v: var integer
      v := 2
   aReader: obj reader("aReader")
      readerReady::
         B := _kbhit
         --putint(B)
         --if (B) :then
         --   put('T')
         --:else
         --   put('F')
      read::
         ch := getch;
         --put('/')
         put(ch)
         --newline
   P1: obj Process("P1")
      printer.putItem("ArmIO\n")
      --printer.putItem("Hello world\n")
   P2: obj Process("P2")
      ...
      --printer.putItem("Merry Christmas\n")
   P3: obj Process("P3")
      loop: do
         line: var string
         wait: do   
            line := keyboard.read
            if (line = "") :then
               P3.suspend
               --put('&')
               restart(wait)
            printer.putItem(">::" + line)
         restart(loop)
   "SimpleIOex\n".print