SimpleIOex: obj SimpleIOLib.SimpleIOSystem
   _kbhit:
      %basic 26
      out B: var integer
   getch:
      %basic 27
      out ch: var Char
   aWriter: obj Writer
      writerReady::
         if (v = 0) :then
            B := true
         :else
            v := v - 1
      write::
         put(ch)
         v := 2
      v: var integer
      v := 2
   aReader: obj reader("aReader")
      readerReady::
         B := _kbhit
      read::
         ch := getch;
         put(ch)
   P1: obj Process("P1")
      screen.putItem("Hello world!\n")
      screen.putItem("How are you?\n")
   P2: obj Process("P2")
      screen.putItem("Merry Christmas\n")
   P3: obj Process("P3")
      loop: do
         line: var string
         wait: do   
            line := keyboard.read
            if (line = "") :then
               P3.suspend
               sleep(10)
               restart(wait)
            screen.putItem(">>>" + line + "\n")
         restart(loop)
   "SimpleIOex\n".print

