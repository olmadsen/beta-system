SimpleIOex: obj SimpleIOLib.SimpleIOSystem
   anEmitter: obj Emitter
      isReady::
         B := UART.isReady
      emit::
         UART.putCh(ch)
   UART: obj
      isReady:
         out B: var Boolean
         if (v = 0) :then
            B := true
         :else
            v := v - 1
      putCh:
         in ch: var char
         put(ch)
         v := 2
      v: var integer
   P1: obj Process
      printer.putItem("ArmIO\n")
      printer.putItem("Hello world\n")
   P2: obj Process
      printer.putItem("Merry Christmas\n")
   "SimpleIOex\n".print