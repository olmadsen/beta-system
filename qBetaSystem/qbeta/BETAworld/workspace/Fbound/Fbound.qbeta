__UseDefSyntax__
Fbound: obj
   -- Examples from the ECOOP'99 paper by Kresten Krab Thorup & Mads Torgersen
   -- Unifying Genericity - Combining the Benefits of Virtual Types and Parameterized Classes
   def Ordered:
      %id "Ordered"
      def S:< Object
      def leq:<
         in o:< var S
         out b: var Boolean
         "Ordered:leq:".print
         inner (leq)
   def Point: Ordered
        S:: Point
        in x: var integer
        in y: var integer
        leq::
           "Point:leq:\n".print
           b := (x <= o.x) && (y <= o.y)
        def print:
           putint(x)
           put(',')
           putint(y)
           newline
   def Cowboy: Ordered
        in name: var StringLib.String
        S:: Cowboy
        leq::
           "Cowboy:leq:\n".print
           b := name = o.name
        def print:
           ("Cowboy: " + name + "\n").print
   def Comparator:
      %id "Comparator"
      def M:< Ordered{S:: M} -- missing Ordered(M)
      def Compare:
         in e:< var M;
         in f:< var M;
         out b: var Boolean;
         b := e.leq(f)  -- f is type ordered, 'e.o' is of type S:< object,
         -- but covariant in the sense that S may be bound to arbitrary patterns
   cp: Comparator{M:: Point}
   cc: Comparator{M:: Cowboy}
   p1: Point{x:: 10; y:: 12}
   p2: Point(10,12)
   c1: Cowboy("Jesse James")
   c2: Cowboy("Jesse James")
   "\n**** Fbound ****\n".print
   p1.print
   p2.print
   if (cp.compare(p1,p2)) :then { "Point:equal\n\n".print }
   c1.print
   c2.print
   if (cc.compare(c1,c2)) :then { "Cowboy:equal\n".print }
   --if (cp.compare(p1,c2)) :then { "Point=Cowboy:equal\n".print }
