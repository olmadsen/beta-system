__UseDefParser__
KrestenMadsWeakQuaEx: obj
   -- Examples from the ECOOP'99 paper by Kresten Krab Thorup & Mads Torgersen
   -- Unifying Genericity 
   -- - Combining the Benefits of Virtual Types and Parameterized Classes
   def Ordered:
      def S:< Object
      def leq:<
         in o:< var S
         out b: var Boolean
         "Ordered:leq:\n".print
         inner (leq)
  
   def Point: Ordered
        S:: Point
        in x: var integer
        in y: var integer
        leq::
           "Point:leq:\n".print
           b := (x <= o.x) && (y <= o.y)
        def print:
           putint(x)
           put(',')
           putint(y)
           newline
   def Cowboy: Ordered
        in name: var StringLib.String
        S:: Cowboy
        leq::
           "Cowboy:leq:\n".print
           b := name = o.name
        def print:
           ("Cowboy: " + name + "\n").print
   def Comparator:
      def M:< Ordered -- missing Ordered(M)
      def Compare:
         in e:< var M;
         in f:< var M;
         out b: var Boolean;
         b := e.leq(f)
   cp: Comparator{M:: Point}
   p1: Point{x:: 10; y:: 12}
   p2: Point{x:: 10; y:: 12}
   c1: Cowboy("Jesse James")
   c2: Cowboy("Jesse James")

   def Vehicle:
      %globals
      brand: var StringLib.String
   def Car: Vehicle {owner: var StringLib.String}
   def Bus: Vehicle { noOfPassengers: var integer }
   def Collection:
      in def ElmType:< Object
      def insert:<
          in elm:< var ElmType
          inner(insert)
      get:
         out elm: var ElmType
   def Set: Collection
        ...
   def SimpleSet: Set
       insert::<
          ...
   def HashedSet: Set
        insert::<
           ...
   vc: var Collection{ElmType::< Vehicle}
   vss: var SimpleSet{ElmType::< Vehicle} -- not compatible with HashedSet{ElmType:: Vehicle}
                                          -- because of different insert methods, so no 
                                          -- vss:= HashedSet{ElmType:: Vehicle}
   vs: var Set{ElmType::< Vehicle}
   vsB1: var Set{ElmType::< Bus}
   vsB2: var Set{ElmType:: Bus}
   vs := HashedSet{ElmType:: Vehicle}
   v: var Vehicle
   vc := vs
   v := vc.get
   vsB1 := vsB2  -- 
   -- vsB1.insert(SubOfBus) is legal, but also legal in vsB2
   vsB2 := vsB1
   "KrestenMadsWeakQuaEx:\n".print
   p1.print
   p2.print
   if (cp.compare(p1,p2)) :then { "equal".print }
   c1.print
   c2.print
   if (cp.compare(c1,c2)) :then { "Cowboy:equal\n".print }
   if (cp.compare(p1,c2)) :then { "Point=Cowboy:equal\n".print }
