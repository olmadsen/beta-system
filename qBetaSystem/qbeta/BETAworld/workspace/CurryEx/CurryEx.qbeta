CurryEx: obj
   func:
      x:< var integer
      y:< var integer
      out z: var integer
      z := x + y
   CfuncI: func(3)
      ...
   CfuncII: func
      x:: 3
      ...
   V: var integer
   "CurryEx\n".print
   V := func(3,8)
   putint(V)
   newline
   CfuncI(8)
   CfuncII
      y:: 8