CurryEx: obj
   func:
      %virtualParams
      x:< var integer
      y:< var integer
      out z: var integer
      z := x + y
   CfuncI: func(3)
      ...
   CfuncII: func
      x::< 3
      ...
   cFuncIII: CfuncII
      x :: 13
   V: var integer
   "CurryEx\n".print
