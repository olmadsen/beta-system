__UsePTNSyntax__
CurryEx: obj
   ptn func:
      %virtualParams
      in x:< var integer
      in y:< var integer
      out z: var integer
      z := x + y
   ptn  CfuncI: func(3)
      ...
   ptn CfuncII: func
      x:: 3   -- further binding does not work
      ...
   ptn cFuncIII: CfuncII
      x :: 13  -- does this actually work? I.e. is y=8 or y=99?
   V: var integer
   "CurryEx\n".print
   --V := func(3,8)
   --putint(V)
   --newline 
   CfuncII
      y:: 8
   "CfuncIII:".print
   V := cFuncIII
      Y:: 99
   putint(V)
   --cFuncIII
   --   %virtualParams
   --   ...