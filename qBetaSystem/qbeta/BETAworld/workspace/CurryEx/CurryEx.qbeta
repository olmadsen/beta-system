CurryEx: obj
   func:
      %virtualParams
      x:< var integer
      y:< var integer
      out z: var integer
      z := x + y
   CfuncI: func(3)
      ...
   CfuncII: func
      x::< 3
      ...
   cFuncIII: CfuncII
      x :: 13  -- does this actually work? I.e. is y=8 or y=99?
   V: var integer
   "CurryEx\n".print
   --V := func(3,8)
   --putint(V)
   --newline 
   CfuncII
      y:: 8
   "CfuncIII:".print
   V := cFuncIII
      Y:: 99
   putint(V)
