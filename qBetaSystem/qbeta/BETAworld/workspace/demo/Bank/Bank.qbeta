__UseDefSYntax__
Bank: obj 
   %visible StringLib, DK.AarhusUniversity.PersonLib
   -- Declaration of Account pattern
   def Account:
      in id:< var String
      %Public
      interestRate: 3
      balance: var integer -- The balance of this Account
      owner: var Person
      def deposit:
         in amount:< var integer
         balance := balance + amount
      def withdraw:
         in amount:< var integer 
         balance := balance - amount
      def addInterest:
          balance := balance + (balance * interestRate) // 100
      def display: 
         id.print
         put(':')
         putint(balance)
         put(10)
   -- Declaration of Account objects
   Joe: Account("Joe") -- A const ref to An Account object
   Mary: var Account -- A var ref to an Acoount object
   Mary := Account("Mary")
   Joe.deposit(500)
   Mary.deposit(300)
   Joe.display
   Mary.display
   Mary := Joe
   mary.addInterest
   Mary.display