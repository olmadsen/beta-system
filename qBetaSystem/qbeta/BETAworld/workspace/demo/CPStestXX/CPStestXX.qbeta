CPStestXX: obj 
   SetX:
      elm:< Object
      exists:
         in pred:<
            x: ref elm
            inner(pred)
         inner(exists)
   MapX:
      Domain:< Object
      Range:< Object
      entry:
         in theDomain: ref Domain
         in theRange: ref Range
      forAll:
         in pred:<
            in E: ref Entry
            inner(pred)
         inner(forAll)
      inner(MapX)
   Qualification:
      ...
   Qualifications: SetX
      elm:: Qualification
      ...
   Expert:
      in name: ref StringLib.String   
      in quali: ref Qualifications
   Experts: SetX
      elm:: Expert
      ... 
   Period:
      ... 
   --Schedule: MapLib.Map(#Period,#Experts)
   --   forall({E.theRange.exists(x.quali)})
   --Sc: ref Schedule
   --Sc.forall({E.theRange.exists(x.quali.has(none))})
   SCH: MapX
      Domain:: Period
      Range:: Experts
      forall({E.theRange.exists(x.quali)})
