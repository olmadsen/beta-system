__UseDefSyntax__
MonitorDemo: obj LIB.MonitorSystemLib.MonitorSystem
   %requires MonitorSystemLib
   %include LIB.StringLib
   P1: MonitorProcess("PP1")
      def fac:
         in V:< var integer
         out res: var integer
         if (V = 1) :then 
            res := 1 
         :else 
            res := V * fac(V - 1)
      myM.print("P1 resumed\n")
      for (1):to(5) :repeat
         myM.putItem{msg:: "Fac: "; valx:: inx; res:: fac(inx)}
   myM: Monitor
      def print: entry
         in S: var String
         S.print
      def putItem: entry
         in msg:< var String
         in valx:< var integer
         in res:< var integer
         put(10)
         put('<')
         msg.print
         putint(valx)
         " = ".print
         putint(res)
         put('>')
   P2: MonitorProcess("PP2")
      def sum: 
         in V:< var integer
         out res: var integer
         for (1):to(10):repeat
            res := res + V
      myM.print("P2 resumed\n")
      for (1):to(6) :repeat
         myM.putItem{msg:: "Sum"; valx:: inx; res:: sum(inx)}
   myM.init
   P1.start
   P2.start

