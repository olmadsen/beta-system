__UsePTNSyntax__
WeakQualEx: obj
   ptn Point: Value
      in x:< var integer
      in y:< var integer
   p1: var Point
      x:: 10
      y:: 20
   p2: var Point
      x:: 100
      y:: 200
   p3: var Point(11,12)
   p4: var Point(14,15)
   p1 := p2
   p3 := p4
   
   ptn Set:
      in ptn elm:< Object
   ptn Vehicle:
      %globals
      brand: var StringLib.String
   ptn Car: Vehicle {owner: var StringLib.String}
   ptn Bus: Vehicle { noOfPassengers: var integer }
   vehicleReg: Set{elm:: Vehicle; noOfVehicles: var integer}
   xreg: var Set{elm:: Vehicle}
   xreg := vehicleReg
