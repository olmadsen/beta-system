__UsePTNSyntax__
CPStestZZ: obj
   %requires Collections,MapLib,SetLib
   %visible Collections
   ptn Qualification:
      %globals
      in Q:< var integer
      ptn print: {"Qualification:".print; putint(Q)}
   ptn Qualifications: SetLib.Set(#Qualification)
      ptn print: {scan{current.print}} 
   
   ptn Expert:
      in name:< var StringLib.String   
      in quali:< var Qualifications
      %globals
      ptn print:
         "Expert:".print
         name.print
         put(':')
         quali.print
         newline 
   ptn Experts: SetLib.Set(#Expert)
      ptn print: {scan{current.print}}
   
   ptn Alarm:
      in descr:< var StringLib.String
      in reqQuali:< var Qualification
      %globals
      ptn print:
         "alarm: ".print
         descr.print
         put(':')
         reqQuali.print
   ptn Alarms: SetLib.Set(#Alarm)
      ptn print:
         scan
            current.print
            put(',')
         newline
   ptn Period:
      in start:< var integer
      in end:< var integer
      %globals
      ptn print:
         "Period:".print
         putint(start)
         put(',')
         putint(end)
         newline 
   ptn Periods: SetLib.Set(#Period)
      ptn print:
         scan
            current.print
   
   ptn Schedule: MapLib.Map(#Period,#Experts)
      dum: var integer	 
   
   ptn Plant:
      in theAlarms:< var Alarms
      in theSchedule:< var Schedule
      ptn PlantInvA:
          out B: var Boolean
          B := theSchedule.forAll({E.theRange.isEmpty.not }) \
               && \
               theAlarms.forAll(
                  { in A:< var Alarm; out BB: var Boolean;
                    BB := theSchedule.forAll(
                     { E.theRange.exists(
                       { in Ex:< var Expert; out R: var Boolean;
                         R := Ex.quali.has(A.reqQuali)})})})

      ptn PlantInvB:
          out B: var Boolean
          B := true
          theSchedule.scan
              B := B && current.theRange.isEmpty.not
          theAlarms.forAllX -- for all A in alarm
              A: var Alarm
              A := current
              theSchedule.scan -- for all current in schedule
                 -- an Expert E with qualifications needed 
                 -- for the Alarm A must exist
                 bbb: var Boolean
                 bbb := current.theRange.exists( 
                      {in E:< var Expert; out R: var Boolean; 
                       R := E.quali.has(A.reqQuali)})
                 B := B && bbb
      ptn plantInvC:
          out B: var Boolean
          B := theSchedule.forAllII(theSubject.theRange.isEmpty.not) \
               && \
               theAlarms.forAll(
                  { in A:< var Alarm; out BB: var Boolean;
                    BB := theSchedule.forAllII(
                     { theSubject.theRange.exists(
                       { in Ex:< var Expert; out R: var Boolean;
                         R := Ex.quali.has(A.reqQuali)})})})
      ptn ExpertToPage:
         in a:< var Alarm
         in p:< var Period
         out exp: var Expert
         theSchedule.lookup(p).scan -- exp not defined, should be current?
            if(exp.quali.has(A.reqQuali)):then
                leave(#ExpertToPage)
      ptn numberOfExperts:
         in p:< var Period
         out n: var integer
         n := theSchedule.lookup(p).size
      ptn ExpertIsOnDuty:
         -- return in fp all periods where ep is on duty
         in ep:< var Expert
         out fp:  Periods
         "ExpertIsOnDuty\n".print
         ep.print
         theSchedule.scan
            if (current.theRange.has(ep)) :then
                fp.insert(current.theDomain)
         fp.print
      ptn expertIsOnDutyR:
         in ep:< var Expert
         out fp: var Periods	    
         fp:= theSchedule.select(
	           {in p:< var Period; in ES:< var Experts; out B: var boolean; B := ES.has(ep);})
         fp.print
         "end-expertIsOnDutyR\n".print
   Q:  Qualification(17)
   QS:  Qualifications
   
   E1: var Expert
   E2: var Expert
   ES1:  Experts -- SetLib.Set(#Expert){}
   ES2:  Experts -- SetLib.Set(#Expert){}
   A: var Alarm
   AS: Alarms
   S: Schedule
   P: Plant(AS,S)
   QS.insert(Q)
   A := Alarm("OverHeat",Q)
   E1 := Expert("John",QS)
   ES1.insert(E1)
   E1:= Expert("Laura",QS)
   ES1.insert(E1)
   S.add(Period(0,8),ES1)
   E2:= Expert("Surayya",QS)
   ES2.insert(E2)
   S.add(Period(8,16),ES2)
   S.add(Period(16,24),ES1)
   AS.insert(A)
  
  

   "On duty:A:".print
   E1.print
   P.expertIsOnDuty{ep:: E1} --- RTN value is not used !!!???
   "\n---\n".print
   put('a')
   "On duty:B:".print
   put('b')
   E2.print   
   