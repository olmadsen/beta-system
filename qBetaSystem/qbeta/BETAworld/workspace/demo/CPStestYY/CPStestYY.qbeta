CPStestYY: obj 
   SetX:
      elm:< Object
      exists:
         pred:<
            x: ref elm
            inner(pred)
         inner(exists)
   MapX:
      Domain:< Object
      Range:< Object
      entry:
         in theDomain: ref Domain
         in theRange: ref Range
      forAll:
         pred:<
            in E: ref Entry
            inner(pred)
         inner(forAll)
      inner(MapX)
   Qualification:
      ...
   Qualifications: SetX
      elm:: Qualification
      ...
   Expert:
      in name: ref StringLib.String   
      in quali: ref Qualifications
   Experts: SetX
      elm:: Expert
      ... 
   Period:
      ...  
   SCH: MapX
      Domain:: Period
      Range:: Experts
      forall
         pred:: 
            E.theRange.exists
               pred::
                   x.quali
