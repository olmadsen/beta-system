hello: obj
   Outer:
      go:
         put('%')
      put('A')
      cycle
         R: ref Outer
         put('B')
         if (True) :then
            put('C')
         leave(Outer)
         put('?')
         R.go
   gogo:
      ch: var Char
      incr:
         n: var integer
         n := n + 1
         doit:
            if (n < 5) :then
               ch := 'D' + N
               put(ch)
               restart(incr)
         doit
      incr
   simpleCo:
      put('I')
      this(simpleCo).suspend
      put('K')
   fac: obj   -- off: 2 + 3 = 5
      ch: var char
      next:
         ch := ch + 1
         put(ch)
         fac.suspend
         next
      ch := 'a'
      put('X')
      fac.suspend
      put('Y')
      next
   Outer
   put('D')
   gogo
   R: obj simpleCo
   put('J')
   R.call
   fac.call
   fac.call
   fac.call