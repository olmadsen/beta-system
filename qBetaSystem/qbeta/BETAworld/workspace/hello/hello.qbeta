hello: obj
   x: var integer
   y: var integer
   z: var integer
   snorf:
      in Q: var integer
      put('C')
      put(Q)
   Record:
      get:
         out V: var integer
         V := 8
   fooBar:
      in foox: var integer
      in fooy: var integer
      in fooR: ref Record
      out foov: var integer
      fooQ: var integer
      fooQ := fooR.get
      x := y + z
      foov := foox + fooy + fooQ
   fisk:
      a: var integer
      snaps:
         x := y + z
      a := 119 + x; 
      if (a > 0) :then
         a := 121
      :else
         a := 123
      put('Q')
      snaps
   ArrayXX:
      XXX: obj Array(10,#integer)
      V: var integer
      XXX.put(72):at[3]
      V := XXX.get[3]
      put(V)
      XXX.put(97):at[1]
      V := XXX.get[1]
      put(V)
      XXX.put(98):at[10]
      V := XXX.get[10]
      put(V)
      put(10)
      put(ch)
      ch := 'd'
   ch: var char
   put(10)
   put('%')
   put('A')
   put('B')
   snorf('D')
   x := 29
   z := 5
   y := x + z * 8
   put(y)
   put('#')
   y := 141
   x := y // 2
   put(x)
   put('$')
   y := 171
   x := y /% 100
   put(x)
   put('/')
   ch := 'c'
   ArrayXX
   put(ch)
   put(';')
   y := 17
   putint(y)
   put('D')
   "\nHello world!\n".print
   x := fooBar(81,9,Record)
   putint(x)
   fisk
