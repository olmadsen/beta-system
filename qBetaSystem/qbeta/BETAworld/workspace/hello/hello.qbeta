hello: obj
   x: var integer
   y: var integer
   z: var integer
   snorf:
      in Q: var integer
      put('C')
      put(Q)
   Record:
      get:
         out V: var integer
         V := 100
   fooBar:
      in foox: var integer
      in fooy: var integer
      in fooR: ref Record
      out foov: var integer
      fooQ: var integer
      fooQ := fooR.get
      x := y + z
      foov := foox + fooy + fooQ
   fisk:
      a: var integer
      snaps:
         x := y + z
      a := 119 + x; 
      if (a > 0) :then
         a := 121
      :else
         a := 123
      put('Q')
      snaps
   ArrayXX:
      XXX: obj Array(10,#integer)
      V: var integer
      XXX.put(72):at[3]
      V := XXX.get[3]
      put(V)
      XXX.put(97):at[1]
      V := XXX.get[1]
      put(V)
      XXX.put(98):at[10]
      V := XXX.get[10]
      put(V)
      put(10)
      put(ch)
      ch := 'd'
      put(10)
      for(1):to(3):repeat
         XXX.put('b' + inx):at[inx]
      for(1):to(3):repeat
         put(XXX.get[inx])
      put(10)
   helloWorld:
      how:< Object
      are:< Object
      you:< Person
      how
      are
      --you 
   Person:
      put('P')
      inner(Person)
   Greating: helloWorld
      how::
         put('H')
   Super:
      put('S')
      inner(Super)
      put(ch)
   Main: Super
      put('T')
      ch := 'U'
      inner(Main)
   ParamVVV:
      in x: var integer
      in y: var integer
      out v: var integer
      put(x + y)
      v := x + y + 1
   ParamRRR:
      in ch: var Char
      out R: ref Record
      put(ch)
      R := Record
   put(V: var integer):exe(S:< Object):
      put(V)
      S
   ch: var char
   ch := 'R'
   R: ref Record
   --R := Record
   --x := fooBar(81,9,R)
   put('W'):exe
      put('E')
      put(10)
      --put(ch)
   ch := ParamVVV(90,7)
   put(ch)
   R := ParamRRR(99)
   ch := R.get
   put(ch)
   put(10)
   put('%')
   put('A')
   put('B')
   snorf('D')
   x := 29
   z := 5
   y := x + z * 8
   put(y)
   put('#')
   y := 141
   x := y // 2
   put(x)
   put('$')
   y := 171
   x := y /% 100
   put(x)
   put('/')
   ch := 'c'
   ArrayXX
   put(ch)
   put(';')
   put(13)
   x := 3
   y := 17
   z := (y - x) * (103 - 96)
   put(y)
   put('H')
   Greating
   Main
   putint(117)
   "\nHello world!\n".print
   x := fooBar(81,9,Record)
   putint(x)
   fisk
