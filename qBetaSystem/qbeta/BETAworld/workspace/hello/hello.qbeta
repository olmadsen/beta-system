hello: obj
   simpleCo:
      put('b')
      this(simpleCo).suspend
      put('d')
   fac: obj   -- off: 2 + 3 = 5
      ch: var char
      next:
         ch := ch + 1
         put('+')
         put(ch)
         put('<')
         fac.suspend
         put('>')
         next
      ch := 'a'
      put(ch)
      fac.suspend
      ch := ch + 4
      put(ch)
      next
   R: obj simpleCo
   put('c')
   R.call
   put(';')
   fac.call
   put(',')
   fac.call
   put(',')
   fac.call
   put('.')