hello: obj
   x: var integer
   y: var integer
   z: var integer
   Record:
      get:
         out V: var integer
         V := 8
   fooBar:
      in foox: var integer
      in fooy: var integer
      in fooR: ref Record
      out foov: var integer
      fooQ: var integer
      fooQ := fooR.get
      x := y + z
      foov := foox + fooy + fooQ
   fisk:
      a: var integer
      snaps:
         x := y + z
      a := 119 + x;
      if (a > 0) :then
         a := 121
      :else
         a := 123
      put('Q')
      snaps
   put('a')
   x := 117
   z := 5
   y := x + z * 33
   putint(y)
   "\nHello world!\n".print
   x := fooBar(81,9,Record)
   putint(x)
   fisk
