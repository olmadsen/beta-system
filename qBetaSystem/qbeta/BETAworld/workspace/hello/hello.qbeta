hello: obj
   ElmTop:
      in ch: var char
      out cv: var char
      put(ch)
      inner(ElmTop)
      ch := ch + 1
      put(ch)
      cv := ch + 1
   ElmMain: ElmTop
      ch := ch + 1
      put(ch)
      inner(ElmMain)
      ch := ch + 1
      put(ch)
   ElmBottom: ElmMain
      ch := ch + 1
      put(ch)
   ContainerTop:
      elmBOBS:< ElmTop
      inner(ContainerTop)
   ContainerMain: ContainerTop
      elmBOBS::< ElmMain
      inner(ContainerMain)
   ContainerBottom: ContainerMain
      elmBOBS:: ElmBottom
      ...
   R: ref ContainerTop
   V: var char
   put('a')
   R := ContainerBottom
   put('b')
   V := R.elmBOBS('N')
   put(V)
   put('/')

      