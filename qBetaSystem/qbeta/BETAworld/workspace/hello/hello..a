
.extern _puts
.bss
.align 3
heap:
.space 8 * 1014 *1024

.text
.global _main
.align 2
_main:
	 sub sp,sp, #16
	 str lr,[sp,0]
	 adrp    x29, heap@PAGE
	 add     x29, x29,heap@PAGEOFF
	 bl _VM
	 ldr lr,[sp,0]
	 add sp,sp, #16
	 ret

.globl _qAllocIndexed
_qAllocIndexed:
	 str x2,[x29,24]
	 str x0,[x29,16]
	 mul x0,x0,x2
	 add x0,x0, #3
		; pushc 8
	 mov x3, #8
	 mul x0,x0,x3
	 mov x15,x29
	 add x29,x29,x0
	 ret
.text
.global _putc
	 // write(1, sp, 1)
_putc:	 // Character is in x0
	 sub     sp, sp, #16
	 str     x0, [sp]
	 str     x28, [sp, #8]
	 mov     x0, #1              // stdout
	 mov     x1, sp              // address of character
	 mov     x2, #1              // one byte
	 mov     x16, #4             // write
	 svc     #0x80
	 ldr     x28, [sp,#8]
	 add     sp, sp, #16
	 ret

.global _putObj
_putObj:
	 sub     sp, sp, #16
	 str     lr, [sp]
	 str     x28, [sp, #8]

	 ldr x0,[x0,16]
	 ldr x1,[x0,0]
	 add x0,x0,x1
	 bl _puts
	 ldr     x28, [sp,#8]
	 ldr     lr, [sp,#0]
	 add     sp, sp, #16
	 ret

.global _putt
	 // write(1, sp, 1)
_putt:	
	 mov     x0, #1          // stdout
	 mov     x2, #0
	 mov     x16, #4         // write
	 svc     #0x80
	 ret

