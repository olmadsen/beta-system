ArmMultiCore: obj 
   Core: SuperCore
      S: ref Object
      attach: 
         in P: ref Object
         S := P
      "Core is here\n".print
      this(Core).suspend
      Loop: do
         if (S =/= none) :then 
            "Core in loop\n".print
            S.call 
         :else 
            restart(Loop)
   cores: obj
      C1: ref Core
      init:
         C1 := Core
         "Call fork\n".print
         fork(C1)
         "Call attach\n".print
         C1.attach(Foo)
   Foo:
      "Foo.start\n".print
      this(Foo).suspend
      for (1):to(3):repeat
         "Foo is here\n".print
      "Foo is stopped".print
   cores.init