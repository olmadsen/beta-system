ArmMultiCore: obj 
   CoreX: SuperCore
      S: ref Object
      attach: 
         in P: ref Object
         S := P
      "Core is here\n".print
      this(CoreX).suspend
      Loop: do
         if (S =/= none) :then 
            "Core in loop\n".print
            S.call 
         :else 
            restart(Loop)
   cores: obj
      C1: ref CoreX
      C2: ref CoreX
      init:
         C1 := CoreX
         "Call fork C1\n".print
         fork(C1)
         "Call attach Foo\n".print
         Foo
         put('&')
         C1.attach(Foo)
         "Bum\n".print
         C2 := CoreX
         "Call fork C2\n".print
         fork(C2)
         "Call attach Bar\n".print
         --C2.attach(Bar)
   Foo:
      "Foo.start\n".print
      this(Foo).suspend
      for (1):to(3):repeat
         "Foo is here\n".print
      "Foo is stopped".print
   Bar:
      "Bar.start\n".print
      this(Bar).suspend
      for (1):to(3):repeat
         "Bar is here\n".print
      "Bar is stopped".print

   cores.init
   cycle
      put('.')