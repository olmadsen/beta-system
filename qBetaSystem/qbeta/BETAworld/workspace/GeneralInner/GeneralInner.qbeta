GeneralInner: obj
   %visible Collections
   BooleanInner:
      %inner
      in ptn: ref Object
      out Bb: var Boolean
   Predicate:  
      subject:< var integer; 
      out Bx: var Boolean
      Bx := BooleanInner(#Predicate)
   Stream:
      add:
         in V: var integer
         top := top + 1
         S.put(V):at[top]
      scan:
         current: var integer
         for (1):to (top) :repeat
             current := S.get[inx]
             inner(scan)
      filter:
         in pred:<  Predicate
         out S: obj Stream
         scan
            if (pred(current)) :then
               S.add(current)
      S: obj Array(100,#integer)
      top: var integer
   tryMap:
      Period:
         in start: var integer
      Expert:
         in name: var StringLib.String
      sch: obj MapLib.Map(#Period,#Expert)
      "\ntryMap:\n".print
      sch.add(Period(17),Expert("Mike"))
      --sch.forAllII(theSubject.theDomain.start = 17)
      if (sch.forAll(E.theDomain.start = 17)) :then 
         "OK,".print
      if (sch.forAllII(theSubject.theDomain.start = 17)) :then 
         "OK".print
   S: obj Stream
   R: ref Stream
   "Predicate: ".print
   MyPred: Predicate
        subject < 4
   for (1):to(8):repeat
       if (MyPred(inx)) :then
          put('t')
       :else
          put('f')
   for (1):to (10) :repeat 
      S.add(inx)
   "\nStream.filter: ".print
   R := S.filter(subject < 5)
   newline
   R.scan
      putint(current)
      put(' ')
   tryMap

   