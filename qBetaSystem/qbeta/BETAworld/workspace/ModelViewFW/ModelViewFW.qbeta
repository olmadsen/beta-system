__UseDefSyntax__
ModelViewFW: obj
   -- Example from the ECOOP'99 paper by Kresten Krab Thorup & Mads Torgersen
   -- Unifying Genericity - Combining the Benefits of Virtual Types and Parameterized Classes
   def ModelView:
      def Model:< 
         def registerView:
            in v:< View
            vs.insert(v)
         def changed:
            vs.scan
               current.update(this(Model))
      def View:<
         def update:<
            in M: Model
            inner(update)
      --vs: LIB.Collections.OrderedList.OrderedList{elm:: View}
      vs: LIB.Collections.OrderedList.OrderedList(#View) -- (View) gives sem error
   def DrawFW: ModelView
      Model::<
         def getFigure:
            out T: var StringLib.String
            ...
      View::<
         update::<
            M.getFigure
   draw: DrawFW
   model: draw.Model
   view: draw.View
   model.registerView(view)
   model.changed
   "\n---- ModelViewFW ----\n".print
