ArmMonitor: obj
   mon: obj
      entry:
         mutex.get
         loop: 
            res: var integer
            res := L.cmpAndSwap(1)
            if (res = 1) :then
               restart(loop)
         inner(entry)
         --L := 0
         mutex.free
      putItem: entry
         in msg: var String
         msg.print
      mutex: obj LockLib.Lock("Mutex")
      L: var integer
   Core1: obj 
      %core
      this(Core1).suspend
      for (1):to(3):repeat
         mon.putItem("From core1\n")
   Core2: obj 
      %core
      this(Core2).suspend
      for (1):to(3):repeat
         mon.putItem("From core2\n")
      
   "Hello\n".print
   fork(Core1)
   fork(Core2)
   mon.putItem("end main\n")