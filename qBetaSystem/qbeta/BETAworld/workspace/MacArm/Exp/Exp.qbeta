Exp: obj
   a: var integer
   b: var integer
   c: var integer
   d: var integer
   foo:
      in x: var integer
      in y: var integer
      out v: var integer
      v := x + y
   a := 81
   b := 5
   d := 3
   c := a + foo(10,6)
   put(c)
   c := a + b + foo(5,7)
   put(c)
   a := 24
   c := a + b * foo(7,8) 
   put(c)
   a := 50
   c := a + b * (d + foo(3,4))
   put(c)
