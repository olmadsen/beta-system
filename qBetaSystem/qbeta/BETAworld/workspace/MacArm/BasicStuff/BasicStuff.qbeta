BasicStuff: obj
   x: var integer
   y: var integer
   z: var integer
   snorf:
      in Q: var integer
      put('I')
      put(Q)
   Record:
      get:
         out V: var integer
         V := 78
   fisk:
      a: var integer
      snaps:
         x := y + z
      a := 119 + x; 
      if (a > 0) :then
         a := 121
      :else
         a := 123
      put('Q')
      snaps
   ArrayXX:
      XXX: obj Array(10,#integer) --    
      V: var integer
      XXX.put(78):at[3]  -- 'N'  
      V := XXX.get[3]
      put(V)
      XXX.put(79):at[1]  -- 'O'
      V := XXX.get[1]
      put(V)
      XXX.put(80):at[10] -- 'P'
      V := XXX.get[10]
      put(V) 
      for(1):to(3):repeat
         XXX.put('P' + inx):at[inx]
      for(1):to(3):repeat
         put(XXX.get[inx]) 
      put(ch)
      ch := 'U'
   Super:
      put('S')
      inner(Super)
      put(ch)
   Main: Super
      put('T')
      ch := 'U'
      inner(Main)
   ParamVVV:
      in x: var integer
      in y: var integer
      out v: var integer
      put(x + y)
      v := x + y + 1
   ParamRRR:
      in ch: var Char
      out R: ref Record
      put(ch)
      R := Record
   doPut(V: var integer):exe(S:< Object):
      put(V)
      S
   ch: var char
   R: ref Record
   put(10)
   put(13)
   put('%')
   put('A')
   put('B')
   ch := 'C'
   put(ch)
   x := 28
   z := 5
   y := x + z * 8 -- 68 = 'D'
   put(y)
   y := 139
   x := y // 2 -- 'E'
   put(x)
   y := 170
   x := y /% 100
   put(x) 
   x := 3
   y := 17
   z := (y - x) * (101 - 96) + 1  -- 'G'    
   put(z)
   put('H')
   snorf('J')
   ch := ParamVVV(70,5) -- pass 70 + 5 = 'K'
   put(ch)
   R := ParamRRR(77)
   ch := R.get
   ch := 'T'
   ArrayXX
   ch := 'W'
   doPut('U'):exe
      put('V')
      put(ch)
