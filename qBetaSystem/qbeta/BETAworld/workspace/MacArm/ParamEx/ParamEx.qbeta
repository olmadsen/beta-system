ParamEx: obj 
   Record:
      in n: var char
   a: var integer
   b: var integer
   c: var integer
   d: var integer
   e: var integer
   f: var integer
   rq: ref Record
   ws: ref StringLib.String
   foo:
      in x: var integer
      in r: ref Record
      in s: var StringLib.String
      in y: var integer
      out z: var integer -- off: 6
      --put('&')
      --put(x + 7)
      --put('/')
      --put(r.n + 100)
      put('+')
      put(s.length + 100)
      put('#')
      --put(y + 100)
      --put('%')
      z := x + r.n + s.length + y -- x and r.n are in x0, x1; s.length override; must store in tmp
      z := x + r.n + 2 + y
      --put(z)
      --put('$')
   tmpFoo:
      x: var integer
      b := 81  -- b=81 + rq.n=3 + ws.length=2 + d=5 + rq.n=3 + ws.length=2 + x=2 == 97
      d := 6
      x := 2
      a := foo(b,rq,ws,foo(d,rq,ws,x))
      put(a)
   func1:
      in xx1: var integer
      in yy1: var integer
      in zz1: var integer
      in vv1: var integer
      out ww1: var integer
      ww1 := xx1 + yy1 + zz1 + vv1
   func2:
      in xx2: var integer
      in yy2: var integer
      out ww2: var integer
      ww2 := xx2 + yy2
   func3:
      in xx3: var integer
      in yy3: var integer
      in zz3: var integer
      out ww3: var integer
      ww3 := xx3 + yy3 + zz3
   func4:
      in xx4: var integer
      in yy4: var integer 
      out ww4: var integer
      ww4 := xx4 + yy4
   tmpFunc:
      Q: var integer
      Q := func1(a,b, \
                     func2(c,d), \
                                 func3(e,f, \
                                            func4(117,118)))
   stringFoo:
      in Sfoo: var StringLib.String
      out Vfoo: var integer
      vFoo:= Sfoo.length
      -- newline
      put(vFoo + 88)
      --put(':')
      --newline
   a := 90
   rq := Record(3)
   ws := "Ha"
   c := ws.get[2]
   put(c)  -- 'a'
   c := 3
   a := foo(a,rq,ws,c)
   --put('<')
   put(a)  -- 'b'
   --put('>')
   tmpFoo   -- 'c'
   --put('!')
   tmpFunc  -- 'd'
   SSS: var StringLib.String
   SSS:= "Hello world!"
   a := stringFoo(SSS)
   put(a + 89)
   ...
   --a := a + b * foo(a,rq,ws)
   --a := a * b /% (foo(d,e) + f)