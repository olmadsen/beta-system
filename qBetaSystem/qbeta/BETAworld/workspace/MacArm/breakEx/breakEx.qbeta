breakEx: obj
   doBreak:
      Outer:
         go:
            put('%')
         put('A')
         cycle
            R: ref Outer
            put('B')
            if (True) :then
               put('C')
            leave(Outer)
            put('?')
            R.go
      gogo:
         ch: var Char
         incr:
            n: var integer
            n := n + 1
            doit:
               if (n < 5) :then
                  ch := 'D' + N
                  put(ch)
                  restart(incr)
            doit
         incr
      Outer
      put('D')
      gogo
