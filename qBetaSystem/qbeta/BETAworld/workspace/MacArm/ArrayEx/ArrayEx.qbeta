ArrayEx: obj
   arrayList:
         printA:
            lgth: var integer
            lgth := arr2.length
            put('[')
            putint(lgth)
            put(':')
            if (1 <= lgth) :then
               put(arr2.get[1])
            put(',')
            if (2 <= lgth) :then
               put(arr2.get[2])
            put(',')
            if (3 <= lgth) :then
               put(arr2.get[3])
            put(']')
            arr2.scan
               put('+')
               put(current)
         arr1: obj Array(2,#integer)
         arr2: ref Array(3,#integer)
         v: var integer
         arr2 := ('g','h','i')
         put(arr2.get[1])
         printA
         put(';')
         arr2 := 'j'
         printA
         put(',')
         v:= 'k'
         arr2 := v
         printA
         put('!')
         arr1.put('l'):at[1]
         arr1.put('m'):at[2]
         arr2 := arr1
         printA
         put('?')
   goArray:
      XXX: obj Array(10,#integer)
      for(1):to(3):repeat
         XXX.put('b' + inx - 2):at[inx]
      for(1):to(3):repeat
         put(XXX.get[inx])
      for(ix)
         from:: 1
         to:: 3
         repeat::
            --put(XXX.get[ix] + 3) -- run-time error
            V: var integer
            V := XXX.get[ix] -- + 3 , run-time error
            V := V + 3
            put (V)
      arrayList
      nl
