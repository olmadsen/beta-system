ArrayEx: obj
   arrayList:
         printA:
            arr2.scan
               put(current)
         arr1: obj Array(2,#integer)
         arr2: ref Array(3,#integer)
         v: var integer
         arr2 := ('g','h','i')
         printA
         arr2 := 'j'
         printA
         v:= 'k'
         arr2 := v
         printA
         arr1.put('l'):at[1]
         arr1.put('m'):at[2]
         arr2 := arr1
         printA
   goArray:
      XXX: obj Array(10,#integer)
      for(1):to(3):repeat
         XXX.put('b' + inx - 2):at[inx]
      for(1):to(3):repeat
         put(XXX.get[inx])
      for(ix)
         from:: 1
         to:: 3
         repeat::
            --put(XXX.get[ix] + 3) -- run-time error
            V: var integer
            V := XXX.get[ix] -- + 3 , run-time error
            V := V + 3
            put (V)
      arrayList
      nl
