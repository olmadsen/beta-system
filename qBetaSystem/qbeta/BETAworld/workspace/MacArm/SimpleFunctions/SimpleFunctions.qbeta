SimpleFunctions: obj
   ArmFuncA:
      in x: var integer
      in y: var integer
      in z: var integer
      out v: var integer
      v := x + y + z
   ArmFuncB:
      in a: var integer
      in b: var integer
      out w: var integer
      w := a + b
   Record:
      in n: var integer
   ArmFuncX:
      localFunc:
         in R1: ref Record
         out V: var integer
         V := R1.N
      S: ref Record
      w: var integer
      S := Record(110)
      W := localFunc(S)
      put('[')
      put(W)
      put(']')
   ArmFuncC:
      in R1: ref Record
      in R2: ref Record
      in R3: ref Record
      out R4: ref Record
      put('<')
      put(R1.n + 30)
      put('>')
      R4 := Record(R1.n + R2.n + R3.n)
   q: var integer
   S: ref Record
   S1: ref Record
   S2: ref Record
   S3: ref Record
   q := ArmFuncA(90,5,2)
   put(q)
   q := ArmFuncA(80,ArmFuncB(8,6),4)
   put(q)
   S1 := Record(70)
   put(S1.n + 30)
   S2 := Record(13)
   S3 := Record(16)
   ArmFuncX
   S := ArmFuncC(S1,S2,S3)
   put(S.n)
   S := ArmFuncC(S1,S2,Record(17))
   put(S.n)


