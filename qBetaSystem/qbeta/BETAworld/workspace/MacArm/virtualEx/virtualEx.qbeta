virtualEx: obj
   doVirtual:
      Top:
         hello:<
            out c: var char
            put(ch)
            inner(hello)
            put(ch + 4)
            c := ch + 5
      Main: Top
         hello::<
            put(ch + 1)
            inner(hello)
            put(ch + 3)
      Bottom: Main
         hello::
            put(ch + 2)
      Record:
         in V: var integer
      Upper:
         jump:<
            out R: ref Record
            inner(jump)
      Lower: Upper
         jump::<
            R := Record('M') 
      ch: var Char
      B: obj Bottom
      R: ref Top
      L: ref Lower
      Rx: ref Record
      ch := 'A'
      ch := B.hello
      put(ch)
      R := Bottom
      ch := 'G'
      ch := R.hello
      put(ch)
      L := Lower
      Rx := L.jump
      put(Rx.V)
   doVirtual
