ContextOP: obj
   StringLayer -> s: var String:
      s := ""
      inner(StringLayer)
   class Person:
      in name: var String
      in adr: var String
      in empl: ref Employer
      toString -> S: var String:
         S := " Name: " + name + adrLayer + emplLayer +"\n"
      AddressLayer: StringLayer
         S := "; Addres: " + adr
      EmployeLayer: StringLayer
         S := "; [Employer:] " + empl.toString
      withAddressLayer:
         adrLayer := AddressLayer
      withEmployeLayer:
         emplLayer := EmployeLayer
      adrLayer: ref StringLayer
      emplLayer: ref EmployeLayer
      adrLayer := StringLayer
      emplLayer := StringLayer
   class Employer:
      in name: var String
      in adr: var String
      toString -> S: var String:
         S := " Name: " + name  + adrLayer
      AddressLayer: StringLayer
         S := "; Addres: " + adr
      withAddressLayer:
         adrLayer := AddressLayer
      adrLayer: ref StringLayer
      adrLayer := StringLayer
   IFI_UIO: obj Employer("IFI_UIO","Blindern")
   P: obj Person("Kristen","KarlJohan",IFI_UIO)
   P.toString.print
   P.withAddressLayer
   IFI_UIO.withAddressLayer
   P.toString.print
   P.withEmployeLayer
   P.toString.print


