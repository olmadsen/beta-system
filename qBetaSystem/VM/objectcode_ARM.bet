ORIGIN 'objectcode';
INCLUDE 'ARM_instructions'
---ObjectCode_init:descriptor---
(#
do true -> isArm;
   out[] -> state.ins.init;
   state.genHeading;
   state.gen_qAllocindexed;
   state.gen_putc;
#)
---ObjectCode_state:descriptor---
(# trace: (# exit true #);
   x0: (#exit 0 #);
   x1: (#exit 1 #);
   x2: (#exit 2 #);
   x29: (#exit 29 #);
   ins: @ ARM_instructions;
   gen_qAllocindexed:
      (*                      fields[1], [8] = origin, but perhaps not used?
       *     fields[arrayStrucSize - 1],[16] = range,  in 16-bit words
       *         fields[arrayStrucSize],[24] = size,   in 16-bit words
       *     fields[arrayStrucSize + 1],[32] = rep[1]
       *                      arrayStrucSize = 3 - defined in objectImage
       *                            bytRange = (arrayStrucSize + range * size) * 8
       * x0 = range, x1 = dInx, x2 = size
       *)
      (# cr: @ integer
      do '\n.globl _qAllocIndexed' -> out.puttext; 'a'->put;
         '\n_qAllocIndexed:' -> out.puttext; 
         (for i:  3 repeat reg. getV for); (* alloc x0,x1,x2 *)
         (x0,x0,x2) -> ins.mulR;  (* range * size -> range *) 
         (x0,x0,arrayStrucSize) -> ins.addI; (* arrayStrucSize + range -> range *)
         8 -> pushConst; stacks.vPop -> cr;
         (x0,x0,cr) -> ins.mulR;   (* range * 8 -> range *)
         (29,29,x0) -> ins.addR;   (* allocate array *)
         
         (x0,x29,arrayStrucSize - 1 - 2) -> ins.str; (* adjustment for str *)
         (x2,x29,arrayStrucSize - 2) -> ins.str;

         (reg.refRegStart,x29) -> ins.movR; (* return start in refRegStart *)
          '\n\t ret' -> out.puttext;
      #);
   computeArrayIndex:
      (* copmpute arrayStrucSize + (inx - 1) * size + size + 1 -> inx; 
       *  fields[1] 
       *               fields[2] = range
       *  fields[arrayStrucSize] = size       <- arrayStrucSize 
       *               fields[1] = 1st element
       *                ...
       *         fields[inx - 1] =  <- arrayStrucSize + (inx - 1) * size
       *             fields[inx] =  <- element indexed
       *         fields[inx + 1] =  <- computed inx
       *                ...
       * return inx * 8
       *)
      (# size,Xr,inxR,sizeR,valR,c8: @integer
      enter size
      do state.stat;
         state.stacks.rPop -> Xr; state.stacks.vPop -> inxR;
         (inxR,inxR,1) -> state.ins.subI;   (* inx - 1 -> inx *)
         size -> pushConst; state.stacks.vPop -> sizeR;
         (inxR,inxR,sizeR) -> state.ins.mulR; (* inx * size -> inx *)
         (inxR,inxR,arrayStrucSize + size + 1) -> state.ins.addI; (* arrayStrucSize + size + 1 -> inx *)
         sizeR -> state.reg.freeV;
         size * 8 -> pushConst; state.stacks.vPop -> c8;
         (inxR,inxR,c8) -> state.ins.mulR;
         c8 -> state.reg.freeV;
         '\n; after sizeR -> state.reg.freeV;' -> out.puttext;
         state.stat;
      exit(Xr,inxR)
      #); 
   mkODname:
      (# n: ^Text; T: ^text
      enter n[]
      do (if (n[] -> mkOprName -> T[]) = none then
             '' -> T[];
             n.scanAll(#do (if ch = ':' then '$' -> T.put else ch -> T.put if) #)
         if)
      exit T[]
      #);
   mkOprName:
      (# n: ^text; T: ^text
      enter n[]
      do (if true 
         // '+' -> ((1,1)->n.sub).equal then '$PLUS' -> T[]; (2,n.length)->n.sub -> T.append;
         // '-' -> ((1,1)->n.sub).equal then '$MINUS' -> T[]; (2,n.length)->n.sub -> T.append;
         // '*' -> ((1,1)->n.sub).equal then '$MULT' -> T[]; (2,n.length)->n.sub -> T.append;
         // '/' -> ((1,1)->n.sub).equal then '$DIV' -> T[]; (2,n.length)->n.sub -> T.append;
         // '=' -> ((1,1)->n.sub).equal then '$EQ' -> T[]; (2,n.length)->n.sub -> T.append;
         // '<=' -> ((1,2)->n.sub).equal then '$LE' -> T[]; (3,n.length)->n.sub -> T.append;
         if)
      exit T[]
      #);
   gen_allocTemplate:
      (# descNo,vInxSize,rInxSize,objSize: @integer; isObj: @boolean; N: ^Text; 
      enter(descNo,isObj,vInxSize,rInxSize,objSize)
      do descs.OD[descNo].name[] -> mkODname -> N[];
         '\n.globl _' -> out.puttext; N[] -> out.puttext;
         '\n_' -> out.puttext; N[] -> out.puttext; ':' -> out.put;
         (* allocate object on hepa - missing check for out-of-memory *)
         '\n\t add     x29, x29, ' -> out.puttext; '#' -> out.puttext; objSize * 8 + 16 -> out.putint; 
         '\n\t str     lr, [x29, #0]' -> out.puttext;
         '\n\t str     x28, [x29, #8]' -> out.puttext;
         '\n\t mov     x28, x29' -> out.puttext; 

      #);
   QallocIndexed:
      (* op2 -> descInx; op1 -> size; op1 -> isRIndexed;
       * a superflous thisObj is pushed by compiler should be eliminated 
       * thisStack.rpop -> X[]; (* origin * )
       * thisStack.vpop -> dinx;
       * thisStack.vpop -> rangee;
       * X[],descInx,size,rangee,isRindexed) -> QallocIndexed
       * arrayStrucSize + range * size --> alloc
       *   fields[1] = origin, but perhaps not used?
       *   fields[arrayStrucSize - 1] = range
       *   fields[arrayStrucSize]     = size
       *   fields[arrayStrucSize + 1] = rep[1]
       *   ...
       * rangee -> fields[arrayStrucSize - 1];
       * size -> fields[arrayStrucSize];
      *)
      (# size,isRIndexed,sizeR,rangeR,dInxR,calleeR,cr: @ integer
      enter(size,isRIndexed)
      do reg.getR -> calleeR; 
         stacks.vPop -> dInxR;  (* x1, not used ?*)
         stacks.vPop -> rangeR; (* x0 *)
         reg.getV -> sizeR;     (* x2 *)
         (if false then 
         (rangeR,RangeR,sizeR) -> ins.mulR;  
         (sizeR,size) -> ins.movI;
         (rangeR,RangeR,arrayStrucSize) -> ins.addI;
         8 -> pushConst; stacks.vPop -> cr;
         (rangeR,rangeR,cr) -> ins.mulR;
         (rangeR,regKind) -> stacks.vPush;  (* range of array to be allocated *)
         if);
         '\n\t bl _qAllocIndexed' -> out.puttext;
         (if false then
         (rangeR,reg.refRegStart,arrayStrucSize - 1 - 2) -> ins.str; (* adjustment for str *)
         (sizeR,reg.refRegStart,arrayStrucSize - 2) -> ins.str;
         cr -> reg.freeV; sizeR -> reg.freeV; dInxR -> reg.freeV;
         if);
         calleeR -> stacks.rPush;
         state.stat
      #);
   labs: @
      (# labNo: @integer; thisLab: ^Text;
         new: 
            (# 
            do labNo + 1 -> labNo; 
               'L' -> thisLab[]; labNo -> thisLab.putint; '_'->thisLab.put
            #)
      #);
   RegisterHandler:
   (# refRegStart: (# exit 15 #);
      thisObj: (#exit 28 #);
      vRegNo,rRegNo: @integer;
      init: (# do 0 -> vRegNo; refRegStart -> rRegNo #);
      getV:
         (# rn: @integer
         do vRegNo -> rn;
            (if (vRegNo + 1 -> vRegNo) >= refRegStart then '\n!!!! ARM codegen. value register overflow'-> putline if);
         exit rn
         #);
      freeV:
         (# rn: @integer
         enter rn
         do (if rn = (vRegNo - 1) then vRegNo - 1 -> vRegNo 
            else
                '\n;!!!! register mismatch: ' ->out.puttext; rn -> out.putint; ','->out.put; vRegNo->out.putint;
            if)
         #);
      stat: 
         (# 
         do (if true then
                ' vRegNo: ' -> out.puttext; vRegNo -> out.putint; ' rRegNo: ' -> out.puttext; rRegNo -> out.putint 
         if)#);
      getR:
         (# rn: @integer
         do rRegNo -> rn;
            (if (rRegNo + 1 -> rRegNo) >= thisObj then '\n!!!! ARM codegen. reference register overflow'-> putline  if);
         exit rn
         #);
      freeR:
         (# rn: @integer
         enter rn
         do (if rn = (rRegNo - 1) then rRegNo - 1 -> rRegNo 
            else
                (if rn <> thisObj then
                   '\n;!!!! register mismatch: ' ->out.puttext; rn -> out.putint; ','->out.put; rRegNo->out.putint;
         if)if)#);
      print: (# rn: @integer enter rn do 'x'->out.put; rn -> out.putint #)
   do
   #);
   valueKind: (# exit 0 #);
   regKind: (# exit 1 #);
   StackHandler:
   (# init: (# do 0 -> vTop -> rTop #);
      vStack: [8] @integer; vTop: @integer;
      vKind: [8] @ integer; (* 0: const; 1: register *)
      rStack: [8] @integer; rTop: @integer;
      vPush: 
         (# v,t: @integer 
         enter(v,t) 
         do (if (vTop + 1 -> vTop) > vStack.range then 
                vStack.range -> vStack.extend; vKind.range -> vKind.extend;
            if);
            v -> vStack[vTop]; t -> vKind[vTop];
         #);
      vPop: (# v: @integer do (if vTop > 0 then vStack[vTop] -> v; vTop - 1 -> vTop else 28 -> v if) exit v #);
      vTopKind: (# k: @integer do (if vTop > 0 then vKind[vTop] -> k else 27 -> k if) exit k #);
      rPush: 
         (# v: @integer
         enter v 
         do (if (rTop + 1 -> rTop) <= rStack.range then v -> rStack[rTop] else '\n; !!! rStack overflow:'->out.putline if)
         #);
      rPop: 
         (# r: @integer 
         do (if (rTop > 0) and (rTop <= 8) then rStack[rTop] -> r; rTop - 1 -> rTop else 27 -> r if) 
         exit r 
         #);
      stat: 
         (#
         do (if false then
            '\n; vTop:'->out.puttext; vTop -> out.putint; ' rTop:'->out.puttext; rTop -> out.putint; out.newline
            else
               ' vStack: ' -> out.puttext;
               (for i: vTop repeat 
                    (if vKind[i] = valueKind then 'V:'->out.puttext else 'R:'->out.puttext if);
                    vStack[i] -> out.putint; ' ' ->out.put
               for);
               'rStack: ' -> out.puttext;
               (for i: rTop repeat rStack[i] -> out.putint; ' ' ->out.put for);

         if) #);
   #);
 stat: (# do '\n;'->out.puttext; stacks.stat; reg.stat #);
 reg: @RegisterHandler; stacks: @StackHandler;
 allocParameters:
    (* NOT sufficient for compound values - must need size *)
    (# 
    do '\n; parameters:pTop=' -> out.puttext; pTop -> out.putint; ':'->out.put;
        (for i: pTop repeat 
            params[i] -> out.putint; ' ' -> out.put;
            (if params[i]
            // 0 then (reg.getV,regKind) -> stacks.vPush
            // 1 then '\n!!!! EmitCode:allocParameters: compound values not supported'->dumpTN
            // 2 then reg.getR -> stacks.rPush;
            // 3 then
            else
                '\n!!!! EmitCode:allocParameters:illegal parameter kind: '-> puttext;
                params[i]->putint; newline
        if)for);
        reg.getR -> stacks.rPush; (* origin register *)
        out.newline
    #);
  params: [0] @integer; pTop: @integer;
  emitOp:
         (# op: @integer
         enter op
         do (if op 
            // codes.plus then
               '\n\t add '-> out.puttext;
            // codes.minus then
               '\n\t sub '-> out.puttext;
            // codes.mult then
               '\n\t mul '-> out.puttext;
            // codes.idiv then
               '\n\t sdiv '-> out.puttext;
            if);
         #);
   binOpImm: (* binary operator with posble immediate argument *)
         (# op,vr,vl,r: @integer
         enter op
         do '\n;binOpImm:'->out.puttext;
            (if stacks.vTopKind = valueKind then 
                stacks.vPop -> vr; 'vr:value'->out.puttext; vr -> out.putint; 
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl; 'vl:value'->out.puttext; vl -> out.putint; 
                    (vr + vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    ':vl:reg:'->out.puttext; vl -> out.putint; 
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ',#'->out.puttext; vr -> out.putint; 
                    (vl,regKind) -> stacks.vPush
                if)
             else
                'vr:reg:'->out.puttext; vr -> out.putint;
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                     ':vr:value: missing: '->out.puttext; vr -> out.putint; 
                else (* operands in registers *)
                   stacks.vPop -> vl; 
                   ':vl:reg:'->out.puttext; vl-> out.putint;
                   op -> emitOp;
                   vl -> reg.print; ','->out.put; vl -> reg.print; ',' -> out.put; vr -> reg.print;
                   vr -> reg.freeV;
                   (vl,regKind) -> stacks.vPush
            if)if)
         #);
      binOpReg: 
         (* binary operator with register argument
          * mult and other caxn only take register arguments
          *)
         (# op,vr,vl,r: @integer
         enter op
         do state.stat;
            '\n;binOpReg'->out.puttext;
             (if stacks.vTopKind = valueKind then 
                '\nvTopKind=valueKind - should not happen?? May happen?' -> puttext;
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl;
                    (vr + vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    vr -> pushConst; stacks.vPop -> vr;
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ','->out.put; vr ->reg.print;
                    vr -> reg.freeV;
                    (vl,regKind) -> stacks.vPush
                if)
             else (* vr in register *)
                'vr:reg:'->out.puttext; vr -> out.putint;
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                    vr -> pushConst; stacks.vPop -> vr;
                    stacks.vPop -> vl;
                    '\n;  This does not work' -> out.puttext
                else
                    'vl:reg:'->out.puttext; vl -> out.putint;
                    stacks.vPop -> vl;
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ','->out.put; vr ->reg.print;
                    vr -> reg.freeV;
                    (vl,regKind) -> stacks.vPush
            if)if)
         #);
      emitMod:
         (# vr,vl,vx,vy: @integer
         do (* '\n;\t Goal: Calculate X3 = X0 % X1'
             * '\n\t UDIV X2, X0, X1        // 1. Get Quotient: X2 = X0 / X1'
             * '\n\t MSUB X3, X2, X1, X0    // 2. Get Remainder: X3 = X0 - (X2 * X1)' -> out.puttext;
             *)
            state.stat;
            '\n;\temitMod:'->out.puttext;
            (if stacks.vTopKind = valueKind then 
                stacks.vPop -> vr; 'vr:value:NOT OK'->out.puttext; vr -> out.putint; 
                (if stacks.vTopKind = valueKind then 
                    stacks.vPop -> vl; 'vl:value:NOT OK'->out.puttext; vl -> out.putint; 
                    (vr + vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    ':vl:reg:NOT OK'->out.puttext; vl -> out.putint; 
                    (*op -> emitOp;*)
                    vl -> reg.print; ','->out.put; vl -> reg.print; ',#'->out.puttext; vr -> out.putint; 
                    (vl,regKind) -> stacks.vPush
                if)
             else
                stacks.vPop -> vr;
                'vr:reg:'->out.puttext; vr -> out.putint;
                (if stacks.vTopKind = valueKind then
                     ':vr:value: missing: '->out.puttext; vr -> out.putint; 
                else (* operands in registers *)
                   stacks.vPop -> vl; 
                   ':vl:reg:'->out.puttext; vl-> out.putint;
                   reg.getV -> vx; 
                   (vx,vl,vr) -> ins.udiv;
                   '\n\t MSUB ' -> out.puttext;
                   vl -> reg.print; ',' -> out.put; vx -> reg.print; ','->out.put; vr -> reg.print; ','->out.put; vl->reg.print; 
                   vx -> reg.freeV;  vr -> reg.freeV; 
                   (vl,regKind) -> stacks.vPush
            if)if)
         #);
      emitPutConst:
          (# ch: @char
          enter ch
          do '\n\t mov x0, #' -> out.puttext; ch -> out.putint;
             '\n\t bl _putc\n' -> out.puttext;
          #);
      invoke:
          (# N: ^Text; off: @integer
          enter(N[],off)
          do (*'\n\t  mov x0, ' -> out.puttext; stacks.rPop -> r -> reg.print;*)
             (* push of origin as first arg, but we dont know;
              * also, some objects have no origin
              *)
             '\n\t bl _'-> out.puttext; N[] -> mkODname -> state.mkODname -> out.puttext;
             state.stacks.init; (* clear possible registers used for parameters  -not OK *)
             state.reg.init;
             state.stat
          #);
    emitLab:
         (# lsc: @integer
         enter lsc
         do state.labs.thisLab[] -> out.puttext; lsc -> out.putint;
         #);
   genHeading:
      (#
      do '\n.bss' -> out.puttext;
         '\n.align 3' -> out.puttext;
         '\nLR_TMP:' -> out.puttext;
         '\n.space 8\n' -> out.puttext;
         '\nthisObj_TMP:' -> out.puttext;
         '\n.space 8 * 1014 *1024\n' -> out.puttext;
         
         '\nheap:' -> out.puttext;
         '\n.space 8\n' -> out.puttext;

         '\n.text' -> out.puttext;
         '\n.global _main\n.align 2' -> out.puttext;
         '\n\t adrp    x29, heap@PAGE' -> out.puttext;       (* heapTop = x29 *)
         '\n\t add     x29, x29,heap@PAGEOFF' -> out.puttext;
         
         '\n_main:\n\t bl _VM' -> out.puttext;
         '\n\t ret\n' -> out.puttext;

      #);
    gen_putc:
      (#
      do '\n.text'->out.puttext;
         '\n.global _putc\n\t // write(1, sp, 1)\n' -> out.puttext;
         '_putc:\t // Character is in x0' -> out.puttext;
         '\n\t sub     sp, sp, #16'-> out.puttext;
         '\n\t str     x0, [sp]'->out.puttext;
         '\n\t str     x28, [sp, #4]\n' -> out.puttext;
         '\t mov     x0, #1              // stdout\n'->out.puttext;
         '\t mov     x1, sp              // address of character\n' -> out.puttext;
         '\t mov     x2, #1              // one byte\n'  -> out.puttext;
         '\t mov     x16, #4             // write\n'  -> out.puttext;
         '\t svc     #0x80\n'  -> out.puttext;
         '\t ldr     x28, [sp,#4]\n' -> out.puttext;
         '\t add     sp, sp, #16\n'  -> out.puttext;
         '\t ret\n'  -> out.puttext;
      #);
   descInx: @integer; (* this descInx *)
   thisName: ^Text; (* name of current class *)
   emitPutReg:
    (# r: @integer
    enter r
    do '\n\t mov x0, x' -> out.puttext; r -> out.putint;
       '\n\t bl _putc\n' -> out.puttext; r -> state.reg.freeV
    #);
   STR_lab: @ integer;
   printString:
      (# S,L: ^Text
      enter S[]
      do '\n.section __DATA,__data\n' -> out.puttext;
         'STR' -> L[]; STR_lab + 1 -> STR_lab -> L.putint;
         L[] -> out.puttext; ':'-> out.put;
         '\n\t'->out.puttext; '.asciz "' -> out.puttext; S[] -> out.puttext; '"' -> out.put;
         '\n.text' -> out.puttext;
         '\n\t adrp    x1, ' ->out.puttext; L[] -> out.puttext; '@PAGE'  -> out.puttext;
         '\n\t add     x1, x1, ' ->out.puttext; L[] -> out.puttext; '@PAGEOFF'  -> out.puttext;
         '\n\t mov     x0, #1          // stdout' -> out.puttext;
         '\n\t mov     x2, #' -> out.puttext; S.length - 1 -> out.putint;
         (* FIX: '-1' because of \n from printTrace *)
         '\n\t mov     x16, #4         // write'
         '\n\t svc     #0x80' -> out.puttext
      #);
   printTrace:
      (# S: ^text
      enter S[]
      do '\\n' -> (S.copy).puttext -> S[]; S[] -> printString; 
      #)
#)
---classDef:doPart---
do
---class:descriptor---
(#
do  (N[],descNo,originOff,originDescNo,isValueObj,out[]) -> descs.setCurrent;
   (if descs.OD[topDescNo][]= none then 
       dumpClass;
       ' descs.OD[topDescNo='->puttext; topDescNo -> putint; '][]= none' -> putline
    else
       (topDescNo,descs.OD[topDescNo].bc[]) -> descs.current.setSuperBC;
   if);
   descs.markAllocE;
   (if procE then 
       'procE:' -> puttext; N[] -> putline;
       descs.markProcE 
   if);
   initGCinfo;
   labs.init;
   (**** ARM stuff ****)
   state.reg.init;
   state.labs.new;
   state.stacks.init;
   state.stat;
   descNo -> state.descInx;
   N[] -> state.thisName[]
#)
---setNoOfParams:doPart---
do params -> state.params; pTop -> state.pTop;
   (state.descInx,true,0,0,objSize)  ->  state.gen_allocTemplate;
   state.allocParameters;
---actions:descriptor---
(#
do  state.reg.init; (* OBS! to clear registers after possible parameter allocations - not OK *)
    out.newline;state.labs.thisLab[] -> out.puttext; 'DO:' -> out.puttext;
    (if state.trace then state.thisName[] -> state.printTrace if);
#)
---pushConst:descriptor---
(# r: @integer
do state.reg.getV -> r;
    '\n\t mov ' -> out.puttext; r -> state.reg.print; ', #' -> out.puttext; cst -> out.putint;
    (r,state.regKind) -> state.stacks.vPush
#)
---pushThis:descriptor---
(#
do state.reg.thisObj -> state.stacks.rPush;
#)
---pushg:descriptor---
(# rv,rr: @integer
do state.reg.stat;
    '\n\t ldr '->out.puttext; state.reg.getV -> rv -> state.reg.print;
    ',['->out.puttext; state.stacks.rPop -> rr -> state.reg.print; ','->out.put; off * 8 + 16 -> out.putint; ']' -> out.put;
    rr -> state.reg.freeR;
    (rv,1) -> state.stacks.vPush
#)
---rpushg:descriptor---
(# rrs,rrd: @integer
do state.stat;
   state.stacks.rPop -> rrs;
   (if rrs = state.reg.thisObj then
       state.reg.getR -> rrd
    else
       rrs -> rrd
   if);
   state.reg.stat;
    '\n\t ldr '->out.puttext; rrd -> state.reg.print;
    ',['->out.puttext; rrs -> state.reg.print; ','->out.put; off * 8  + 16 -> out.putint; ']' -> out.put;
    (if rrs <> rrd then '; rrs: ' -> out.puttext; rrs -> out.putint; rrs -> state.reg.freeR; if);
    rrd -> state.stacks.rPush;
    state.stat
#)
---pushParam:doPart---
do '\n; pushParam: '->out.puttext; state.stacks.vStack[state.stacks.vTop] -> out.putint;
---xpushg:descriptor---
(* rStack: ... X = Array-object
 * vStack: ... inx = index into array,   (0 < inx) and (inx <= size)
 *)
(# Xr,inxR,sizeR,vr: @integer
do (* p1 -> size;  op1 -> isValueObj; thisStack.rpop -> X[]; thisStack.vpop -> inx;*)
   (if false then 
      state.stat;
   state.stacks.rPop -> Xr;
   state.stacks.vPop -> inxR;

   (if size = 0 then (*arrayStrucSize -> X.get -> size;*) if);   
   (* (if (inx <= -2) or (inx > (arrayStrucSize - 1 -> X.get)) then Index error  if); *)
   (*arrayStrucSize + (inx - 1) * size -> inx; *)
   (inxR,inxR,1) -> state.ins.subI; (* inx -1 -> inx *)
   size * 8 -> pushConst; state.stacks.vPop -> sizeR;
   (inxR,inxR,sizeR) -> state.ins.mulR;  (* inx * size -> inx *)
   sizeR -> state.reg.freeV;
   (inxR,inxR,arrayStrucSize + size + 1) -> state.ins.addI; (* arrayStrucSize + inx -> inx; *)
   else
      size -> state.computeArrayIndex -> (Xr,inxR)
   if);
   (if (isValueObj = 0) and (size = 1) then
       (*inx + 1 -> X.get -> value -> thisStack.vpush;*)
       (inxR,inxR,1 * 8) -> state.ins.subI;
       state.reg.getV -> vr;
       (vr,Xr,inxR) -> state.ins.ldrR;
       Xr -> state.reg.freeR;
       (vr,state.regKind) -> state.stacks.vPush
   else (* valueObject *)
       (if size > 1 then
           (for i: size repeat
               (*inx + i-> ix -> X.get -> value -> thisStack.vPush;*)

           for)
       if)
   if)
#)
---storeg:descriptor---
 (# vr,rr: @integer
 do state.stat;
    state.stacks.vPop -> vr; 
    state.stacks.rPop -> rr;
    (if (vr <> 27) and (rr <> 27) then
       '\n\t str '->out.puttext;  vr -> state.reg.print;
       ',['->out.puttext; rr -> state.reg.print; ','->out.put; off * 8 + 16 -> out.putint; ']' -> out.put;
       vr -> state.reg.freeV; rr -> state.reg.freeR;
       state.stat;
    else
       '\n; MISSING str because of x27 registers\n'->out.puttext
    if)
 #)
---rstore:descriptor---
(* store in thisObj, which is not on rStack *)
(# rs: @integer
do state.stat;
    state.stacks.rPop -> rs;
    (if (rs <> 27) then
       '\n\t str '->out.puttext;  rs -> state.reg.print;
       ',['->out.puttext; state.reg.thisObj -> state.reg.print; ','->out.put; off * 8 + 16 -> out.putint; ']' -> out.put;
       rs -> state.reg.freeR;
       state.stat;
    else
       '\n; storeg:MISSING str because of x27 registers\n'->out.puttext
    if)
#)
---rstoreg:descriptor---
(# rs,rd: @ integer
do state.stat;
   state.stacks.rPop -> rs; state.stacks.rPop -> rd;
   (if (rs <> 27) then
       (rd,rs,off) -> state.ins.str
    else
       '\n; rstoreg: MISSING str because of x27 registers\n'->out.puttext
   if);
   rd -> state.reg.freeR; rs -> state.reg.freeR; 
   state.stat
#)
---xstoreg:descriptor---
(* op1 -> size; op1 -> isValueObj; 
 * thisStack.rpop -> X[];
   (if X[] = none then 3 -> fatalError; leave loop if);
   thisStack.vpop -> inx;
   (if size = 0 then
       arrayStrucSize -> X.get -> size;
   if);
   arrayStrucSize + (inx - 1) * size + size + 1 -> inx;
 *   sub x0,inx,-1
 *   mul x0, 
 * (for i: size repeat
        inx - i -> ix;
        thisStack.vPop -> value;
        (value,ix) -> X.assign
   for);
 *)
(# Xr,inxR,sizeR,valR,c8: @integer
do (if true then
       size -> state.computeArrayIndex -> (Xr,inxR)
    else
    state.stat;
   state.stacks.rPop -> Xr; state.stacks.vPop -> inxR;
   (inxR,inxR,1) -> state.ins.subI;   (* inx - 1 -> inx *)
   size -> pushConst; state.stacks.vPop -> sizeR;
   (inxR,inxR,sizeR) -> state.ins.mulR; (* inx * size -> inx *)
   (inxR,inxR,arrayStrucSize + size + 1) -> state.ins.addI; (* arrayStrucSize + size + 1 -> inx *)
   sizeR -> state.reg.freeV;
   size * 8 -> pushConst; state.stacks.vPop -> c8;
   (inxR,inxR,c8) -> state.ins.mulR;
   c8 -> state.reg.freeV;
   '\n; after sizeR -> state.reg.freeV;' -> out.puttext;
   state.stat;
   if); 

   (for i: size repeat
        (inxR,inxR,i * 8) -> state.ins.subI;
        state.stacks.vPoP -> valR;
        (valR,Xr,inxR) -> state.ins.strR;
        state.stat;
   for);
   inxR -> state.reg.freeV;
   '\n; after inxR -> state.reg.freeV;' -> out.puttext;
   Xr -> state.reg.freeR;
   state.stat
#)
 ---defLab:descriptor---
(#
do out.newline; state.labs.thisLab[] -> out.puttext; lab -> out.putint; ':' -> out.put;
#)
---jmp:doPart---
do 'jmp' -> emitOp; 'L'->out.put; lab -> out.putint; out.newline;
   codes.jmp -> emit;
   0 -> emit2;
   lab -> labs.mark;

   '\n\t b '->out.puttext; lab -> state.emitLab; out.newline;
---jmpFalse:descriptor---
(#
do codes.jmpFalse -> emit; 0 -> emit2; Flab -> labs.mark;
   '\n\t bne '->out.puttext; Flab -> state.emitLab; out.newline;
   
#)
---invoke:descriptor---
(# arg,r: @integer
do state.stat;
   state.stacks.rPop -> r;
   state.reg.getR -> arg;
   '\n\t mov '->out.puttext; arg -> state.reg.print; ', ' -> out.puttext; r -> state.reg.print;
   (N[],staticOff) -> state.invoke
#)
---rtn:descriptor---
(#
do '\n\t ldr lr, [x28,#0]' -> out.puttext;  (* restore lr *)
   '\n\t ldr x28, [x28,#8]' -> out.puttext; (* restor thisObj *)

   (if false then 
      '\n\t mov x26, lr ' -> out.puttext;

      '\n\t mov x0, #98\n\t bl _putc'-> out.puttext;
      '\n\t bl _newline' -> out.puttext;
      '\n\t mov x0, x28\n\t bl _puthex' -> out.puttext;
      '\n\t bl _newline' -> out.puttext;
      '\n\t mov x0, x26\n\t bl _puthex' -> out.puttext;
      '\n\t bl _newline' -> out.puttext;
      '\n\t mov lr, x26' -> out.puttext;
   if);
   '\n\t ret\n' -> out.puttext;
#)
---prepareReturn:descriptor---
(#
do state.reg.thisObj -> state.stacks.rPush; state.reg.thisObj -> state.stacks.rPush;
#)
---invokev:descriptor---
(#
do codes.invokev -> emit; dinx -> emit; noOfRefArgs -> emit;
   (if recIsValueObj then 1  -> emit else 0 -> emit if);
#)
---allocIndexed:descriptor--
(#
do (* op2 -> descInx; op1 -> size; op1 -> isRIndexed;
      a superflous thisObj is pushed by compiler should be eliminated 
      thisStack.rpop -> X[]; (* origin * )
      thisStack.vpop -> dinx;
      thisStack.vpop -> rangee;
      X[],descInx,size,rangee,isRindexed) -> QallocIndexed
      arrayStrucSize + range * size --> alloc
   *)
   state.stat;
   (size,isRefIndexed) -> state.QallocIndexed
#)
---callPrim:descriptor---
(#
do codes.prim -> emit; op -> emit;
   (if op 
    // prim.attach then 
       ' ' -> out.put;
       'D' -> out.put;
       'D' -> emit 
    // prim.fork // prim.cmpAndSwap // prim.thisCore then
       (* perhaps more prims require C-mode, 
        * but we are probably shure with the above ones
        *)
       true -> descs.onlyCinterpreter;
   if);
    (if op
    // prim.put then 
        (if state.stacks.vTopKind = state.valueKind then
            state.stacks.vPop -> state.emitPutConst (* OBS! the argument may be a const or a var - check vKind *)
        else 
           state.stacks.vPop -> state.emitPutReg
        if)
    // prim.asString then
       (*'___%prim: asString' -> putline*)
    else
         '\n; !!!! missing prim: ' -> out.puttext; op -> out.putint;
    if) 
#)
---callPrim2:descriptor---
(#
do codes.prim2 -> emit; op -> emit; arg -> emit
#)
---binaryOp:descriptor---
(#
do (if operator
    // codes.plus then codes.plus -> state.binOpImm 
    // codes.minus then codes.minus -> state.binOpImm
               // codes.uminus then 'uminus' -> emitOp
    // codes.mult then  codes.mult -> state.binOpReg
               // codes.rdiv then 'div' -> emitOp (* not used? *)
