ORIGIN 'objectcode';
INCLUDE 'ARM_instructions';
INCLUDE 'qobjectcodeBody'
---ObjectCode_init:descriptor---
(#
do true -> isArm;
   out[] -> state.ins.init;
   state.genHeading;
   state.gen_qAllocindexed;
   state.gen_putc;
   state.gen_putObj;
   state.gen_putt;
#)
---ObjectCode_state:descriptor---
(# trace: (# exit traceInvoke #);
   com:
      (# S: ^text
      enter S[] do (*'\n\t\t\t; ' -> out.puttext; S[]-> out.puttext;*) 
         fcom(#do S[]->TT #); inner
      #);
   missing:
      (# msg: ^Text
      enter msg[]
      do '\n; OBS! MISSING implementation: '->out.puttext; msg[] -> out.puttext
      #);
   x0: (#exit 0 #);
   x1: (#exit 1 #);
   x2: (#exit 2 #);
   x29: (#exit 29 #);
   lr: (#exit 30 #);
   sp: (#exit 31 #); (* apparently not really*)
   ins: @ ARM_instructions;
   gen_qAllocindexed:
      (*                      fields[1], [8] = origin, but perhaps not used?
       *     fields[arrayStrucSize - 1],[16] = range,  in 16-bit words
       *         fields[arrayStrucSize],[24] = size,   in 16-bit words
       *     fields[arrayStrucSize + 1],[32] = rep[1]
       *                      arrayStrucSize = 3 - defined in objectImage
       *                            bytRange = (arrayStrucSize + range * size) * 8
       * x0 = range, x1 = dInx, x2 = size
       *)
      (# cr: @ integer
      do '\n.globl _qAllocIndexed' -> out.puttext;
         '\n_qAllocIndexed:' -> out.puttext; 
         (for i: 3 repeat reg.getV for); (* alloc x0,x1,x2 *)
         (x2,x29,arrayStrucSize * 8) -> ins.strD; (* store size *)
         (x0,x29,(arrayStrucSize - 1) * 8) -> ins.strD; (* store range *)

         (x0,x0,x2) -> ins.mulR;  (* range * size -> range *) 
         (x0,x0,arrayStrucSize) -> ins.addI; (* arrayStrucSize + range -> range *)
         8 -> pushConst; stacks.vPop -> cr;
         (x0,x0,cr) -> ins.mulR;   (* range * 8 -> range *)
         

         (reg.refBase,x29) -> ins.movR; (* return start in refBase *)
         (29,29,x0) -> ins.addR;   (* allocate array *)
          '\n\t ret' -> out.puttext;
      #);
   gen_qAllocTextObj:
      (# S,Sx,L: ^Text; r: @integer
      enter(S[],SX[])
      do '\n.section __DATA,__data\n' -> out.puttext;
         'STR' -> L[]; STR_lab + 1 -> STR_lab -> L.putint;
         L[] -> out.puttext; ':'-> out.put;
         '\n\t'->out.puttext; '.asciz "' -> out.puttext; S[] -> out.puttext; '"' -> out.put;
         '\n.text' -> out.puttext;
         (x0,Sx.length + 3) -> ins.movI;
         (x2,1) -> ins.movI;   (* x2 is not alloacted here *)
         '_qAllocIndexed' -> ins.blLab;
         reg.getV -> r;
         (r,Sx.length) -> ins.movI;
         (r,reg.refBase, (arrayStrucSize - 1) * 8) -> ins.strD;
         r -> reg.freeV;
         (for i: Sx.length repeat
              (x0,i -> Sx.inxGet) -> ins.movI;
              (x0, reg.refBase, i) -> ins.str
         for);
         (x0,reg.refBase) -> ins.movR; (* Temporary hack since pt only x0 works *)
         x0 -> stacks.rPush
      #);
   computeArrayIndex:
      (* copmpute arrayStrucSize + (inx - 1) * size + size + 1 -> inx; 
       *               fields[0] = not used
       *               fields[1] = origin? 
       *               fields[2] = range
       *  fields[arrayStrucSize] = size       <- arrayStrucSize 
       *               fields[1] = 1st element
       *                ...
       *         fields[inx - 1] =  <- arrayStrucSize + (inx - 1) * size
       *             fields[inx] =  <- element indexed
       *         fields[inx + 1] =  <- computed inx
       *                ...
       * return inx * 8
       *)
      (# size,Xr,inxR,sizeR,valR,c8: @integer
      enter size
      do state.stat; (* xR and inxR allocated V/R registers, and og V/R stack *)
         state.stacks.rPop -> Xr; state.stacks.vPop -> inxR;
         (inxR,inxR,1) -> state.ins.subI;   (* inx - 1 -> inx *)
         size -> pushConst; state.stacks.vPop -> sizeR;
         (inxR,inxR,sizeR) -> state.ins.mulR; (* inx * size -> inx *)
         (inxR,inxR,arrayStrucSize + size + 1) -> state.ins.addI; (* arrayStrucSize + size + 1 -> inx *)
         sizeR -> state.reg.freeV;
         size * 8 -> pushConst; state.stacks.vPop -> c8;
         (inxR,inxR,c8) -> state.ins.mulR;
         c8 -> state.reg.freeV;
         'END:computeArrayIndex' -> com;
         state.stat;
      exit(Xr,inxR)
      #); 
   mkODname:
      (# n: ^Text; T: ^text
      enter n[]
      do (if (n[] -> mkOprName -> T[]) = none then
             '' -> T[];
             n.scanAll(#do (if ch = ':' then '$' -> T.put else ch -> T.put if) #)
         if)
      exit T[]
      #);
   mkOprName:
      (# n: ^text; T: ^text
      enter n[]
      do (if true 
         // '+' -> ((1,1)->n.sub).equal then '$PLUS' -> T[]; (2,n.length)->n.sub -> T.append;
         // '-' -> ((1,1)->n.sub).equal then '$MINUS' -> T[]; (2,n.length)->n.sub -> T.append;
         // '*' -> ((1,1)->n.sub).equal then '$MULT' -> T[]; (2,n.length)->n.sub -> T.append;
         // '/' -> ((1,1)->n.sub).equal then '$DIV' -> T[]; (2,n.length)->n.sub -> T.append;
         // '=' -> ((1,1)->n.sub).equal then '$EQ' -> T[]; (2,n.length)->n.sub -> T.append;
         // '<=' -> ((1,2)->n.sub).equal then '$LE' -> T[]; (3,n.length)->n.sub -> T.append;
         if)
      exit T[]
      #);
      
   mkVDTentryName:
      (# T: ^text
      do 'VDT_'-> T[]; thisName[] -> mkODname-> T.append
      exit T[]
      #);
   gen_allocTemplate:
      (# descNo,vInxSize,rInxSize,objSize: @integer; isObj: @boolean; N: ^Text; 
      enter(descNo,isObj,vInxSize,rInxSize,objSize)
      do descs.OD[descNo].name[] -> mkODname -> N[];
         '\n.globl _' -> out.puttext; N[] -> out.puttext;
         '\n_' -> out.puttext; N[] -> out.puttext; ':' -> out.put;
         (* allocate object on heap - missing check for out-of-memory 
          * x29 points to next free area of heap
          *)
         '\n\t str     lr, [x29, #0]' -> out.puttext;
         '\n\t str     x28, [x29, #8]' -> out.puttext;
         (mkVDTentryName,28) -> ins.getAdr;
         '\n\t str     x28, [x29, #16]' -> out.puttext;
         '\n\t mov     x28, x29' -> out.puttext; 
         '\n\t add     x29, x29, ' -> out.puttext; '#' -> out.puttext; (objSize + 1) * 8 + 24 -> out.putint;
      #);
   QallocIndexed:
      (* op2 -> descInx; op1 -> size; op1 -> isRIndexed;
       * a superflous thisObj is pushed by compiler should be eliminated 
       * thisStack.rpop -> X[]; (* origin * )
       * thisStack.vpop -> dinx;
       * thisStack.vpop -> rangee;
       * X[],descInx,size,rangee,isRindexed) -> QallocIndexed
       * arrayStrucSize + range * size --> alloc
       *   fields[1] = origin, but perhaps not used?
       *   fields[arrayStrucSize - 1] = range
       *   fields[arrayStrucSize]     = size
       *   fields[arrayStrucSize + 1] = rep[1]
       *   ...
       * rangee -> fields[arrayStrucSize - 1];
       * size -> fields[arrayStrucSize];
      *)
      (# size,isRIndexed,sizeR,rangeR,dInxR,calleeR,cr,origin: @ integer
      enter(size,isRIndexed)
      do reg.getR -> calleeR;  state.stacks.rPop -> origin; (* not used *)
         stacks.vPop -> dInxR;  (* x1, not used ?*)
         stacks.vPop -> rangeR; (* x0 *)
         reg.getV -> sizeR;     (* x2 *)
         (if false then 
            (rangeR,RangeR,sizeR) -> ins.mulR;  
            (sizeR,size) -> ins.movI;
            (rangeR,RangeR,arrayStrucSize) -> ins.addI;
            8 -> pushConst; stacks.vPop -> cr;
            (rangeR,rangeR,cr) -> ins.mulR;
            (rangeR,regKind) -> stacks.vPush;  (* range of array to be allocated *)
         if);
         '\n\t bl _qAllocIndexed' -> out.puttext;
         (if false then
            (rangeR,reg.refBase,arrayStrucSize - 1 - 2) -> ins.str; (*adjustment for str *)
            (sizeR,reg.refBase,arrayStrucSize - 2) -> ins.str;
            cr -> reg.freeV; sizeR -> reg.freeV; dInxR -> reg.freeV;
         if);
         (if false then
            '\n\t\t; ' -> out.puttext; sizeR -> out.putint; ' ' -> out.put;
             dinxR -> out.putint; ' ' -> out.put; rangeR -> out.putint; ' ' -> out.put;
         if);
         sizeR -> state.reg.freeV; dInxR -> reg.freeV; rangeR -> reg.freeV; 
         calleeR -> stacks.rPush; origin -> state.reg.freeR;
         state.stat
      #);
   labs: @
      (# labNo,localLabNo: @integer; thisLab: ^Text;
         new: 
            (# 
            do labNo + 1 -> labNo; 
               'L' -> thisLab[]; labNo -> thisLab.putint; '_'->thisLab.put
            #);
         newLocal:
            (#
            do localLabNo + 1 -> localLabNo
            exit localLabNo
            #);
         local:
            (# l: @integer; lab: ^text
            enter l
            do thisLab.copy -> lab[]; 'L'->lab.put; l -> lab.putint
            exit lab[]
            #);
         def:
            (# lab: ^Text
            enter lab[]
            do '\n'->out.put; lab[] -> out.puttext; ':'->out.put
            #)
      #);
   RegisterHandler:
      (# valueBase: (#exit 0 #);
         refBase: (#exit 15 #);
         thisObj: (#exit 28 #);
         lr: (#exit 30 #);
         refRtnBusy: @Boolean;
         vRegNo,rRegNo: @integer;
         init: (# do valueBase -> vRegNo; refBase -> rRegNo #);
         getV:
            (# rn: @integer
            do vRegNo -> rn;
               (if (vRegNo + 1 -> vRegNo) >= refBase then
                  '\n;!!!! ERROR:value register overflow'-> out.putline 
               if);
               rn -> tmp.addV
            exit rn
            #);
         freeV:
            (# rn: @integer
            enter rn
            do (if rn = (vRegNo - 1) then 
                  vRegNo - 1 -> vRegNo;
                  rn -> tmp.freeV
               else
                  '\n;!!!! ERROR:register mismatch: ' ->out.puttext; rn -> out.putint; ','->out.put; vRegNo->out.putint;
            if)#);
         getR:
            (# rn: @integer
            do rRegNo -> rn;
               (if (rRegNo + 1 -> rRegNo) >= thisObj then 
                  '\n:!!!! ERROR:reference register overflow'-> out.putline
               if);
               rn -> tmp.addR
            exit rn
            #);
         freeR:
            (# rn: @integer
            enter rn
            do (if rn = (rRegNo - 1) then 
                  rRegNo - 1 -> rRegNo;
                  rn -> tmp.freeR
               else
                  (if true
                  // (rn = refBase) and refRtnBusy then
                     (* refRtnReg = refBase*)
                  // rn <> thisObj then
                    '\n;!!!! ERROR:register mismatch: '->out.puttext; rn->out.putint; ','->out.put; rRegNo->out.putint;
            if)if)#);
         stat: 
            (# 
            do (if true then
                  'vN:' -> out.puttext; vRegNo -> out.putint; 
                  ' rN: ' -> out.puttext; rRegNo -> out.putint 
            if)#);
         print: (# rn: @integer enter rn do 'x'->out.put; rn -> out.putint #)
      do
      #);
   valueKind: (# exit 0 #);
   regKind: (# exit 1 #);
   StackHandler:
      (# init: (# do 0 -> vTop -> rTop #);
         vStack: [8] @integer; vTop: @integer;
         vKind: [8] @ integer; (* 0: const; 1: register *)
         rStack: [8] @integer; rTop: @integer;
         vPush: 
            (# v,t: @integer 
            enter(v,t) 
            do (if (vTop + 1 -> vTop) > vStack.range then 
                  vStack.range -> vStack.extend; vKind.range -> vKind.extend;
               if);
               v -> vStack[vTop]; t -> vKind[vTop];
            #);
         vPop: 
            (# v: @integer 
            do (if vTop > 0 then
                   vStack[vTop] -> v; vTop - 1 -> vTop 
               else
                 'vStack:underflow:'->com;
                 27 -> v 
               if) 
            exit v 
            #);
         vTopKind: (# k: @integer do (if vTop > 0 then vKind[vTop] -> k else 27 -> k if) exit k #);
         rPush: 
            (# v: @integer
            enter v 
            do (if (rTop + 1 -> rTop) <= rStack.range then
                  v -> rStack[rTop]
               else 
                  '\n; !!! ERROR:rStack overflow:'->out.putline 
            if)#);
         rPop: 
            (# r: @integer 
            do (if (rTop > 0) and (rTop <= 8) then rStack[rTop] -> r; rTop - 1 -> rTop
               else
                 'rStack:underflow:'->com;
                 27 -> r
               if) 
            exit r 
            #);
         rswap:
            (# inx,r1,r2: @integer
            enter inx
            do (if inx > 0 then
                   'rswap: inx > 0'->missing
               else
                  rPop -> r1; rPop -> r2;
                  r1 -> rPush; r2 -> rPush
            if)#);
         stat: 
            (#
            do 'vS: ' -> out.puttext;
               (for i: vTop repeat 
                  (if vKind[i] = valueKind then 'V:'->out.puttext else 'R:'->out.puttext if);
                  vStack[i] -> out.putint; ' ' ->out.put
               for);
               'rS: ' -> out.puttext;
               (for i: rTop repeat rStack[i] -> out.putint; ' ' ->out.put for)
      #)#);
   stat: (# do ''->com; stacks.stat; reg.stat #);
   reg: @RegisterHandler; stacks: @StackHandler;
   tmp: @
      (# init: (#do 'tmp.init:'->com; initInvStack #);
         store:
            (# di: @integer
            enter di
            do 'tmp.store:tmpTop:'->com(#do tmpTop -> out.putint #);
               state.stat; display;
               true -> noDeAlloc;
               (if tmpTop > 0 then
                  storeVtmp;
                  storeRtmp;
               if);
               false -> noDeAlloc;
               di -> newTmpRecord;
               state.stat
            #); 
         getVtmp:
            (# tr: @integer
            do nxtVtmp -> tr;
               nxtVtmp + 1 -> nxtVtmp
            exit tr
            #);
         getRtmp:
            (# rr: @integer
            do nxtRtmp -> rr;
               nxtRtmp + 1 -> nxtRtmp
            exit rr
            #);
         storeVtmp:
            (# rv: @integer
            do 'storeVtmp:'->com(#do tmpStack[tmpTop].vRegNo ->out.putint #);
               (for i: tmpStack[tmpTop].vRegNo repeat
                  'store:'->com(#do i->out.putint #);
                  (if stacks.vTopKind = regKind then 
                     stacks.vPop -> rv;
                     (rv,reg.thisObj,getVtmp) -> ins.str;
                     rv -> reg.freeV;
                     vTmpSaved + 1 -> vTmpSaved;
                  else
                     '\n; **** ERROR: storeVtmp:constant on vStack:' ->out.puttext;
                     i -> out.putint;
                     stacks.vpop -> rv
            if)for)#);
         storeRtmp:
            (* restore 1:tmpStack[tmpTop].rRegNo *)
            (# rr: @integer; 
            do (for i: tmpStack[tmpTop].rRegNo repeat
                  stacks.rPop -> rr;
                  (rr,reg.thisObj,getRtmp) -> ins.str;
                  rr -> reg.freeR;
            for)#);
         restoreFromTmp:
            (# r: @integer
            do (if tmpTop > 0 then tmpTop - 1 -> tmpTop if); (* appears strange *)
               tmp.display;
               (if tmpTop > 0 then
                  'restoreFromTmp:vRegNo:'->com
                  (#do tmpStack[tmpTop].vRegNo ->out.putint;
                     ' rRegNo:'->out.puttext; tmpStack[tmpTop].rRegNo ->out.putint
                  #);
                  (for i: tmpStack[tmpTop].vRegNo repeat
                     reg.getV -> r;
                     (r,regKind) -> stacks.vPush;
                     (r,reg.thisObj,nxtVtmp - 1 -> nxtVtmp) -> ins.ldr;
                  for);
                  (for i: tmpStack[tmpTop].rRegNo repeat
                     reg.getR -> r;
                     r -> stacks.rPush;
                     nxtRtmp - 1 -> nxtRtmp;
                     (if (i > 1) then
                        (r,reg.thisObj,nxtRtmp) -> ins.ldr;
                     else
                        nxtRtmp -> tmpStack[tmpTop].refBaseTmp
               if)for);
               tmp.display;
               stat
            if)#);
         restoreOrigin:
            (* for a nested invocation, restore origin, if this invoke is part of a parameter list
             *    foo(e1,bar(e2,e3),e4)
             *                     ^restore origin for foo
             * tmpTop  > 0: we are in a nested parameter-list
             * refBaseTmp > 0: the enclosing ptn (foo) has an origin
             * NEW: always restore x15 after return value has been fetched
             *)
            (#
            do 'restoreOrigin:'->
                  com(#do tmpTop->out.putint; ' '->out.put;
                          (if tmpTop > 0 then tmpStack[tmpTop].refBaseTmp -> out.putint if)
                   #); 
               (if (tmpTop > 0) and (tmpStack[tmpTop].refBaseTmp > 0) then
                  (reg.refBase,reg.thisObj,tmpStack[tmpTop].refBaseTmp) -> ins.ldr
            if)#);
         tmpStack: [10] ^tmpRecord; tmpTop: @integer;
         noDeAlloc: @Boolean;
         initInvStack:
            (#
            do 1 -> tmpTop;
               'initInvStack:'->com(#do tmpTop -> out.putint #);
               tmpRecord -> tmpStack[tmpTop][];
            #);
         superAdd:
            (# topInv: ^tmpRecord
            do (if (tmpTop = 0) or noDealloc then leave superAdd if);
               'tmp.superAdd:'->com(#do tmpTop->out.putint #);
               display;
               tmpStack[tmpTop][] -> topInv[];
               inner superAdd
            #);
         addV: superAdd
            (# r: @integer
            enter r
            do topInv.vRegNo + 1 -> topInv.vRegNo;
            #);
         addR: superAdd
            (# r: @integer
            enter r
            do topInv.rRegNo + 1 -> topInv.rRegNo;
            #); 
         superFree:
            (# topInv: ^tmpRecord
            do (if (tmpTop = 0) or noDeAlloc then leave superFree if);
               'tmp.superFree:'->com(#do tmpTop->out.putint #);
               display;
               tmpStack[tmpTop][] -> topInv[];
               inner superFree
            #);
         freeV: superFree
            (# r: @integer
            enter r
            do topInv.vRegNo - 1 -> topInv.vRegNo;
            #);
         freeR: superFree
            (# r: @integer
            enter r
            do topInv.rRegNo - 1 -> topInv.rRegNo;
            #);
         newTmpRecord:
            (# di: @integer
            enter di
            do (if (tmpTop + 1 -> tmpTop) > tmpStack.range then tmpStack.range -> tmpStack.extend if);
               'newTmpRecord:'->com(#do di->out.putint; ' '->out.put; tmpTop -> out.putint #);
               di -> tmpRecord -> tmpStack[tmpTop][];
               (if objDescTables.ODTable[di].hasOrigin then
                  1 -> tmpStack[tmpTop].refBaseTmp
            if)#);
         tmpRecord:
            (# descInx, (* current active invocation *) 
               vRegNo, (* no of busy value registers*)
               rRegNo, (* no of busy ref registers *) 
               refBaseTmp: @integer 
                  (* the address of the tmp holding reg.refBase
                   * may be origin or a parameter if obj has no origin
                   *)
            enter descInx
            exit this(tmpRecord)[]
            #);
         display:
            (# topInv: ^tmpRecord
            do (if tmpTop = 0 then 'tmp:tmpTop = 0'->com if);
               (for i: tmpTop repeat
                  tmpStack[i][] -> topInv[];
                  'TMP:'->com
                     (#
                     do i -> out.putint; ' di:'->out.puttext; topInv.descInx->out.putint;
                        ' vRno:' -> out.puttext; topInv.vRegNo -> out.putint;
                        ' rRNo:' -> out.puttext; topInv.rRegNo -> out.putint;
                        ' refBaseTmp:' -> out.puttext; topInv.refBaseTmp -> out.putint;
            #)for)#)
      #);
   newVDT:
      (# N: ^text; 
      enter N[]
      do L: (if thisDescInx > vdtTable.range then
               vdtTable.range -> vdtTable.extend;
               (*descInx - vdtTable.range + 50 -> vdtTable.extend*) restart L
         if);
         &VDTentry[] -> vdtTable[thisDescInx][] -> thisVDTentry[];
         thisName[] -> mkODname -> thisVDTentry.ODid[];
      #);
   vdtTable: [4] ^ VDTentry; thisVDTentry: ^VDTentry;
 VDTentry:
   (# ODid: ^text; bindings: [8] @integer; isInner: [8] @Boolean;  vdtTop: @integer;
      mkVDT:
         (# mkLab:
              (#
              do (if not labDone then 
                    '\n\t.align 3' -> out.puttext;
                     '\n\nVDT_' -> out.puttext; ODid[] -> out.puttext; ':' -> out.puttext;
                 if);
                 true -> labDone
              #);
            labDone: @Boolean
         do mkLab;
            '\n\t.quad ' -> out.puttext; (vdtTop + 1) * 8 -> out.putint; (* pointer to ODid *)
            (for i: vdtTop repeat
               (if bindings[i] > 0 then
                  '\n\t.quad ' -> out.puttext; 
                  (if isInner[i] then 
                     vdtTable[bindings[i]].ODid[] -> out.puttext; '_DO' -> out.puttext
                  else
                     '_' -> out.put;
                     vdtTable[bindings[i]].ODid[] -> out.puttext;
                  if)
               else
                  '\n\t.space 8' -> out.puttext
            if)for);
            '\n\t.asciz "' -> out.puttext; ODid[] -> out.puttext; '"' -> out.put
         #);
      print:
         (#
         do '---'->puttext; ODid[] -> putline;
            (for i: vdtTop repeat
                 (if bindings[i] > 0 then
                     i -> putint; ':'->put; bindings[i] -> putint;
                     newline
         if)for)#)
   #);
 addVDT:
    (# inx,bDI: @integer; isInn: @Boolean;
    enter(inx,bDI,isInn)
    do (if inx > thisVDTentry.bindings.range then 
           (inx - thisVDTentry.bindings.range) + 10 -> thisVDTentry.bindings.extend
       if);
       (*'**** addVDT:'->puttext; inx -> putint; ' ' -> put; bDI->putint; ' ' -> put; isInn->putBoolean; newline;*)
       (if inx > thisVDTentry.vdtTop then inx -> thisVDTentry.vdtTop if);
       bDI -> thisVDTentry.bindings[inx]; isInn -> thisVDTentry.isInner[inx]
    #);
 printVDT:
    (#
    do (for i: vdtTable.range repeat
            (if vdtTable[i][] <> none  then
                vdtTable[i].print
            if)
       for);
    #);
 mkVDTtables:
    (#
    do '\n\n; **** VDT tables:' -> out.puttext;
       '\n.section __DATA,__data' -> out.puttext;
       '\n.align 3' -> out.puttext;
       (for i: vdtTable.range repeat
            (if vdtTable[i][] <> none  then
                vdtTable[i].mkVDT
    if)for)#);
getNoOfParam:
   (* NOT sufficient for compound values - must need size *)
   (# theOD: ^objDescTables.ODentry; di,vN,rN: @integer
   enter di
   do 'getNoOfParam:' -> com;
      (if objDescTables.ODtable[di][] = none then
          '\n; !!!! getNoOfParam:No ODtable:descInx:'->puttext; di -> out.putint;
         leave getNoOfParam
      if);
      (objDescTables.ODtable[di][]->theOD[]).asText -> out.puttext;
      (for i: theOD.pTop repeat 
         (if theOD.params[i]
         // 0 then vN + 1 -> vN
         // 1 then 
         // 2 then rN + 1 -> rN
         // 3 then
      if)for);
      (if theOD.hasOrigin then rN + 1 -> rN if)
   exit(vN,rN)
   #);
allocParameters:
   (* NOT sufficient for compound values - must need size *)
   (# theOD: ^objDescTables.ODentry
   do 'allocPar:' -> com;
      (if objDescTables.ODtable[thisDescInx][] = none then
          '!!!! No ODtable:descInx:'->puttext; thisDescInx -> out.putint; 
          ' '->put; thisName[] -> out.putline;
         leave AllocParameters
      if);
      (if reg.vRegNo > 0 then
         '\n; ERROR: value parameter registers busy'->out.puttext;
         '\n!!!! ERROR: value parameter registers busy: '-> puttext; reg.vRegNo -> putint; 
         ' ' -> put; thisClassid[] -> putline;
      if);
      (if reg.rRegNo > reg.refBase then
         '\n; ERROR: ref parameter registers busy'->out.puttext;
         '\n!!!! ERROR: ref parameter registers busy: '->out.puttext; reg.rRegNo -> putint; 
         ' ' -> put; thisClassid[] -> putline;
      if);
      (objDescTables.ODtable[thisDescInx][]->theOD[]).asText -> out.puttext;
      (for i: theOD.pTop repeat 
         (if theOD.params[i]
         // 0 then (reg.getV,regKind) -> stacks.vPush
         // 1 then 
         // 2 then reg.getR -> stacks.rPush;
         // 3 then
      if)for);
      (if theOD.hasOrigin then reg.getR -> stacks.rPush if)
   #);
deAllocParameters:
   (# theOD: ^objDescTables.ODentry; descNo: @integer
   enter descNo
   do 'deAllocPar:'->com; descNo->out.putint; 
      ' vTmpSaved:'->out.puttext; vTmpSaved->out.putint; (* not used ? *)
      (if objDescTables.ODtable[descNo][] = none then
         ' ODtable[' -> out.puttext; descNo->out.putint; '] is none'->out.puttext;
         leave deAllocParameters
      if);
      true -> tmp.noDeAlloc;
      (objDescTables.ODtable[descNo][]->theOD[]).asText -> out.puttext;
      ' theOD.pTop:'->out.puttext; theOD.pTop->out.putint;
      (for i: theOD.pTop repeat
         (if theOD.params[i]
         // 0 then stacks.vPop -> reg.freeV
         // 1 then
         // 2 then stacks.rPop -> reg.freeR
         // 3 then
         if);
         stat
      for);
      (if theOD.hasOrigin then stacks.rPop -> reg.freeR if);
      (* OBS! in general freeV/freeR should count down in tmpRecord
       * BUT freeV/freeR above in deAlloc should not
       *) 
      tmp.restoreFromTmp;
      false -> tmp.noDealloc;
   #); 

   emitOp:
     (# op: @integer
     enter op
     do (if op 
         // codes.plus then '\n\t add '-> out.puttext
         // codes.minus then '\n\t sub '-> out.puttext
         // codes.mult then '\n\t mul '-> out.puttext
         // codes.idiv then '\n\t sdiv '-> out.puttext
        if);
     #);
   doBinOp:
      (# vl,op,vr: @integer
      enter(vl,op,vr)
      do (if op
          // codes.plus then vl + vr -> vl
          // codes.minus then vl - vr -> vl 
          // codes.mult then vl * vr -> vl
          // codes.modd then vl mod vr  -> vl
          // codes.idiv then vl div vr -> vl
            (* do we ever come here ? *)
            // codes.eq then (if vl = vr then 1 -> vl else 0 -> vl if)
            // codes.lt then (if vl < vr then 1 -> vl else 0 -> vl if)
            // codes.le then (if vl <= vr then 1 -> vl else 0 -> vl if)
            // codes.gt then (if vl > vr then 1 -> vl else 0 -> vl if)
            // codes.ge then (if vl >= vr then 1 -> vl else 0 -> vl if)
            // codes.ne then (if vl <> vr then 1 -> vl else 0 -> vl if)
          // codes.req then (if vl = vr then 1 -> vl else 0 -> vl if)
         if)
      exit vl
      #);
   doRelOp:
      (# vl,vr: @integer; op: ^text
      enter(vl,op[],vr)
      do (if true
            // 'eq ' -> op.equal then (if vl = vr then 1 -> vl else 0 -> vl if)
            // 'lt' -> op.equal then (if vl < vr then 1 -> vl else 0 -> vl if)
            // 'le' -> op.equal then (if vl <= vr then 1 -> vl else 0 -> vl if)
            // 'gt ' -> op.equal then (if vl > vr then 1 -> vl else 0 -> vl if)
            // 'ge ' -> op.equal then (if vl >= vr then 1 -> vl else 0 -> vl if)
            // 'ne ' -> op.equal then (if vl <> vr then 1 -> vl else 0 -> vl if)
            // 'req ' -> op.equal then (if vl = vr then 1 -> vl else 0 -> vl if)
         if)
      exit vl
      #);
   binOpImm: (* binary operator with posble immediate argument *)
      (# op,vr,vl,r: @integer
      enter op
      do 'binOpImm:'->state.com;
         (if stacks.vTopKind = valueKind then 
                stacks.vPop -> vr; 'vr:value'->out.puttext; vr -> out.putint; 
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl; 'vl:value'->out.puttext; vl -> out.putint; 
                    (vl,op,vr) -> doBinOp -> vl;
                    (vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    ':vl:reg:'->out.puttext; vl -> out.putint; 
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ',#'->out.puttext; vr -> out.putint; 
                    (vl,regKind) -> stacks.vPush
                if)
         else
                'vr:reg:'->out.puttext; vr -> out.putint;
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                     ':vr:value: missing: '->out.puttext; vr -> out.putint; 
                else (* operands in registers *)
                   stacks.vPop -> vl; 
                   ':vl:reg:'->out.puttext; vl-> out.putint;
                   op -> emitOp;
                   vl -> reg.print; ','->out.put; vl -> reg.print; ',' -> out.put; vr -> reg.print;
                   vr -> reg.freeV;
                   (vl,regKind) -> stacks.vPush
         if)if)
      #);
   binOpReg: 
      (* binary operator with register argument, mult and other can only take register arguments *)
      (# op,vr,vl,r: @integer
      enter op
      do state.stat;
         'binOpReg'->state.com;
         (if stacks.vTopKind = valueKind then 
                '\nvTopKind=valueKind - should not happen?? May happen?' -> puttext;
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl;
                    (vr + vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    vr -> pushConst; stacks.vPop -> vr;
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ','->out.put; vr ->reg.print;
                    vr -> reg.freeV;
                    (vl,regKind) -> stacks.vPush
                if)
         else (* vr in register *)
                'vr:reg:'->out.puttext; vr -> out.putint;
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                    vr -> pushConst; stacks.vPop -> vr;
                    stacks.vPop -> vl;
                    '\n;  This does not work' -> out.puttext
                else
                    'vl:reg:'->out.puttext; vl -> out.putint;
                    stacks.vPop -> vl;
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ','->out.put; vr ->reg.print;
                    vr -> reg.freeV;
                    (vl,regKind) -> stacks.vPush
         if)if)
      #);
   emitMod:
      (# vr,vl,vx,vy: @integer
      do (* '\n;\t Goal: Calculate X3 = X0 % X1'
             * '\n\t UDIV X2, X0, X1        // 1. Get Quotient: X2 = X0 / X1'
             * '\n\t MSUB X3, X2, X1, X0    // 2. Get Remainder: X3 = X0 - (X2 * X1)' -> out.puttext;
             *)
            state.stat;
            'emitMod:'->state.com;
            (if stacks.vTopKind = valueKind then 
                stacks.vPop -> vr; 'vr:value:NOT OK'->out.puttext; vr -> out.putint; 
                (if stacks.vTopKind = valueKind then 
                    stacks.vPop -> vl; 'vl:value:NOT OK'->out.puttext; vl -> out.putint; 
                    (vl mod vr,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    ':vl:reg:NOT OK'->out.puttext; vl -> out.putint; 
                    (*op -> emitOp;*)
                    vl -> reg.print; ','->out.put; vl -> reg.print; ',#'->out.puttext; vr -> out.putint; 
                    (vl,regKind) -> stacks.vPush
                if)
             else
                stacks.vPop -> vr;
                'vr:reg:'->out.puttext; vr -> out.putint;
                (if stacks.vTopKind = valueKind then
                     ':vr:value: missing: '->out.puttext; vr -> out.putint; 
                else (* operands in registers *)
                   stacks.vPop -> vl; 
                   ':vl:reg:'->out.puttext; vl-> out.putint;
                   reg.getV -> vx; 
                   (vx,vl,vr) -> ins.udiv;
                   '\n\t MSUB ' -> out.puttext;
                   vl -> reg.print; ',' -> out.put; vx -> reg.print; ','->out.put; vr -> reg.print; ','->out.put; vl->reg.print; 
                   vx -> reg.freeV;  vr -> reg.freeV; 
                   (vl,regKind) -> stacks.vPush
            if)if)
      #);
   emitCmpOp:
      (* cmp     x0, x1
      * cset    x2, lt         // x2 = 1 if x0 < x1, otherwise 0
      *)
      (# op: ^text; vr,vl: @integer
       enter op[]
      do state.stat;
            'emitCmpOp:'->state.com; 
            (if stacks.vTopKind = valueKind then 
                stacks.vPop -> vr; 'vr:value'->out.puttext; vr -> out.putint; 
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl; 'vl:value'->out.puttext; vl -> out.putint; 
                    (vl,op[],vr) -> doRelOp -> vl;
                    (vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else
                    stacks.vPop -> vl
                if)
             else
                stacks.vPop -> vr; 'vr:reg'->out.puttext; vr -> out.putint; 
                (if stacks.vTopKind = valueKind then
                    vl -> pushConst; stacks.vPop -> vr
                else
                    stacks.vPop -> vl
                if);
            if);
            state.stat;
            (vl,vr) -> ins.cmp;
            vr -> reg.freeV;
            (vl,op[]) -> ins.cset;
            (vl,regKind) -> stacks.vPush
       #);
   emitPutConst:
      (# ch: @char
      enter ch
      do '\n\t mov x0, #' -> out.puttext; ch -> out.putint;
         '\n\t bl _putc\n' -> out.puttext;
      #);
   invoke:
      (# N: ^Text; off,descNo,staticOff,r: @integer; useRtnVal: @boolean
      enter(N[],descNo,off,useRtnVal,staticOff)
      do (* vStack: x0,x1,x2;  rStack r1,r2, where r1 is origin *)
         state.stat; state.tmp.display;
         '\n\t bl _'-> out.puttext; N[] -> mkODname -> state.mkODname -> out.puttext;
         state.stat;
         descNo -> state.deAllocParameters; (* and restoreTmp *)
         'END:invoke'->com;
         state.stat;
         state.tmp.display;
         (* x15 refer to the callee after it has returned
          * we use x15 to fetch possible return value(s) later
          * we circumvent the allocation mechanism using getR/freeR using refRtnBusy
          *)
         (if useRtnVal then
            reg.getR -> r;
            'invoke:push: x15 to: x'->com(#do r->out.putint #);
            (if r <> 15 then (r,15) -> ins.movR if);
            r -> stacks.rPush; true -> reg.refRtnBusy; 
            state.stat
         if);
         (if staticOff > 0 then
            'staticOff:'->com(#do staticOff->out.putint #);
            (15,reg.thisObj,staticOff) -> ins.str
         if)
      #);
   invokev:
      (# r,dinx,r2: @integer; isInner: @boolean; L: ^Text
      enter(r,dinx,isInner)
      do (* r = callee *) 
         (if false then
             (state.x0,r) -> state.ins.movR; (* must save x0 *)
             (25,r) -> ins.movR; (* save r *)
             '_putObj' -> ins.blLab;
             (r,25) -> ins.movR; (* restore r *)
         if);
         state.reg.getV -> r2;
         '\n\t ldr ' -> out.puttext; r2 -> state.reg.print; 
         ', [' -> out.puttext;  r -> state.reg.print; ',#16]' -> out.puttext;
         (* r2 = callee.VDT *)
         '\n\t ldr ' -> out.puttext; r2 -> state.reg.print; 
         ', [' -> out.puttext;  r2 -> state.reg.print; 
         ',#' -> out.puttext; (dinx) * 8 -> out.putint; ' ]' -> out.puttext;
         r2 -> state.reg.freeV; r -> state.reg.freeR;
         (* r2 = calle.vBinding *)
         (if isInner then
             labs.local -> L[];
             (r2,0) -> ins.cmpI;
             L[] -> ins.bEqZero
         if);
         r2 -> state.ins.blR;
         (if isInner then L[] -> labs.def if);
         reg.getR -> r -> stacks.rPush;
         (if r <> reg.refBase then 
             '\n; ERROR! invokev: did not get refReturnReg' -> out.puttext
         if);
         state.stat
       #);
   emitLab:
         (# lsc: @integer
         enter lsc
         do state.labs.thisLab[] -> out.puttext; lsc -> out.putint;
         #);
   genHeading:
      (#
      do '\n.extern _puts' -> out.puttext;
         '\n.bss' -> out.puttext;
         '\n.align 3' -> out.puttext;

         '\nheap:' -> out.puttext;
         '\n.space 8 * 1014 *1024\n' -> out.puttext;

         '\n.text' -> out.puttext;
         '\n.global _main\n.align 2' -> out.puttext;
         '\n_main:'->out.puttext;
         (sp,sp,16) -> ins.subI;
         (lr,sp,0) -> ins.strD;
         '\n\t adrp    x29, heap@PAGE' -> out.puttext;       (* heapTop = x29 *)
         '\n\t add     x29, x29,heap@PAGEOFF' -> out.puttext;
         '\n\t bl _VM' -> out.puttext;
         (lr,sp,0) -> ins.ldrD;
         (sp,sp,16) -> ins.addI;
         '\n\t ret\n' -> out.puttext;
      #);
   gen_putc:
      (#
      do '\n.text'->out.puttext;
         '\n.global _putc\n\t // write(1, sp, 1)\n' -> out.puttext;
         '_putc:\t // Character is in x0' -> out.puttext;
         '\n\t sub     sp, sp, #16'-> out.puttext;
         '\n\t str     x0, [sp]'->out.puttext;
         '\n\t str     x28, [sp, #8]\n' -> out.puttext;
         '\t mov     x0, #1              // stdout\n'->out.puttext;
         '\t mov     x1, sp              // address of character\n' -> out.puttext;
         '\t mov     x2, #1              // one byte\n'  -> out.puttext;
         '\t mov     x16, #4             // write\n'  -> out.puttext;
         '\t svc     #0x80\n'  -> out.puttext;
         '\t ldr     x28, [sp,#8]\n' -> out.puttext;
         '\t add     sp, sp, #16\n'  -> out.puttext;
         '\t ret\n'  -> out.puttext;
      #);
   gen_putObj:
      (# 
      do '\n.global _putObj\n' -> out.puttext;
         '_putObj:' -> out.puttext;
         '\n\t sub     sp, sp, #16'-> out.puttext;
         '\n\t str     lr, [sp]'->out.puttext;
         '\n\t str     x28, [sp, #8]\n' -> out.puttext;
         (x0,x0,16) -> ins.ldrD; (* VDT *)
         (x1,x0,0) -> ins.ldrD;  (* off to ODid *)
         (x0,x0,x1) -> ins.addR; (* adr of ODid *)
         '_puts' -> ins.blLab ;  (* bl _putS *)
         '\n\t ldr     x28, [sp,#8]' -> out.puttext;
         '\n\t ldr     lr, [sp,#0]' -> out.puttext;
         '\n\t add     sp, sp, #16'  -> out.puttext;
         '\n\t ret\n'  -> out.puttext;
      #); 
   gen_putt:
      (* x1 = adr of text *)
      (# length: @integer
      enter length
      do '\n.global _putt\n\t // write(1, sp, 1)\n' -> out.puttext;
         '_putt:\t\n\t mov     x0, #1          // stdout' -> out.puttext;
         '\n\t mov     x2, #' -> out.puttext; length -> out.putint; (* must be in register at call site *)
         (* perhaps same as putc *)
         '\n\t mov     x16, #4         // write'
         '\n\t svc     #0x80' -> out.puttext;
         '\n\t ret' -> out.puttext
      #);
   emitPutReg:
      (# r: @integer
      enter r
      do (if r > 0 then 
           '\n\t mov x0, x' -> out.puttext; r -> out.putint;
           r -> reg.freeV
         if);
         '\n\t bl _putc' -> out.puttext; r -> state.reg.freeV
      #);
   printString:
      (# S,L: ^Text
      enter S[]
      do '\n.section __DATA,__data\n' -> out.puttext;
         'STR' -> L[]; STR_lab + 1 -> STR_lab -> L.putint;
         L[] -> out.puttext; ':'-> out.put;
         '\n\t'->out.puttext; '.asciz "' -> out.puttext; S[] -> out.puttext; '"' -> out.put;
         '\n.text' -> out.puttext;
         '\n\t adrp    x1, ' ->out.puttext; L[] -> out.puttext; '@PAGE'  -> out.puttext;
         '\n\t add     x1, x1, ' ->out.puttext; L[] -> out.puttext; '@PAGEOFF'  -> out.puttext;
         '\n\t mov     x0, #1          // stdout' -> out.puttext;
         '\n\t mov     x2, #' -> out.puttext; S.length - 1 -> out.putint;
         (* FIX: '-1' because of \n from printTrace *)
         '\n\t mov     x16, #4         // write'
         '\n\t svc     #0x80' -> out.puttext
      #);
   printTrace:
      (# S,T: ^text
      enter S[]
      do '\\n' -> T[]; S.copy -> T.append; '\\n' -> T.append; T[] -> printString; 
      #);
   toSuper:
      (# descInx: @integer; L: ^Text
      enter descInx
      do (if vdtTable[descInx][] <> none then 
            (if false then 
               '**** found super:' -> puttext; vdtTable[descInx].ODid[] -> putline;
            if);
            vdtTable[descInx].ODid.copy -> L[]; '_DO' -> L.append; L[] -> ins.bLab
         else
            '**** did not find super: '->puttext; descInx -> putint; newline;
      if)#);
   thisDescInx: @integer; (* this descInx *)
   thisName: ^Text; (* name of current class *)
   STR_lab: @ integer;
   objSize,vTmpOff,rTmpOff,nxtVtmp,nxtRtmp,vTmpSaved,rTmpSaved: @integer
#)
---innerP:descriptor---
(* Main: Super{...; DO: ...; }; Super: S{...; DO: ...; inner(Super); ...; rtn  }
   Main.s: ...; toSuper DO: ...; rtnInner
   Super.S: ... DO ...; inner(Super); ...
   Invoke Main: Main.exe.; ...; toSuper; Super.DO; ...; inner(Super); ...;  main.RtnInner; ...; Super.rtn
   for Main, inner(Super) should be Main.DO
*)
(# X: @integer 
do ' descInx: ' -> out.puttext; descInx -> out.putint;
   ' inx:'->out.puttext; inx -> out.putint;
   ' innerOff: '->out.puttext; innerOff -> out.putint;
   state.stacks.rPop -> X;  (* callee *)
   (X,state.reg.thisObj,innerOff) -> state.ins.str;
   (state.reg.lr,state.reg.thisObj,innerOff + 1) -> state.ins.str;
   (* In betaVM, it is checked that VDT[inx] > 0 and if not, no jump - MUST be FIXED *)
   (X,inx,true) -> state.invokeV; (* Note inx - 1! The VDT is one (1) element shorter than expected*)
#)
---classDef:descriptor---
(##)
---class:descriptor---
(#
do  (N[],descNo,originOff,originDescNo,isValueObj,out[]) -> descs.setCurrent;
   (if descs.OD[topDescNo][]= none then 
       dumpClass;
       ' descs.OD[topDescNo='->puttext; topDescNo -> putint; '][]= none' -> putline
    else
       (topDescNo,descs.OD[topDescNo].bc[]) -> descs.current.setSuperBC;
   if);
   descs.markAllocE;
   (if procE then 
       'procE:' -> puttext; N[] -> putline;
       descs.markProcE 
   if);
   initGCinfo;
   labs.init;
   (**** ARM stuff ****)
   state.reg.init;
   state.labs.new;
   state.stacks.init;
   state.stat;
   descNo -> state.thisDescInx;
   N[] -> state.thisName[];
   state.newVDT;
#)
---setThisStack:descriptor---
(##)
---rPopThisObj:descriptor---
(##)
---setNoOfParams:doPart---
do '\n\t\t; objSize:'->out.puttext; objSize -> out.putint;
   objSize -> state.objSize; 
   (* shall we handle vTmpOff = 0 ?*)
   vTmpOff -> state.vTmpOff -> state.nxtVtmp; 
   (if rTmpOff = 0 then objSize + 1 -> rTmpOff if);
   rTmpOff -> state.rTmpOff -> state.nxtRtmp;

   ' vTmpOff:'->out.puttext; vTmpOff->out.putint; 
   ' rTmpOff:'->out.puttext; rTmpOff->out.putint; 
   
   (state.thisDescInx,true,0,0,objSize)  ->  state.gen_allocTemplate;
   state.allocParameters;
   
---actions:descriptor---
(#
do state.reg.init; (* OBS! to clear registers after possible parameter allocations - not OK *)
   state.tmp.init; 
   out.newline;state.thisName[] -> state.mkODname -> out.puttext; '_DO:' -> out.puttext;
   (if state.trace then state.thisName[] -> state.printTrace if);
#)
---initStmt:descriptor---
(#
do state.stat; state.tmp.init; state.tmp.display
#)
---mvStack:descriptor---
(#
#)
---pushConst:descriptor---
(# r: @integer
do state.reg.getV -> r;
   (* should just do*)
   (if false then (* need to check for const a str, ... *)
      (cst,state.valueKind) -> state.stacks.vPush
    else
       '\n\t mov ' -> out.puttext; r -> state.reg.print; ', #' -> out.puttext; cst -> out.putint;
       (r,state.regKind) -> state.stacks.vPush
   if)
#)
---pushFloatConst:descriptor---
(#
do
#)
---pushNone:descriptor---
(#
do 0 -> pushConst
#)
---pushText:descriptor---
(#
do (T[],T1[]) -> state.gen_qAllocTextObj
#)
---pushThis:descriptor---
(#
do state.reg.thisObj -> state.stacks.rPush;
#)
---pushg:descriptor---
(# r1,r2: @integer
do state.stat; state.reg.getV -> r1; state.stacks.rPop -> r2;
   (r1,r2,off) -> state.ins.ldr;
   r2 -> state.reg.freeR;
   (r1,state.regKind) -> state.stacks.vPush
#)
---rpushg:descriptor---
(# rrs,rrd: @integer
do state.stat;
   state.stacks.rPop -> rrs;
   (if rrs = state.reg.thisObj then
       state.reg.getR -> rrd
    else
       rrs -> rrd
   if);
   state.stat;
    '\n\t ldr '->out.puttext; rrd -> state.reg.print;
    ',['->out.puttext; rrs -> state.reg.print; ','->out.put; off * 8  + 24 -> out.putint; ']' -> out.put;
    (if (rrs <> rrd) then 
        '; rrs: ' -> out.puttext; rrs -> out.putint; rrs -> state.reg.freeR
    if);
    rrd -> state.stacks.rPush;
    state.stat
#)
---pushParam:doPart---
do (if false then 
      'pushParam:no_effect: '->state.com; state.stacks.vStack[state.stacks.vTop] -> out.putint;
   if)
---xpushg:descriptor---
(* rStack: ... X = Array-object
 * vStack: ... inx = index into array,   (0 < inx) and (inx <= size)
 *)
(# Xr,inxR,sizeR,vr: @integer
do (* p1 -> size;  op1 -> isValueObj; thisStack.rpop -> X[]; thisStack.vpop -> inx;*)
   size -> state.computeArrayIndex -> (Xr,inxR);
   state.stat;
   (if (isValueObj = 0) and (size = 1) then
       (*inx + 1 -> X.get -> value -> thisStack.vpush;*)
       (inxR,inxR,1 * 8) -> state.ins.subI;
       inxR -> state.reg.freeV; (* can we just use inxR instead of vr? *)
       state.reg.getV -> vr;
       (vr,Xr,inxR) -> state.ins.ldrR;
       Xr -> state.reg.freeR; 
       (vr,state.regKind) -> state.stacks.vPush
   else (* valueObject *)
       (if size > 1 then
           (for i: size repeat
               (*inx + i-> ix -> X.get -> value -> thisStack.vPush;*)

   for)if)if)
#)
---xrpush:descriptor---
(#
do
#)
---xrpushg:descriptor---
(#
do 
#)
---store:descriptor---
 (#
 do 
 #)
 ---storex:descriptor---
 (#
 do 
 #)
---storeg:descriptor---
 (# vr,rr: @integer
 do state.stat;
    state.stacks.vPop -> vr; 
    state.stacks.rPop -> rr;
    (if (vr <> 27) and (rr <> 27) then
       '\n\t str '->out.puttext;  vr -> state.reg.print;
       ',['->out.puttext; rr -> state.reg.print; ','->out.put; off * 8 + 24 -> out.putint; ']' -> out.put;
       vr -> state.reg.freeV; rr -> state.reg.freeR;
       state.stat;
    else
       '\n; MISSING str because of x27 registers\n'->out.puttext
    if)
 #)
---rstore:descriptor---
(* store in thisObj, which is not on rStack *)
(# rs: @integer
do state.stat;
    state.stacks.rPop -> rs;
    (if (rs <> 27) then
       '\n\t str '->out.puttext;  rs -> state.reg.print;
       ',['->out.puttext; state.reg.thisObj -> state.reg.print; ','->out.put; off * 8 + 24 -> out.putint; ']' -> out.put;
       rs -> state.reg.freeR;
       state.stat;
    else
       '\n; storeg:MISSING str because of x27 registers\n'->out.puttext
    if)
#)
---rstoreX:descriptor---
(#
do (N[],off) -> rstore
#)
---rstoreg:descriptor---
(# rs,rd: @ integer
do state.stat;
   state.stacks.rPop -> rs; state.stacks.rPop -> rd;
   (if (rs <> 27) then
       (rd,rs,off) -> state.ins.str
    else
       '\n; rstoreg: MISSING str because of x27 registers\n'->out.puttext
   if);
   rs -> state.reg.freeR; rd -> state.reg.freeR; 
   state.stat
#)
---xstoreg:descriptor---
(* op1 -> size; op1 -> isValueObj; 
 * thisStack.rpop -> X[];
   (if X[] = none then 3 -> fatalError; leave loop if);
   thisStack.vpop -> inx;
   (if size = 0 then
       arrayStrucSize -> X.get -> size;
   if);
   arrayStrucSize + (inx - 1) * size + size + 1 -> inx;
 *   sub x0,inx,-1
 *   mul x0, 
 * (for i: size repeat
        inx - i -> ix;
        thisStack.vPop -> value;
        (value,ix) -> X.assign
   for);
 *)
(# Xr,inxR,sizeR,valR,c8: @integer
do (if true then
       size -> state.computeArrayIndex -> (Xr,inxR)
    else
    state.stat;
   state.stacks.rPop -> Xr; state.stacks.vPop -> inxR;
   (inxR,inxR,1) -> state.ins.subI;   (* inx - 1 -> inx *)
   size -> pushConst; state.stacks.vPop -> sizeR;
   (inxR,inxR,sizeR) -> state.ins.mulR; (* inx * size -> inx *)
   (inxR,inxR,arrayStrucSize + size + 1) -> state.ins.addI; (* arrayStrucSize + size + 1 -> inx *)
   sizeR -> state.reg.freeV;
   size * 8 -> pushConst; state.stacks.vPop -> c8;
   (inxR,inxR,c8) -> state.ins.mulR;
   c8 -> state.reg.freeV;
   'after sizeR -> state.reg.freeV;' -> state.com;
   state.stat;
   if); 

   (for i: size repeat
        (inxR,inxR,i * 8) -> state.ins.subI;
        state.stacks.vPoP -> valR;
        (valR,Xr,inxR) -> state.ins.strR;
        state.stat;
   for);
   inxR -> state.reg.freeV;
   '\n\t\t; after inxR -> state.reg.freeV;' -> out.puttext;
   Xr -> state.reg.freeR;
   state.stat
#)
---xrstoreg:descriptor---
(#
do
#)
---loadOrigin:descriptor---
(* is apparently called before origin code is generated, i.e. no thisObj on rStack *)

(# r1,r2: @integer
do 'loadOrigin: ' -> state.com; state.stat;
   (if (state.stacks.rTop > 0) then
         state.stacks.rStack[state.stacks.rTop]-> r1;
         ' topRreg:' ->out.puttext; r1 -> out.putint;
         
         (if r1 = state.reg.thisObj then 
            state.stacks.rPop -> r1;
            state.reg.getR -> r2; 
            (if r2 <> state.reg.refBase then
               '  ERROR: r2 not refBase:r2:'->out.puttext; r2 -> out.putint
            if);
            (r2,r1) -> state.ins.movR;
            r2 -> state.stacks.rPush
         if)
      else 
         (*' rTop = 0 ' -> out.puttexT*)
   if)
#)
