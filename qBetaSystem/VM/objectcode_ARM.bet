---invokev:descriptor---
(* adrp    x0, VDT@PAGE
 * add     x0, x0, VDT@PAGEOFF
 * ldr     x1, [x0,dinx * 8]
 *)
(# arg,r: @integer
do state.stat;
   (* load origin *)
   state.stacks.rPop -> r; 
   state.stat;
   (if false and (r <> 15)  then  (* should we free r? *)
      state.reg.getR -> arg;
     '\n\t mov '->out.puttext; arg -> state.reg.print; ', ' -> out.puttext; r -> state.reg.print;
   if); 
   (r,dinx,false) -> state.invokev;
#)
---allocIndexed:descriptor--
(#
do (* op2 -> descInx; op1 -> size; op1 -> isRIndexed;
      a superflous thisObj is pushed by compiler should be eliminated 
      thisStack.rpop -> X[]; (* origin * )
      thisStack.vpop -> dinx;
      thisStack.vpop -> rangee;
      X[],descInx,size,rangee,isRindexed) -> QallocIndexed
      arrayStrucSize + range * size --> alloc
   *)
   state.stat;
   (size,isRefIndexed) -> state.QallocIndexed
#)
