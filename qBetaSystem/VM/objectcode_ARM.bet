               // codes.fle then 'fle' -> emitOp
               // codes.fgt then 'fgt' -> emitOp
               // codes.fge then 'fge' -> emitOp
               // codes.fne then 'fne' -> emitOp
               // codes.fexp then 'fexp' -> emitOp
               else
                  operator -> out.putint;
   if);
   (*state.tmp.restoreFromTmp*)
#)
