---vdtPatchAdd:descriptor---
(* same as for VM - so elim SLOT *)
(#
do (if (top + 1 -> top) > index.range then
       index.range -> index.extend;
       bindInx.range -> bindInx.extend;
       descInx.range -> descInx.extend;
       LLVMsigs.range -> LLVMsigs.extend
   if);
   ix -> index[top];
   bx -> bindInx[top];
   dx -> descInx[top];
   LLVMsig[] -> LLVMsigs[top][];
#)
---vdtPatchPatch:descriptor---
(#
do (for i: top repeat
      (if false then
         'Patch:range:' -> puttext; index.range -> putint; ' ' -> put;
         index[i] -> putint; ' ' -> put;
         bindinx[i] -> putint; ' ' -> put;
          descInx[i] -> putint;  ' ' -> put;  newline;
      if);
      (index[i],bindInx[i],false) -> state.addVDT
   for);
   state.mkVDTtables
#)
---vdtTableCopy:doPart---
do (if state.vdtTable[superDescNo][] <> none then 
       (for i: state.vdtTable[superDescNo].vdtTop repeat
             (i, state.vdtTable[superDescNo].bindings[i],state.vdtTable[superDescNo].isInner[i])-> state.addVDT
   for)if); 
