---callPrim:descriptor---
(#
do (if op 
   // prim.attach then 
   // prim.fork // prim.cmpAndSwap // prim.thisCore then
      (* perhaps more prims require C-mode, 
      * but we are probably shure with the above ones
      *)
      true -> descs.onlyCinterpreter;
   if);
   (if op
   // prim.put then 
      (if state.stacks.vTopKind = state.valueKind then
         state.stacks.vPop -> state.emitPutConst
      else 
         state.stacks.vPop -> state.emitPutReg
      if);
      (*(state.reg.getV,state.regKind) -> state.stacks.vPush; *)(* should check that getV returns x0 *)
      state.stat
   // prim.asString then
      (*'___%prim: asString' -> putline*)
   else
      '\n; !!!! missing prim: ' -> out.puttext; op -> out.putint;
   if) 
   (* do we need to allocate return register for all primitives, and is it value or ref being returned? *)
#)
