---close:descriptor---
(# sh: @File; nm: ^text;
   nl: (* we must use Mac newline - character code 10 *)
      (# do ascii.nl -> sh.put #)
do  
(1,(BC.name).length - 1) -> (BC.name).sub -> nm[]; 'sh' -> nm.puttext; nm[] -> sh.name;
   sh.openWrite;
   '#!/bin/bash' -> sh.puttext;  nl;
   'set -e' -> sh.puttext;  nl;
   'BASE="$1"' -> sh.puttext; nl;
   'echo $BETALIB' -> sh.puttext; nl;
   'BL="$BETALIB"' -> sh.puttext; nl;
   'QB="$BL"/qBetaSystem' -> sh.puttext; nl;
   'QBA="$QB"/VM/MAC-ARM' -> sh.puttext; nl;
   'echo "$QBA"' -> sh.puttext; nl;
   'as -g -arch arm64 -o ' -> sh.puttext; mainFN[] -> sh.puttext; '.o ' -> sh.puttext; mainFN[] -> sh.puttext; 
   '..a  ' -> sh.puttext;  nl;

   'ld -macos_version_min 26.0 \\' -> sh.puttext; nl;
   '   -o ' -> sh.puttext; mainFN[] -> sh.puttext; ' \\' -> sh.puttext; nl;
   '      ' -> sh.puttext; mainFN[] -> sh.puttext; '.o \\' -> sh.puttext; nl;
   '      "$QBA"/Mac_ARM_lib.o \\' -> sh.puttext; nl;
   '   -lSystem \\' -> sh.puttext; nl;
   '   -syslibroot "$(xcrun --show-sdk-path)"' -> sh.puttext; nl;
   'echo "Built ' -> sh.puttext; mainFN[] -> sh.puttext; '"'->sh.puttext; nl;
   sh.close
#)
   
