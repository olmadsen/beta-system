---rtnInner:descriptor---
(*'rtnInner' -> exe;
   thisObj.restoreReturn -> (descInx,glsc);
   descs.OD[descInx].BC[] -> thisCode[];
 *)
(# T: ^Text; rtn: @integer
do  (* we need innerOff of super 
    * restore caller
    * branch return
    *)
   ' descInx:'->out.puttext; descInx -> out.putint; 
   ' superInnerOff:'->out.puttext; superInnerOff -> out.putint; out.newline;
   (* it seems that superInnerOff may be 0 
    * and it seems that rtnInner is also generated even if no super?
    * but probably not harmful, since it will never be excuted because of no inner in super
    *)
   (if superInnerOff > 0 then
       (if false then
           '\\nRtnInner:' -> T[]; descInx -> T.putint; ' superInnerOff:'->T.puttext; 
           superInnerOff -> T.putint; '\\n'->T.puttext;
           T[] -> state.printString;
       if);
       state.reg.getV -> rtn;
       (rtn,state.reg.thisObj,superInnerOff + 1) -> state.ins.ldr;
       (state.reg.thisObj,state.reg.thisObj,superInnerOff) -> state.ins.ldr;
       (rtn,rtn,28) -> state.ins.addI;
       rtn -> state.ins.brR;
       rtn -> state.reg.freeV
   if)
#)
