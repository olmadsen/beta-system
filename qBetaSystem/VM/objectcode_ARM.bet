---rtn:descriptor---
(#
do (state.reg.refBase,state.reg.thisObj) -> state.ins.movR;
   '\n\t ldr lr, [x28,#0]' -> out.puttext;  (* restore lr *)
   '\n\t ldr x28, [x28,#8]' -> out.puttext; (* restore thisObj *)
   '\n\t ret' -> out.puttext;
#)
