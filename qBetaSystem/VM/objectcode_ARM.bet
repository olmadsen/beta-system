ORIGIN 'objectcode'
---ObjectCode_init:descriptor---
(#
do true -> isArm;
   state.genHeading;
   state.gen_putc;
#)
---ObjectCode_state:descriptor---
(# mkODname:
      (# n: ^Text; T: ^text
      enter n[]
      do (if (n[] -> mkOprName -> T[]) = none then
             '' -> T[];
             n.scanAll(#do (if ch = ':' then '$' -> T.put else ch -> T.put if) #)
         if)
      exit T[]
      #);
   mkOprName:
   (# n: ^text; T: ^text
   enter n[]
   do (if true 
      // '+' -> ((1,1)->n.sub).equal then '$PLUS' -> T[]; (2,n.length)->n.sub -> T.append;
      // '-' -> ((1,1)->n.sub).equal then '$MINUS' -> T[]; (2,n.length)->n.sub -> T.append;
      // '*' -> ((1,1)->n.sub).equal then '$MULT' -> T[]; (2,n.length)->n.sub -> T.append;
      // '/' -> ((1,1)->n.sub).equal then '$DIV' -> T[]; (2,n.length)->n.sub -> T.append;
      // '=' -> ((1,1)->n.sub).equal then '$EQ' -> T[]; (2,n.length)->n.sub -> T.append;
      // '<=' -> ((1,2)->n.sub).equal then '$LE' -> T[]; (3,n.length)->n.sub -> T.append;
      if)
      exit T[]
      #);
   gen_allocTemplate:
   (# descNo,vInxSize,rInxSize: @integer; isObj: @boolean; N: ^Text; 
   enter(descNo,isObj,vInxSize,rInxSize)
   do descs.OD[descNo].name[] -> mkODname -> N[];
      '\n.globl _' -> out.puttext; N[] -> out.puttext;

      '\n_' -> out.puttext; N[] -> out.puttext; ':' -> out.put;
      '\n\t adrp    x1, TMP@PAGE' -> out.puttext;
      '\n\t add     x1, x1, TMP@PAGEOFF' -> out.puttext;
      '\n\t str     lr, [x1]' -> out.puttext;
                                                                (* FIX save thisObj *)
      '\n\t mov x0, #' -> out.puttext; descs.OD[descNo].objSize * 4 + 4 -> out.putint; (* FIX + 8 , and * 4 + 4 several places *)
      '\n\t bl _malloc\t // adr in x0\n\tmov x28,x0' -> out.puttext;
      
      '\n\t adrp    x1, TMP@PAGE' -> out.puttext;
      '\n\t add     x1, x1, TMP@PAGEOFF' -> out.puttext;   (*  FIXrestore and save thisObj *)
      '\n\t ldr     lr, [x1]' -> out.puttext;
      '\n\t str lr, [x28, #0]\n' -> out.puttext
   #);
   labs: @
      (# labNo: @integer; thisLab: ^Text;
         new: 
            (# 
            do labNo + 1 -> labNo; 
               'L' -> thisLab[]; labNo -> thisLab.putint; '_'->thisLab.put
            #)
      #);
   RegisterHandler:
   (# refRegStart: (# exit 15 #);
      thisObj: (#exit 28 #);
      vRegNo,rRegNo: @integer;
      init: (# do 0 -> vRegNo; refRegStart -> rRegNo #);
      getV:
         (# rn: @integer
         do vRegNo -> rn;
            (if (vRegNo + 1 -> vRegNo) >= refRegStart then '\n!!!! ARM codegen. value register overflow'-> putline if);
         exit rn
         #);
      freeV:
         (# rn: @integer
         enter rn
         do (if rn = (vRegNo - 1) then vRegNo - 1 -> vRegNo 
            else
                '\n;!!!! register mismatch: ' ->out.puttext; rn -> out.putint; ','->out.put; vRegNo->out.putint;
            if)
         #);
      stat: (# do '\n; vRegNo: ' -> out.puttext; vRegNo -> out.putint; ' rRegNo: ' -> out.puttext; rRegNo -> out.putint #);
      getR:
         (# rn: @integer
         do rRegNo -> rn;
            (if (rRegNo + 1 -> rRegNo) >= thisObj then '\n!!!! ARM codegen. reference register overflow'-> putline  if);
         exit rn
         #);
      freeR:
         (# rn: @integer
         enter rn
         do (if rn = (rRegNo - 1) then rRegNo - 1 -> rRegNo 
            else
                (if rn <> thisObj then
                   '\n;!!!! register mismatch: ' ->out.puttext; rn -> out.putint; ','->out.put; rRegNo->out.putint;
         if)if)#);
      print: (# rn: @integer enter rn do 'x'->out.put; rn -> out.putint#)
   do
   #);
   valueKind: (# exit 0 #);
   regKind: (# exit 1 #);
   StackHandler:
   (# init: (# do 0 -> vTop -> rTop #);
      vStack: [8] @integer; vTop: @integer;
      vKind: [8] @ integer; (* 0: const; 1: register *)
      rStack: [8] @integer; rTop: @integer;
      vPush: 
         (# v,t: @integer 
         enter(v,t) 
         do (if (vTop + 1 -> vTop) > vStack.range then 
                vStack.range -> vStack.extend; vKind.range -> vKind.extend;
            if);
            v -> vStack[vTop]; t -> vKind[vTop];
         #);
      vPop: (# v: @integer do (if vTop > 0 then vStack[vTop] -> v; vTop - 1 -> vTop else -1 -> v if) exit v #);
      vTopKind: (# k: @integer do (if vTop > 0 then vKind[vTop] -> k else -1 -> k if) exit k #);
      rPush: 
         (# v: @integer
         enter v 
         do (if (rTop + 1 -> rTop) <= rStack.range then v -> rStack[rTop] else '\n; !!! rStack overflow:'->out.putline if)
         #);
      rPop: 
         (# r: @integer 
         do (if (rTop > 0) and (rTop <= 8) then rStack[rTop] -> r; rTop - 1 -> rTop else -1 -> r if) 
         exit r 
         #);
      stat: (# do '\n;stack:vTop:'->out.puttext; vTop -> out.putint; ' rTop:'->out.puttext; rTop -> out.putint; out.newline; #)
   #);
 reg: @RegisterHandler; stacks: @StackHandler;
 allocParameters:
    (* NOT sufficient for compound values - must need size *)
    (# 
    do '\n; parameters:pTop:' -> out.puttext; pTop -> out.putint; ':'->out.put;
        (for i: pTop repeat 
            params[i] -> out.putint; ' ' -> out.put;
            (if params[i]
            // 0 then (reg.getV,regKind) -> stacks.vPush
            // 1 then '\n!!!! EmitCode:allocParameters: compound values not supported'->dumpTN
            // 2 then reg.getR -> stacks.rPush;
            // 3 then
            else
                '\n!!!! EmitCode:allocParameters:illegal parameter kind: '-> puttext;
                params[i]->putint; newline
        if)for);
        out.newline
    #);
  params: [0] @integer; pTop: @integer;
  emitOp:
         (# op: @integer
         enter op
         do (if op 
            // codes.plus then
               '\n\tadd '-> out.puttext;
            // codes.minus then
               '\n\tsub '-> out.puttext;
            // codes.mult then
               '\n\tmul '-> out.puttext;

            if);
         #);
   binOpImm: (* binary operator with immediate argument *)
         (# op,vr,vl,r: @integer
         enter op
         do (if stacks.vTopKind = valueKind then
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl;
                    (vr + vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ',#'->out.puttext; vr -> out.putint; 
                    (vl,regKind) -> stacks.vPush
                if)
             else
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
             
                else (* operands in registers *)
                   stacks.vPop -> vl; 
                   op -> emitOp;
                   vl -> reg.print; ','->out.put; vl -> reg.print; ',' -> out.put; vr -> reg.print;
                   vr -> reg.freeV;
                   (vl,regKind) -> stacks.vPush
            if)if)
         #);
      binOpReg: (* binary operator with register argument *)
         (# op,vr,vl,r: @integer
         enter op
         do (if stacks.vTopKind = valueKind then
                stacks.vPop -> vr;
                (if stacks.vTopKind = valueKind then
                    stacks.vPop -> vl;
                    (vr + vl,valueKind) -> stacks.vPush (* Obs must be correct op *)
                else (* vr: const, vl: register *)
                    stacks.vPop -> vl;
                    vr -> pushConst; stacks.vPop -> vr;
                    op -> emitOp;
                    vl -> reg.print; ','->out.put; vl -> reg.print; ','->out.put; vr ->reg.print;
                    vr -> reg.freeV;
                    (vl,regKind) -> stacks.vPush
                if)
             else 
         
            if)
         #);
      emitPutConst:
          (# ch: @char
          enter ch
          do '\n\tmov w0, #' -> out.puttext; ch -> out.putint;
             '\n\tbl _putc\n' -> out.puttext;
          #);
      invoke:
          (# N: ^Text; off: @integer
          enter(N[],off)
          do (*'\n\t mov x0, ' -> out.puttext; stacks.rPop -> r -> reg.print;*)
             (* push of origin as first arg, but we dont know;
              * also, some objects have no origin
              *)
             '\n\tbl _'-> out.puttext; N[] -> mkODname -> state.mkODname -> out.puttext;
             state.stacks.init; (* clear possible registers used for parameters  -not OK *)
             state.reg.init;
          #);
    emitLab:
         (# lsc: @integer
         enter lsc
         do state.labs.thisLab[] -> out.puttext; lsc -> out.putint;
         #);
   genHeading:
      (#
      do '\n.bss' -> out.puttext;
         '\n.align 3' -> out.puttext;
         '\nTMP:' -> out.puttext;
         '\n.space 8\n' -> out.puttext;  (* TMP for thisObj *)

         '\n.text' -> out.puttext;
         '\n.global _main\n.align 2' -> out.puttext;
         '\n_main:\n\tbl _VM' -> out.puttext;
         '\n\tret\n' -> out.puttext;

      #);
    gen_putc:
      (#
      do '\n.text'->out.puttext;
         '\n.global _putc\n' -> out.puttext;
         '_putc: // Character is in w0\n' -> out.puttext;
      '\tsub     sp, sp, #16\n\tstrb    w0, [sp]\t// write(1, sp, 1)\n'->out.puttext;
      '\tmov     x0, #1              // stdout\n'->out.puttext;
      '\tmov     x1, sp              // address of character\n' -> out.puttext;
      '\tmov     x2, #1              // one byte\n'  -> out.puttext;
      '\tmov     x16, #4             // write\n'  -> out.puttext;
      '\tsvc     #0x80\n'  -> out.puttext;
      '\tadd     sp, sp, #16\n'  -> out.puttext;
      '\tret\n'  -> out.puttext;
      #);
   descInx: @integer; (* this descInx *)
   emitPutReg:
    (# r: @integer
    enter r
    do '\n\tmov w0, w' -> out.puttext; r -> out.putint;
       '\n\tbl _putc\n' -> out.puttext; r -> state.reg.freeV
    #);
#)
---classDef:doPart---
do
---class:descriptor---
(#
do  (N[],descNo,originOff,originDescNo,isValueObj,out[]) -> descs.setCurrent;
   (if descs.OD[topDescNo][]= none then 
       dumpClass;
       ' descs.OD[topDescNo='->puttext; topDescNo -> putint; '][]= none' -> putline
    else
       (topDescNo,descs.OD[topDescNo].bc[]) -> descs.current.setSuperBC;
   if);
   descs.markAllocE;
   (if procE then 
       'procE:' -> puttext; N[] -> putline;
       descs.markProcE 
   if);
   initGCinfo;
   labs.init;
   (**** ARM stuff ****)
   state.reg.init;
   state.labs.new;
   state.stacks.init;
   descNo -> state.descInx;
   (descNo,true,0,0)  ->  state.gen_allocTemplate;
#)
---setNoOfParams:doPart---
do params -> state.params; pTop -> state.pTop;
   state.allocParameters;
---actions:descriptor---
(#
do  state.reg.init; (* OBS! to clear registers after possible parameter allocations - not OK *)
    state.labs.thisLab[] -> out.puttext; 'DO:' -> out.putline;
#)
---pushConst:descriptor---
(# r: @integer
do (if true 
    // cst <= 255 then
       codes.pushc -> emit;
       cst -> emit
    // cst <= 255 * 255  then
       codes.pushc2 -> emit;
       cst -> emit2
    else 
       codes.pushc4 -> emit;
       cst -> emit4;
       fcom(#do 'OBS! Constant >= 2^16 is not implemented' ->TT #)
   if);
   state.reg.getV -> r;
    '\n\tmov ' -> out.puttext; r -> state.reg.print; ', #' -> out.puttext; cst -> out.putint;
    (r,state.regKind) -> state.stacks.vPush
#)
---pushThis:descriptor---
(#
do state.reg.thisObj -> state.stacks.rPush;
#)
---pushg:descriptor---
(# rv,rr: @integer
do state.reg.stat;
    '\n\tldr '->out.puttext; state.reg.getV -> rv -> state.reg.print;
    ',['->out.puttext; state.stacks.rPop -> rr -> state.reg.print; ','->out.put; off * 4 -> out.putint; ']' -> out.put;
    rr -> state.reg.freeR;
    (rv,1) -> state.stacks.vPush
#)
---rpushg:descriptor---
(# rrs,rrd: @integer
do codes.rpushg -> emit; off -> emit;
   state.stacks.rPop -> rrs;
   (if rrs = state.reg.thisObj then
       state.reg.getR -> rrd
    else
       rrs -> rrd
   if);
   state.reg.stat;
    '\n\tldr '->out.puttext; rrd -> state.reg.print;
    ',['->out.puttext; rrs -> state.reg.print; ','->out.put; off * 4 -> out.putint; ']' -> out.put;
    rrd -> state.stacks.rPush
#)
---pushParam:doPart---
do '\n; pushParam: '->out.puttext; state.stacks.vStack[state.stacks.vTop] -> out.putint;
---storeg:descriptor---
 (# vr,rr: @integer
 do state.reg.stat; state.stacks.stat;
    state.stacks.vPop -> vr; 
    state.stacks.rPop -> rr;
    (if (vr >= 0) and (rr >= 0) then
       '\n\tstr '->out.puttext;  vr -> state.reg.print;
       ',['->out.puttext; rr -> state.reg.print; ','->out.put; off * 4 -> out.putint; ']' -> out.put;
       vr -> state.reg.freeV; rr -> state.reg.freeR;
       state.reg.stat;state.stacks.stat;
    else
       '\n; MISSING str because of x-1 registers\n'->out.puttext
    if)
 #)
 ---defLab:descriptor---
(#
do state.labs.thisLab[] -> out.puttext; lab -> out.putint; ':' -> out.put; out.newline
#)
---jmp:doPart---
do 'jmp' -> emitOp; 'L'->out.put; lab -> out.putint; out.newline;
   codes.jmp -> emit;
   0 -> emit2;
   lab -> labs.mark;

   '\n\tb '->out.puttext; lab -> state.emitLab; out.newline;
---jmpFalse:descriptor---
(#
do codes.jmpFalse -> emit; 0 -> emit2; Flab -> labs.mark;
   '\n\tbne '->out.puttext; Flab -> state.emitLab; out.newline
#)
---invoke:descriptor---
(#
do (N[],staticOff) -> state.invoke
#)
---rtn:descriptor---
(#
do '\n\tldr lr, [x28,#0]' -> out.puttext;
   '\n\tret\n' -> out.puttext;
#)
---prepareReturn:descriptor---
(#
do state.reg.thisObj -> state.stacks.rPush; state.reg.thisObj -> state.stacks.rPush;
#)
---invokev:descriptor---
(#
do codes.invokev -> emit; dinx -> emit; noOfRefArgs -> emit;
   (if recIsValueObj then 1  -> emit else 0 -> emit if);
#)
---callPrim:descriptor---
(#
do codes.prim -> emit; op -> emit;
   (if op 
    // prim.attach then 
       ' ' -> out.put;
       'D' -> out.put;
       'D' -> emit 
    // prim.fork // prim.cmpAndSwap // prim.thisCore then
       (* perhaps more prims require C-mode, 
        * but we are probably shure with the above ones
        *)
       true -> descs.onlyCinterpreter;
   if);
    (if op
    // prim.put then 
        (if state.stacks.vTopKind = state.valueKind then
            state.stacks.vPop -> state.emitPutConst (* OBS! the argument may be a const or a var - check vKind *)
        else 
           state.stacks.vPop -> state.emitPutReg
        if)
    // prim.asString then
       (*'___%prim: asString' -> putline*)
    else
         '\n; !!!! missing prim: ' -> out.puttext; op -> out.putint;
    if) 
#)
---callPrim2:descriptor---
(#
do codes.prim2 -> emit; op -> emit; arg -> emit
#)
---binaryOp:descriptor---
(#
do (if operator
    // codes.plus then codes.plus -> state.binOpImm 
    // codes.minus then codes.minus -> state.binOpImm
               // codes.uminus then 'uminus' -> emitOp
    // codes.mult then  codes.mult -> state.binOpReg
               // codes.rdiv then 'div' -> emitOp (* not used? *)
               // codes.idiv then 'idiv' -> emitOp
               // codes.modd then 'modd' -> emitOp
               // codes.eq then 'eq' -> emitOp
               // codes.lt then 'lt' -> emitOp; 
               // codes.le then 'le' -> emitOp;
               // codes.gt then 'gt' -> emitOp;
               // codes.ge then 'ge' -> emitOp
               // codes.ne then 'ne' -> emitOp
               // codes.andd then 'andd' -> emitOp
               // codes.orr then 'orr' -> emitOp
               // codes.xorr then 'xorr' -> emitOp
               // codes.nott then 'nott' -> emitOp
               // codes.req then 'req' -> emitOp
               // codes.rne then 'rne' -> emitOp
               // codes.fplus then 'fplus' -> emitOp
               // codes.fminus then 'fminus' -> emitOp
               // codes.funaryminus then 'funaryminus' -> emitOp
               // codes.fmult then 'fmult' -> emitOp
               // codes.fdiv then 'fdiv' -> emitOp
               // codes.feq then 'feq' -> emitOp
               // codes.flt then 'flt' -> emitOp 
               // codes.fle then 'fle' -> emitOp
               // codes.fgt then 'fgt' -> emitOp
               // codes.fge then 'fge' -> emitOp
               // codes.fne then 'fne' -> emitOp
               // codes.fexp then 'fexp' -> emitOp
               else
                  operator -> out.putint;
              if);
              out.newline;
              operator -> emit;
#)
   
