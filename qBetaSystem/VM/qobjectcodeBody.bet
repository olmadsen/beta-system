ORIGIN 'objectcode'
---objDescTables:descriptor---
(# ODTable: [100] ^ODentry; ODtop: @integer;
   ODentry:
      (# name: ^Text; 
         params: [8] @integer; pTop,descInx,originOff,objSize: @integer; 
         hasOrigin,isVstub: @Boolean;
         asText:
            (# T: ^Text
            do name.copy -> T[]; 
               (if (pTop > 0) or hasOrigin then ' args:'->T.append; pTop->T.putint; if);
               (if hasOrigin then 'O'->T.put if);
               (for i: pTop repeat params[i] -> parKind -> T.append for);
            exit T[] 
            #)
      enter(name[],descInx,isVstub)
      do (if false then 'new ODentry:'->puttext; name[] -> dumpT; descInx->dumpI; newline if);
         this(ODentry)[] -> thisODentry[]; 
         (if descInx > 0 then
            (if descInx > ODtable.range then ODtable.range -> ODtable.extend if);
            thisODentry[] -> ODtable[descInx][]; 
      if)#);
   thisODEntry: ^ODentry;
   sValPar: (#exit 0 #); cValPar: (#exit 1 #); refPar: (#exit 2 #); ptnPar: (#exit 3 #); outPar: (#exit 4 #);
   parKind:
      (# par: @integer; T: ^Text
      enter par
      do (if par
          // sValPar then 'v'->T[]
          // cValPar then 'c'->T[]
          // refPar then 'r'->T[]
          // ptnPar then 'p'->T[]
          // outPar then 'o'->T[]
          else
             'unKnown'->T[]
         if)
      exit T[]
      #);
   StringId: ^Text; 
#)
---setStringId:descriptor---
(#
do id[] -> objDescTables.StringId[]
#)
---setCurrentODtable:doPart---
do (N[],dNo,isVstub) -> objDescTables.ODentry
---setParameters:doPart---
do params -> objDescTables.thisODEntry.params; pTop -> objDescTables.thisODEntry.pTop; 
   originOff -> objDescTables.thisODEntry.originOff;  
   originOff > 0 -> objDescTables.thisODEntry.hasOrigin;
   objSize -> objDescTables.thisODEntry.objSize;