ORIGIN '~beta/basiclib/betaenv';
INCLUDE '~beta/basiclib/file';
---lib:attributes---
ARM_instructions:
   (# init: (# enter out[] #);
      printReg: (# r: @integer enter r do 'x'->out.put; r -> out.putint #);
      ldr:
         (# rs,rd,off: @integer
         enter(rs,rd,off)
         do '\n\t ldr '->out.puttext;  rs -> printReg;
             ',['->out.puttext; rd -> printReg;
             ','->out.put; off * 8 + 16 -> out.putint; ']' -> out.put;
         #);
      str:
         (# rs,rd,off: @integer
         enter(rs,rd,off)
         do '\n\t str '->out.puttext;  rs -> printReg;
             ',['->out.puttext; rd -> printReg;
             ','->out.put; off * 8 + 16 -> out.putint; ']' -> out.put;
         #);
      strR: 
         (# r1,r2,r3: @integer
         enter(r1,r2,r3)
         do '\n\t str '->out.puttext;  r1 -> printReg;
             ',['->out.puttext; r2 -> printReg; ','->out.put; r3 -> printReg; ']' -> out.put;
         #);
      addI: 
         (# r1,r2,c: @integer
         enter(r1,r2,c)
         do '\n\t add ' -> out.puttext; r1 -> printReg; ',' -> out.put;  r2 -> printReg; ', #' -> out.puttext; c -> out.putint;
         #);
      addR: 
         (# r1,r2,r3: @integer
         enter(r1,r2,r3)
         do '\n\t add ' -> out.puttext; r1 -> printReg; ',' -> out.put; r2 -> printReg; ',' -> out.put; r3 -> printReg
         #);
      subI: 
         (# r1,r2,c: @integer
         enter(r1,r2,c)
         do '\n\t sub ' -> out.puttext; r1 -> printReg; ',' -> out.put;  r2 -> printReg; ', #' -> out.puttext; c -> out.putint;
         #);
      subR: 
         (# r1,r2,r3: @integer
         enter(r1,r2,r3)
         do '\n\t add ' -> out.puttext; r1 -> printReg; ',' -> out.put; r2 -> printReg; ',' -> out.put; r3 -> printReg
         #);
      mulR: 
         (# r1,r2,r3: @integer
         enter(r1,r2,r3)
         do '\n\t mul ' -> out.puttext; r1 -> printReg; ',' -> out.put; r2 -> printReg; ',' -> out.put; r3 -> printReg
         #);
      movI: 
         (# r,c: @integer
         enter(r,c)
         do '\n\t mov ' -> out.puttext; r -> printReg; ', #' -> out.puttext; c -> out.putint;
         #);
      movR: 
         (# r1,r2: @integer
         enter(r1,r2)
         do '\n\t mov ' -> out.puttext; r1 -> printReg; ',' -> out.put; r2 -> printReg
         #);
      udiv:
         (# r1,r2,r3: @integer
         enter(r1,r2,r3)
         do '\n\t UDIV ' ->out.puttext; r1->printReg; ','->out.put; r2->printReg; ','->out.put; r3->printReg
         #);
      out: ^File
   #)