     pushText:
       (# T,T1: ^text; stringDescNo,I: @integer
       enter (T[],stringDescNo)
       do 'pushText' -> emitOp; '"' -> out.put; T[] -> out.puttext; '"' -> out.put; 
          T[] -> handleEscape -> T1[];
          <<SLOT pushText:descriptor>>
       #);
     pushParam: (# paramKind: @integer enter paramKind <<SLOT pushParam:doPart>> #);
     handleEscape:
       (# T: ^text; T1: @text;
          nextCh: 
            (# 
            do i + 1 -> i;
               (if i <= T.length then
                   i -> T.inxGet -> ch;
                else
                   0 -> ch
               if);               
            #);
          ch: @char;
          i: @integer
       enter T[]
       do 0 -> i;
          nextCh;
          loop:
            (if i <= T.length then 
                (if ch 
                 // '\\' then 
                    nextCh;
                    (if ch
                     // 'n' then
                        ascii.nl -> T1.put;
                        nextch
                     // 'r' then
                        ascii.cr -> T1.put;
                        nextch
                     // '\\' then
                        '\\' -> T1.put;
                        nextch;
                     // 't' then
                        ascii.ht -> T1.put;
                        nextch;
                     // '{' // '}' then
                        ch -> T1.put;
                        nextCh
                     else
                        '\\' -> T1.put
                    if)
                 else
                    ch -> T1.put;
                    nextCh;                    
                if);
                restart loop
            if)
       exit T1[]
       #);
     mkStrucRef:
