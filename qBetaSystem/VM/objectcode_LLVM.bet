---mkLLVMvirtualDefs:descriptor---
(# 
          mkVdtType:
            (# T,N,orgOfN: ^text;
            do '%vdt_type$' -> T[];
               thisClassId[] -> filter -> T.puttext;
               ' = type {' -> T.puttext;
               (for i: descs.current.vdtTop repeat
                    (if (descs.current.vdtTable[i] -> dN) > 0 then
                        (if descs.current.isInner[i] then
                            dN -> vName -> (N[],orgOfN[]);
                            (if newFeature then
                                ('*'->('%'->N.prepend).put,dn) 
                                  -> state.funcPtrType -> T.puttext
                             else
                                '%' -> T.put;
                                N[] -> T.puttext;
                                '*(%' -> T.puttext;
                                N[] -> T.puttext; '*' -> T.put;
                                (if state.isValueObject then
                                    ', i32' -> T.puttext;
                                 else
                                    (if newFeature then
                                        ', ' -> T.puttext;
                                        orgOfN[] -> mkLLVMtype 
                                          -> T.puttext;
                                        '*' -> T.put;
                                    if)
                                if);
                                ')*' -> T.puttext
                            if);
                         else
                            descs.current.LLVMsigs[i][]  -> T.putline
                        if)
                     else
                        (if state.isValueObject then
                            'i8*(i8*,i32)*' -> T.puttext
                         else
                            'i8*(i8*)*' -> T.puttext
                        if)
                    if);
                    (if i < descs.current.vdtTop then
                        ',' -> T.put
               if)for);
               '}\n' -> T.puttext;
               (if typeInfo.dsc[descs.current.descInx][] = none then
                   '\n!!!! mkVdtType: '
                   'typeInfo.dsc[descs.current.descInx][] = none' 
                     -> putline;
                   '!!   vdtType: ' -> puttext; T[] -> putline
                else
                   T[] -> typeInfo.dsc[descs.current.descInx].vdtType[];
               if);
            #);
          mkVdtData:
            (# orgOfVN,T,S: ^text; dM: @integer
            do (if false then
                   '**** mkVdtData: ' -> puttext; thisClassId[] -> putline;
                   (for i: descs.current.vdtTop repeat
                        '   ' -> puttext;
                        (if descs.current.isInner[i] then
                            'inner: ' -> puttext
                         else
                            'virtual: ' -> puttext
                        if);
                        descs.current.vdtTable[i] -> putint; ' ' -> put;
                        descs.current.LLVMsigs[i][] -> putline
                   for);
               if);
               '\n@vdt_data$' -> out.puttext; thisClassId[] -> out.puttext;
               ' = global %vdt_type$' -> out.puttext;
               thisClassId[] -> filter -> out.puttext;
               ' {' -> out.puttext;
               (for i: descs.current.vdtTop repeat
                    '\n      ' -> out.puttext;
                    (if (descs.current.vdtTable[i] -> dN) > 0 then
                        (if descs.current.isInner[i] then
                            (if newFeature then
                                dN -> vName -> (T[],orgOfVN[]);
                                '*' -> ('%' -> T.prepend).put -> S[];
                                (S[],dN) -> state.funcPtrType -> out.puttext;
                             else
                                '%' -> out.put;
                                dN -> vName -> (T[],orgOfVN[]);
                                T[] -> out.puttext;
                                '*(%' -> out.puttext;
                                dN -> vName -> (T[],orgOfVN[]);
                                T[] -> out.puttext;
                                '*' -> out.puttext;
                                (if state.isValueObject then
                                    ', i32' -> out.puttext;
                                if);
                                ')* ' -> out.puttext;
                            if);
                            '@' -> out.puttext;
                            dN -> vName -> (T[],orgOfVN[]);
                            T[] -> out.puttext;
                         else
                            descs.current.LLVMsigs[i][] -> out.puttext;
                            ' @vdt_alloc$' -> out.puttext;
                            dN -> vName -> (T[],orgOfVN[]);
                            T[] -> out.puttext;
                            (*T[] -> puttext; ' ' -> put;  
                            descs.current.LLVMsigs[i][] -> putline;*)
                        if)
                     else
                        'i8* (i8* )* null' -> out.puttext
                    if);
                    (if i < descs.current.vdtTop then
                        ',' -> out.put
               if)for);
               '\n}\n' -> out.puttext;
               (if false then
                   '**** mkVdtData:end: ' -> puttext; thisClassId[] -> putline;
               if);
            #);
          mkVdtRet:
            (# T: ^Text
            do '%vdt_ret$' -> T[];               
               thisClassId[] -> T.puttext;
               ' = type{' -> T.puttext;
               state.thisClassP[] -> T.puttext;
               ',' -> T.put;
               (if newFeature then
                   (state.thisClassP[],thisClassDescNo) -> state.funcPtrType -> T.puttext;
                   '}\n' -> T.puttext;
                else
                   state.thisClassP[] -> T.puttext; '(' -> T.put;
                   state.thisClassP[] -> T.puttext; 
                   (if state.isValueObject then
                       ', i32' -> T.puttext
                   if);
                   ')*}\n' -> T.puttext;
               if);
               (if typeInfo.dsc[descs.current.descInx][] = none then
                   '\n!!!! mkVdtRet: '
                   'typeInfo.dsc[descs.current.descInx][] = none' -> putline;
                   '!!    vdtRet: ' -> puttext; T[] -> putline
                else
                   T[] -> typeInfo.dsc[descs.current.descInx].vdtRet[]
               if)
            #);
          mkVDTalloc:
            (# rNx,rNy,rNz,rNv,range: @integer; thisClassVdtType,funcPT,T,id: ^text
            do (if traceLLVMcalls then
                   '$vdt_alloc$'->(thisClassId.copy).prepend 
                     -> mkTextConst -> (id[],range)
               if);
                '%vdt_ret$' -> thisClassVdtType[];
               thisClassId[] -> thisClassVdtType.append;
               '\ndefine ' -> out.puttext;
               thisClassVdtType[] -> out.puttext;
               '* @vdt_alloc$' -> out.puttext;
               thisClassId[] -> out.puttext;               
               '(' -> out.put;
               (if isVstubObject then (* clean-up here *)
                   state.thisClassOrgId[] -> mkTypePtrX -> out.puttext
                else
                   (state.thisClassOrgId[],thisClassOrgDescNo)
                     -> mkTypePtr -> out.puttext;
               if);
               ' %R1' -> out.puttext; 
               '){\n' -> out.puttext;
               allocReg; (* allocate origin reg %R1 *)
               (if traceLLVMcalls then (id[],range) -> putstring if);
               lcom(#do 'mkVDTalloc:isVstubObject:'->TT; isVstubObject -> BB #);
               (thisClassVdtType[],118,8) -> state.allocRTobj -> rNx;
               lcom(#do 'mkVDTalloc:B:'->TT #);
               (**** OBS! size of obj is 48 below - but is this correct?
                * Probably no, we need the size of the binding
                *)
               (if not isVstubObject then
                   lcom(#do 'vdt_alloc:alloc ' -> TT; state.thisClassT[] -> TT #);
                   (state.thisClassT[],thisClassDescNo,48) -> state.allocQbetaObj -> rNy;
                   
                   (rNx,thisClassVdtType[],0) -> state.leaReg -> rNz;
                   
                   '   store ' -> out.puttext; 
                   state.thisClassP[]  -> out.puttext; ' ' -> out.put;
                   rNy -> emitRreg -> out.puttext; ', ' -> out.puttext;
                   state.thisClassP[] -> out.puttext; '* ' -> out.puttext;
                   rNz -> emitRreg  -> out.putline;
               if);
               lcom(#do 'mkVDTalloc:C:'->TT #);
               (if false then
                   (* here we store the constructor for the binding, 
                    * but we dont use it - can be eliminated
                    *)
                   (rNx,thisClassVdtType[],1) -> state.leaReg -> rNv;
                   
                   (state.thisClassP[],thisClassDescNo) -> state.funcPtrType -> funcPT[];
                   '   store ' -> out.puttext;
                   funcPT[] -> out.puttext; 
                   ' @' -> out.puttext; thisClassId[] -> out.puttext;
                   ', ' -> out.puttext;
                   
                   funcPT[] -> out.puttext;
                   '* ' -> out.puttext;
                   rNv -> emitRreg -> out.puttext;
               if);
               (if false and not state.isValueObject and (state.thisClassOriginOff > 0) then
                   lcom(#do 'store origin: ' -> TT; state.thisClassOriginOff -> II #);
                   (rNy,state.thisClassT[],state.thisClassOriginOff) -> state.leaReg  -> rNz;
                   
                   '   store ' -> out.puttext;
                   (if isVstubObject  then
                       state.thisClassOrgId[]
                         -> mkTypePtrX -> T[]  -> out.puttext;
                    else
                       (state.thisClassOrgId[],thisClassOrgDescNo) 
                         -> mkTypePtr -> T[]  -> out.puttext;
                   if);
                   ' %R1, ' -> out.puttext; 
                   T[] -> out.puttext; 
                   '* ' -> out.puttext;
                   rNz -> emitRreg -> out.putline;
               if);
               lcom(#do 'thisClassOrgId:' -> TT; state.thisClassOrgId[] -> TT;
                      'thisClassOrgDescNo:' -> TT; thisClassOrgDescNo -> II #);
               (if not isVstubObject then
                   (1,(state.thisClassOrgId[],thisClassOrgDescNo)-> mkTypePtr)
                     -> stack.rpushT;
                else
                   (1,'%'->(state.thisClassOrgId.copy).prepend) -> stack.rpushT;
               if);

               (if not isVstubObject then
                   (* perhaps move push' below to non Vstub or above?*)
                   (rNy,state.thisClassT[]) -> stack.rpushT;
               if);
               stack.put;
               (*thisClassDescNo -> handleOrigins;*)
               
               (if isVstubObject then
                   lcom(# do 'CALL Vstub:' -> TT; state.thisClassT[] -> TT  #);
                   allocReg -> rNy;
                   (thisClassId[],state.thisClassOrgId[]->filter,1,rNy)
                     -> LLVMcall -> out.putline;
                   (rNy,state.thisClassT[]) -> stack.rpushT;
                   stack.put;
                   
                   lcom(#do 'Store binding in vdt_ret.' -> TT;
                          'Note! types are not correct' -> TT #);
                   (rNy,state.thisClassT[],rNx,thisClassVdtType[],0) -> state.LLVMstore;
                   stack.put;
                   thisClassDescNo -> handleOrigins;
                else
                   lcom(#do 'before:handleOrigins:'->TT; thisClassDescNo ->II#);
                   thisClassDescNo -> handleOrigins;
                   lcom(#do 'after:handleOrigins:'->TT; thisClassDescNo ->II #);
               if);
               (if dumpLLVMobjs then
                   ('vdt_alloc:obj:',thisClassId[]
                   ,rNy,state.thisClassT[])
                     -> state.dumpObjX;
                   (*('vdt_alloc:%vdt_ret:RET:obj',thisClassId[],rNx
                   ,thisClassVdtType[]) 
                     -> state.dumpObjX;*)
               if);
               '   ret %vdt_ret$' -> out.puttext;
               thisClassId[] -> out.puttext;
               '* ' -> out.puttext; rNx -> emitRreg -> out.puttext;
               '\n}\n' -> out.puttext;
            #);
          printVDT:
            (#
            do '   ;; vdt:vdtTop: ' -> out.puttext;
               descs.current.vdtTop -> out.putint; ' ' -> out.put;
               (for i: descs.current.vdtTop repeat
                    descs.current.vdtTable[i] -> out.putint;
                    ':' -> out.put;
                    (if descs.current.isInner[i] then
                        'I' -> out.put
                     else
                        'V' -> out.put
                    if);
                    (if i < descs.current.vdtTop then ',' -> out.put if)
               for);
            #);
          dn: @integer
do (if false then
                  '**** mkLLVMVirtualDefs: ' -> puttext; state.thisClassT[] ->putline
   if);
   printVDT;
              mkVdtType;
              mkVdtData;
              inner mkLLVMvirtualDefs; 
              mkVdtRet;
   mkVDTalloc;
   false -> state.isValueObject;
              (if false then
                  '**** mkLLVMvDefs:end: ' -> puttext; state.thisClassT[] -> putline
              if)
#)
