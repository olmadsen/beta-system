---callPrim:descriptor---
(#
do (if op 
    // prim.put then
       '   call i32 @putCh(i32 ' -> out.puttext; 
       stack.vtop -> vRegInStack -> out.puttext;
       ')\n' ->out.puttext;
       1 -> stack.vpop
    // prim.asString then
       ';; call asString' -> out.putline;
       '!!!! LLVM:callPrim:notImplemented:asString'->putline;
