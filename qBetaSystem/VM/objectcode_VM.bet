ORIGIN 'objectcode'
---ObjectCode_init:descriptor---
(#
do
#)
---ObjectCode_state:descriptor---
(#
#)
---classDef:desriptor---
(#
do
#)
---class:descriptor---
(#
do  (N[],descNo,originOff,originDescNo,isValueObj,out[]) 
     -> descs.setCurrent;
   (if descs.OD[topDescNo][]= none then 
       dumpClass;
       ' descs.OD[topDescNo='->puttext; 
       topDescNo -> putint;
       '][]= none' -> putline
    else
       (topDescNo,descs.OD[topDescNo].bc[]) 
         -> descs.current.setSuperBC;
   if);
   descs.markAllocE;
   (if procE then 
       'procE:' -> puttext; N[] -> putline;
       descs.markProcE 
   if);
   initGCinfo;
   labs.init;
#)
---setThisStack:descriptor---
(#
do codes.setThisStack -> emit
#)
---rPopThisObj:descriptor---
(#
do codes.rpopThisObj -> emit
#)
---setNoOfParams:doPart---
do
---actions:descriptor---
(#
do '\nDO:'->out.puttext;
   descs.markDoE;
    (if genDoEvent then doEventQ if);
#)
---pushConst:descriptor---
(#
do (if true 
    // cst <= 255 then
       codes.pushc -> emit;
       cst -> emit
    // cst <= 255 * 255  then
       codes.pushc2 -> emit;
       cst -> emit2
    else 
       codes.pushc4 -> emit;
       cst -> emit4;
       fcom(#do 'OBS! Constant >= 2^16 is not implemented' ->TT #)
   if)
#)
---pushFloatConst:descriptor---
(#
do codes.pushFloatConst -> emit;X -> emit8
#)
---pushNone:descriptor---
(#
do codes.pushNone -> emit; stack.rPush
#)
---pushText:descriptor---
(#
do codes.pushText -> emit;
   T1.length -> descs.current.addLiteral(#do i + 1 -> i -> T1.inxGet -> value #) -> emit;
   stack.rPush
#)
---pushThis:descriptor---
(#
do codes.pushthis -> emit; 
#)
---pushg:descriptor---
(#
do codes.pushg -> emit; off -> emit;
#)
