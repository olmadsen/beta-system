(#
do codes.tstOriginNone -> emit;
#)
---invokev:descriptor---
(#
do codes.invokev -> emit; dinx -> emit; noOfRefArgs -> emit;
   (if recIsValueObj then 1  -> emit else 0 -> emit if);
#)
---allocIndexed:descriptor--
(#
do codes.allocIndexed -> emit; descNo -> emit2; size-> emit; isRefIndexed -> emit
#)
---mkVindexed:descriptor---
(#
do codes.mkVindexed -> emit; descInx -> emit2;
#)
---mkRindexed:descriptor---
