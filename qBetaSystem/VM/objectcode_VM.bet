(#
do (if off <= 255 then 
      codes.rstore -> emit; off -> emit
if)#)
---rstoreg:descriptor---
(#
do (if off <= 255 then 
      codes.rstoreg -> emit; off -> emit
if)#)
---xstoreg:descriptor---
(#
do codes.xstoreg -> emit; size -> emit; isValueObj -> emit; 
#)
---xrstoreg:descriptor---
