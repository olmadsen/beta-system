do codes.mkRindexed -> emit; descInx -> emit2;
#)
---invokeVal:descriptor---
(#
do codes.invokeVal -> emit; descNo -> emit2; valueOff -> emit2;
   (if inValueObj then 1 -> emit else 0 -> emit if);
#)
---mkValueProxy:descriptor---
(#
do codes.mkValueProxy -> emit; descNo -> emit2; off -> emit2;
   (if isValueObj then 1 -> emit else 0 -> emit if);
   (if originIsValueObj then 1 -> emit else 0 -> emit if);
#)
---mkIndexedValueProxy:descriptor---
(#
do codes.mkIndexedValueProxy -> emit; descNo -> emit2; 
   (if isValueObj then 1 -> emit else 0 -> emit if);
   (if originIsValueObj then 1 -> emit else 0 -> emit if);
#)
