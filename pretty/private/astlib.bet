ORIGIN '~beta/newmps/astlevel';


-- AstInterfaceLib: attributes --

CommentSeparator1: (#  exit 1 #);
(* Separation of comments *)
CommentSeparator2: (#  exit 2 #);
(* Separation of comments in same son *)
CommentSeparator3: (#  exit 3 #);
(* Separation of comments in properties *)

printComment:
  (# value: ^Text;
     output: ^Stream;
  enter (value[], output[])
  do value[] -> output.putline;
  #);

-- ASTLib: attributes --
hasComment:
  (# 
  exit false 
  #);
hasCommentProp:
  (#
  exit false
  #);
getCommentProp:
  (# prop: ^propertyList;
  do 
  exit prop[]
  #);
setCommentProp:
  (# prop: ^propertyList;
  enter (prop[])
  do 
  #);
typeOfComment:
  (# type: @integer
  enter type
  exit type
  #);
getSubcomment:
  (# subcomment: ^text; 
     inx,subinx: @integer
  enter (inx,subinx)
  exit subcomment[]
  #);
setSubcomment:
  (# subcomment: ^text;
     inx,subinx: @integer
  enter (subcomment[], inx, subinx)   
  #);
insertSubcomment:
  (# subcomment: ^text;
     inx,subinx: @integer
  enter (subcomment[], inx, subinx)   
  #);

getComment:
  (#
  exit com[]
  #);
addComment:
  (# theComment: ^Comment;
  enter theComment[]
  #);
