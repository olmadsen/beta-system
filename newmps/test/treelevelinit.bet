ORIGIN '../astlevel';
INCLUDE '../grammarinit';

-- program: descriptor --
(# mps: @astinterface(# defaultGrammarFinder:: findGrammar #);
   betagrammar: @mps.treelevel;
   name: ^Text;
   group: ^astInterface.fragmentGroup;
do 'initialzing beta-grammar' -> screen.putLine;
   mps;
   ('~beta/grammars/beta/beta','beta',screen[])
     ->betagrammar.betagrammarInit
     (#
        MPSerror::
          (# do (failure,msg[])->stop #);
        noParserAvailable::
          (# do (failure,msg[])->stop #)
     #);
   'done' -> screen.putLine; 

   (if NoOfArguments = 2 then
       2 -> arguments -> name[];
       (name[], screen[]) -> mps.top.open -> group[];
       group.scan
	  (# frag: ^astInterface.fragmentForm;
	     root: ^astInterface.beta.descriptorForm;
	  do '--- ' -> screen.puttext;
	      current.name -> screen.putline;
	      current[] -> frag[];
	      (3, screen[], mps.grammarTable.beta[]) -> frag.root.dump;
	      screen.newline;
	      
	      frag.importtop -> screen.putint;
	      
	      screen.newline;
	      frag.root[] -> root[];
	      
	      root.Xorigin[] -> getPatternName -> screen.putline;
	  #);
       group.setupOrigin;
       (group.origin).fullname -> screen.putline;
   if);

#)
