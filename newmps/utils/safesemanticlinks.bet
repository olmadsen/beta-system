ORIGIN '~beta/newmps/astlevel';
INCLUDE '~beta/basiclib/file'
        '~beta/grammars/beta/betacfl'
        '~beta/newmps/semanticerrortext';
-- astInterfaceLib: Attributes --
safeIndexToNode:
  (# inx: @integer;
     as: ^astInterface.ast;
     indexOutOfRange:< astInterfaceException;
     noSuchSymbol:< astInterfaceException;
     grammarGenRefArrayError:< astInterfaceException;
     ff: ^astInterface.fragmentForm
  enter (inx,ff[])
  do inx -> ff.indexToNode -> as[];
  exit as[]
  #);
safeGetGroup:
  (* Private: The inverse of GetIndex; If the group is not open then open it *)
  (#
     ff,f: ^astInterface.FragmentForm;
     Index: @integer;
     importException:< AstInterfaceException;
  enter (ff[],index)
  do index -> ff.lookup -> f[];
  exit f[]
  #);
safeDclRef:
(* like betasematt.declRef except that it does not crash if the
 * the semantic link is undefined, instead it returns NONE
 *)
  (# aplNode,dclNode: ^ast;
     nameApl: ^beta.nameApl;
     betacfl: ^beta;
  enter aplNode[]
  do grammartable.beta[] -> betacfl[];
     (if aplNode## <= betacfl.NameApl## then
         aplNode[] -> nameApl[];
         nameApl.dclRef[] -> dclNode[];
     if);
  exit dclNode[]
  #);
safeVirtDcl:
(* like betasematt.virtDecl except that it does not crash if the
 * the semantic link is undefined, instead it returns NONE
 *)
  (# aplNode,dclNode: ^astInterface.ast;
     nameDcl: ^beta.NameDcl;
  enter aplNode[]
  do aplNode[] -> nameDcl[];
     nameDcl.virtDcl[] -> dclNode[];
  exit dclNode[]
  #);

