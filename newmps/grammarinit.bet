ORIGIN '~beta/grammars/beta/betacfl';
INCLUDE 'private/treelevelbody';
INCLUDE '~beta/newmps/metagrammarcfl';

-- treeLevelLib: attributes --
 

betaGrammarInit:
  (# path: ^Text;
     name: ^Text;
     out: ^Stream;
     meta: ^MetaGrammar;
     
     MPSError:<
       (# msg: ^Text;
       do INNER;
       #);
     noParserAvailable:<
       (# msg: ^Text;
       do INNER;
       #);
     doInitializeMetaGrammar: (# exit false #);
  enter (path[], name[], out[])
  do (# parserPath: ^Text;
        grammarPath: ^Text;
        grammarGroup: ^FragmentGroup;
     do 
        (if (grammartable.meta[] = NONE) AND doInitializeMetaGrammar then
           &MetaGrammar[] -> meta[];
           meta.init;
           meta[] -> grammartable.meta[];
        if);
        '-parser' -> (path.copy).append -> parserPath[];
        '-meta' -> (path.copy).append -> grammarPath[];

        (if grammartable.meta[] <> NONE then
            (grammarPath[], '.') -> thePathHandler.convertFilePath -> grammarPath[];
            (grammarPath[], screen[]) -> top.open -> grammarGroup[];
            (name[], screen[]) -> grammarGroup.open -> grammarAst[];
        if);
        
        (parserPath[], '.') -> thePathHandler.convertFilePath -> init;

        
        ('objectdescriptor','descriptor') -> parser.private.b.defineNonTAlias;
        ('attributedecl','attributes') -> parser.private.b.defineNonTAlias;
        THIS(TreeLevel)[] -> grammartable.default[];
        THIS(TreeLevel)[] -> grammartable.beta[];
     #)
  #);
