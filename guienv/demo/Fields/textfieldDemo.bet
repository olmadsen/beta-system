ORIGIN '~beta/guienv/fields';
-- program: Descriptor --
GUIenv
  (# blue: @Color;
     theWindow: @Window
       (#
          aTextfield: @Textfield
            (#
               open:: 
                 (#
                    temp: ^styledText;
                    insertText: 
                      (# italicFontStyle:
                           
                           (# 
                              aTextStyle: ^textStyle; 
                           do
                              &textStyle[]->aTextStyle[];
                              'Times'->aTextStyle.name;
                              15->aTextStyle.size;
                              textFaces.italic->aTextStyle.face
                              
                           exit aTextStyle[]
                           #);
                         
                         
                      do &styledText[]->temp[];
                         '\"In the beginning the Universe was created. This has made a lot of people\n very angry and been widely regarded as a bad move.\" \n -- The Book'-> temp;
                         temp[]->contents;
                         (127,length,italicFontStyle)->setOneStyle;
                         (127,length,blue)->setOneColor;

                      #);
                    
                 do
                    father.size->size;
                    true->bindRight->bindBottom;
                    insertText;
                 #)
            #);
          open::  (#  do (590,355)->size; aTextfield.open #);
          
       #)
  do 0.1 * 0xFFFF -> blue.red;
     0.2 * 0xFFFF -> blue.green;
     0.5 * 0xFFFF -> blue.blue;
     theWindow.open; 
  #)  

