ORIGIN '~beta/newmps/astlevel';
INCLUDE '~beta/newmps/metagrammarcfl';
BODY 'private/astviewerbody';

-- astInterfaceLib: Attributes --

ASTViewer:
  (# <<SLOT ASTViewerLib: attributes>>;
     meta: ^MetaGrammar;
     
     init:
       (# name: ^Text;
       enter name[]
       <<SLOT ASTViewerInit: doPart>>
       #);

     Rule:
       (# symbol: @integer;
          name: ^Text;
          kind: @integer;
          first: ^Item;

          description:
            (# value: ^Text;
            <<SLOT RuleDescription: doPart>>
            exit value[]   
            #);
       #);
     Item:
       (# name: ^Text;
          position: @integer;
          produces: ^Token;
          type: @integer;
          next: ^Item;

          description:
            (# value: ^Text;
            <<SLOT ItemDescription: doPart>>
            exit value[]
            #);
       #);
     itemTypes: @
       (# terminal: (# exit 1 #);
          nonterminal: (# exit 2 #);
          blank: (# exit 3 #);
          beginBlock: (# exit 4 #);
          endBlock: (# exit 5 #);
       #);
     Token:
       (#
       #);
     String: Token
       (# value: ^Text;
       #);
     Blank: Token
       (# spaces: @integer;
          offset: @integer;
       #);
     BeginBlock: Token
       (# type: @integer;
       #);
     EndBlock: Token
       (#
       #);
  #);
