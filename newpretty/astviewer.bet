ORIGIN '~beta/newmps/astlevel';
INCLUDE '~beta/newmps/metagrammarcfl';
INCLUDE '~beta/prettygen/prettyprintcfl';
BODY 'private/astviewerbody';

-- astInterfaceLib: Attributes --

ASTViewer:
  (# <<SLOT ASTViewerLib: attributes>>;
     meta: ^MetaGrammar;
     pretty: ^prettyprint;
     rules: ^RuleTable;
     thePrettyPrinter: ^PrettyPrinter;
     stringChar: @char;
     commentBegin: ^Text;
     commentEnd: ^Text;

     init:
       (# name: ^Text;
       enter name[]
       <<SLOT ASTViewerInit: doPart>>
       #);

     PrettyPrinter:
       (# start:<
            (# columns: @integer;
               output: ^Stream;
            enter (columns, output[])
            do INNER;
            #);
          next:<
            (# theToken: ^Token;
            enter theToken[]
            do INNER;
            #);
          finish:<
            (#
            do INNER;
            #);  
       #);

     presentOn:
       (# root: ^AST;
          columns: @integer;
          output: ^Stream;
          printer: ^PrettyPrinter;
       enter (root[], columns, output[], printer[])
       <<SLOT ASTViewerPresent: doPart>>
       #);
     
     RuleTable:
       (# rules: [400] ^Rule;
          count: @integer;
          get:
            (# symbol: @integer;
               theRule: ^Rule;
            enter symbol
            do rules[symbol][] -> theRule[];
            exit theRule[]
            #);
          dump:
            (# output: ^Stream;
               symbol: @integer;
            enter output[] 
            do 1 -> symbol;
               loop:
                 (if symbol <= count then
                    rules[symbol].description -> output.putLine;
                    symbol + 1 -> symbol;
                    restart loop;
                 if);
            #);
       #);

     Rule:
       (# symbol: @integer;
          name: ^Text;
          kind: @integer;
          beginning: ^Item;
          first: ^Item;
          ending: ^Item;
          description:
            (# value: ^Text;
            <<SLOT RuleDescription: doPart>>
            exit value[]   
            #);
       #);
     Item:
       (# name: ^Text;
          position: @integer;
          produces: ^Token;
          type: @integer;
          next: ^Item;

          description:
            (# value: ^Text;
            <<SLOT ItemDescription: doPart>>
            exit value[]
            #);
       #);
     itemTypes: @
       (# terminal: (# exit 1 #);
          nonterminal: (# exit 2 #);
          blank: (# exit 3 #);
          beginBlock: (# exit 4 #);
          endBlock: (# exit 5 #);
       #);
     Token:
       (# kind: @integer;
          length:<
            (# value: @integer;
            do INNER
            exit value
            #);
          description:<
            (# value: ^Text;
            do INNER
            exit value[]
            #);
       #);
     Word: Token
       (# value: ^Text;
          length::
            (#
            do THIS(Word).value.length -> value;
            #);
          description::
            (#
            do &Text[] -> value[];
               '\'' -> value.put;
               THIS(Word).value[] -> value.putText;
               '\'' -> value.put;
            #);
       #);
     Blank: Token
       (# spaces: @integer;
          indentation: @integer;
          length:: (# do spaces -> value #);
          description::
            (#
            do &Text[] -> value[];
               '$' -> value.put;
               spaces -> value.putInt;
               ',' -> value.put;
               indentation -> value.putInt;
            #);
       #);
     BeginBlock: Token
       (# type: @integer;
          description::
            (#
            do &Text[] -> value[];
               '{' -> value.put;
               (if type
                 //blockTypes.consistent then 'c' -> value.put;
                 //blockTypes.inConsistent then 'i' -> value.put;
                 //blockTypes.always then 'a' -> value.put;
               if);
            #);
       #);
     EndBlock: Token
       (# description::
            (#
            do &Text[] -> value[];
               '}' -> value.put;
            #);
       #);
     tokenKinds: @
       (# word: (# exit 1 #);
          blank: (# exit 2 #);
          beginBlock: (# exit 3 #);
          endBlock: (# exit 4 #);
       #);
     blockTypes: @
       (# consistent: (# exit 1 #);
          inConsistent: (# exit 2 #);
          always: (# exit 3 #);
       #);
  #);
