ORIGIN '~beta/basiclib/betaenv';
-- example: attributes --
Point:
  (# x: @integer;
     y: @integer;
     init:< (# do INNER; #);
     add:
       (# dx, dy: @integer;
       enter (dx, dy)
       do x + dx -> x;
          y + dy -> y;
          loop:
          (if done then leave loop; if);
       #);
  #);
