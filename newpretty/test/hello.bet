ORIGIN '~beta/basiclib/betaenv';
-- example: attributes --
Point:
  (# <<SLOT PointLib: attributes>>;
     x: @integer;
     y: @integer;
     init:< (# do INNER; #);
     add:
       (# dx, dy: @integer;
       enter (dx, dy)
       <<SLOT PointAdd: doPart>>
       #);
  #);

-- program: descriptor --
(#
do 'Hello, World' -> putLine;
#)
