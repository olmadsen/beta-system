ORIGIN '~beta/newpretty/astviewer';
INCLUDE '~beta/newmps/grammarinit'
        '~beta/basiclib/textmatch';
-- program: descriptor --
(# mps: @AstInterface;
   viewer: @mps.AstViewer;
   beta: @mps.beta;
   group: ^astInterface.fragmentGroup;
   name: ^text;
   argument: ^Text;
   spec: @boolean;
   tokens: @boolean;
   dump: @boolean;
   parse: @boolean;

   echo: @viewer.PrettyPrinter
      (# output: ^Stream;
         start::
            (#
            do output[] -> echo.output[];
            #);
         next::
            (#
            do theToken.description -> output.putline;
            #);
      #);
   printer: ^viewer.PrettyPrinter;
   symbolToName:
     (# symbol: @integer;
        name: ^Text;
     enter symbol
     do (# theRule: ^viewer.Rule;
        do symbol -> viewer.rules.get -> theRule[];
           theRule.name[] -> name[];
           (if true
             //'AttributesForm' -> name.equal then
                'attributes' -> name[];
             //'DescriptorForm' -> name.equal then
                'descriptor' -> name[];
           if);
        #);
     exit name[]   
     #);
   inx: @integer;
   width: @integer;
do 120 -> width;
   mps.astLevelInit;
   '~beta/grammars/beta/beta' -> viewer.init;
   ('~beta/grammars/beta/beta', 'beta', screen[]) ->beta.betagrammarInit
    (#
        MPSerror::
        (# do (failure,msg[])->stop #);
        noParserAvailable:: 
        (# do (failure,msg[])->stop #)
    #);
   true -> beta.parser.includeComments;

   2 -> inx;

   loop:
   (if inx <= NoOfArguments then
       inx -> arguments -> argument[];
       (if '-' -> argument.startsWith then
         (if true
            // ('--spec' -> argument.equal) then
               true -> spec;
            // ('--tokens' -> argument.equal)  then
               true -> tokens;
            // ('--dump' -> argument.equal)  then
               true -> dump;
            // ('--parse' -> argument.equal)  then
               true -> parse;   
            // ('--width' -> argument.equal)  then
               inx + 1 -> inx;
               inx -> arguments -> argument[];
               argument.reset;
               argument.getInt -> width;
         if);
      else
         argument[] -> name[];
      if);
      inx + 1 -> inx;
      restart loop;
   if);

   (if spec then
       screen[] -> viewer.rules.dump;
   if);
   (if tokens then
      echo[] -> printer[];
   else
      viewer.thePrettyPrinter[] -> printer[];
   if);
   (if name[] <> NONE then
      (if parse then
         (# betaFileName: ^Text;
            theFile: @File;
         do (if true
                // '.bet' -> name.endsWith then
                   name[] -> betaFileName[];
                // '.ast' -> name.endsWith then
                   (1, name.length - 4) -> name.sub -> betaFileName[];
                  '.bet' -> betaFileName.putText;
            if);
            (if betaFileName[] <> NONE then
                betaFileName[] -> theFile.name;
                'touch ' -> screen.putText;
                betaFileName[] -> screen.putLine;
                thefile.touch;
            if);
         #);
      if);
      (name[], screen[]) -> mps.top.open -> group[];
		 (if group[] <> NONE then
		    group.scan
			   (# frag: ^astInterface.fragmentForm;
				do current[] -> frag[];
					'-- ' -> screen.puttext;
					frag.name -> screen.puttext;
               ': ' -> screen.putText;
               frag.category -> symbolToName -> screen.putText;
					' --' -> screen.putline;
               (if dump then
                  (1, screen[], beta[])  -> frag.root.dump;
               else
                  (frag.root[], width, screen[], printer[]) -> viewer.presentOn;
               if);
               screen.newline;
               screen.newline;
				#);
		 if);
   if);
#)
