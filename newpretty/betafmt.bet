ORIGIN '~beta/newpretty/astviewer';
INCLUDE '~beta/newmps/grammarinit'
        '~beta/basiclib/textmatch';
-- program: descriptor --
(# mps: @AstInterface;
   viewer: @mps.AstViewer;
   beta: @mps.beta;
   group: ^astInterface.fragmentGroup;
   name: ^text;
   argument: ^Text;
   spec: @boolean;
   tokens: @boolean;
   dump: @boolean;
   parse: @boolean;

   echo: @viewer.PrettyPrinter
      (# output: ^Stream;
         start::
            (#
            do output[] -> echo.output[];
            #);
         next::
            (#
            do theToken.description -> output.putline;
            #);
      #);
   printer: ^viewer.PrettyPrinter;
   symbolToName:
     (# symbol: @integer;
        name: ^Text;
     enter symbol
     do (# theRule: ^viewer.Rule;
        do symbol -> viewer.rules.get -> theRule[];
           theRule.name[] -> name[];
           (if true
             //'AttributesForm' -> name.equal then
                'attributes' -> name[];
             //'DescriptorForm' -> name.equal then
                'descriptor' -> name[];
           if);
        #);
     exit name[]   
     #);
   inx: @integer;
   width: @integer;

   usage:
     (#
     do 'Usage: betafmt [options] <file> where possible options are:' -> putline;
        newline;
        '   -width <number>: Set output width to <number>' -> putline;
        newline;
        '   -spec: Print prettyprint specification' -> putline;
        newline;
        '   -parse: Parse the .bet file' -> putline;
        newline;
        '   -dump: Dump the AST' -> putline;
        newline;
        '   -tokens: Dump the stream of tokens' -> putline;
        newline;
        '   -help: Show this information' -> putline;
        newline;
        stop;
     #);
do 120 -> width;
   mps.astLevelInit;
   '~beta/grammars/beta/beta' -> viewer.init;
   ('~beta/grammars/beta/beta', 'beta', screen[]) ->beta.betagrammarInit
    (#
        MPSerror::
        (# do (failure,msg[])->stop #);
        noParserAvailable:: 
        (# do (failure,msg[])->stop #)
    #);
   true -> beta.parser.includeComments;

   (if NoOfArguments < 2 then
      usage;
   if);

   2 -> inx;

   loop:
   (if inx <= NoOfArguments then
       inx -> arguments -> argument[];
       (if '-' -> argument.startsWith then
         (if true
            // ('-spec' -> argument.equal) then
               true -> spec;
            // ('-tokens' -> argument.equal)  then
               true -> tokens;
            // ('-dump' -> argument.equal)  then
               true -> dump;
            // ('-parse' -> argument.equal)  then
               true -> parse;
            // ('-help' -> argument.equal)  then
               usage;   
            // ('-width' -> argument.equal)  then
               inx + 1 -> inx;
               inx -> arguments -> argument[];
               argument.reset;
               argument.getInt -> width;
            else
               usage;   
         if);
      else
         argument[] -> name[];
      if);
      inx + 1 -> inx;
      restart loop;
   if);

   (if spec then
       screen[] -> viewer.rules.dump;
   if);
   (if tokens then
      echo[] -> printer[];
   else
      viewer.thePrettyPrinter[] -> printer[];
   if);
   (if name[] <> NONE then
      (if parse then
         true -> mps.options.forceParse;
      if);
      (name[], screen[]) -> mps.top.open -> group[];
		 (if group[] <> NONE then
          (if group.prop[] <> NONE then
             (# isSpecial:
                  (# name: ^Text;
                     result: @boolean;
                  enter name[]
                  do (if true
                        //'slots' -> name.equalNCS
                        //'donecheck' -> name.equalNCS
                        //'requires' -> name.equalNCS
                        //'unique_group_id' -> name.equalNCS then
                           true -> result;
                     if);
                  exit result
                  #);
             do group.prop.properties.scan
                   (# more: @boolean;
                      indention: @integer;
                   do (if NOT (current.name[] -> isSpecial) then
                          current.name[] ->screen.putText;
                          current.name.length + 1 -> indention;
                          false -> more;
                          current.parameters.scan
                           (# string: ^Text;
                              
                           do (if more then
                                  screen.newLine;
                                   (for indention repeat
                                    ' ' -> screen.put;
                                   for);
                                   false -> more;
                               else 
                                  ' ' -> screen.put;    
                              if);
                              (if current.type
                              //StringValue then
                                 &Text[] -> string[];
                                 '\'' -> string.put;
                                 current.value[] -> string.puttext;
                                 '\'' -> string.put;
                                 string[] -> screen.putText;
                                 true -> more;
                                
                              //ConstValue then
                                 current.value[] -> screen.putText;
                              //NameValue then
                                 current.value[] -> screen.putText;
                              if);
                           #);
                           ';' -> screen.putLine;
                      if);
                   #);
                screen.newLine;   
             #);
          if);
		    group.scan
			   (# frag: ^astInterface.fragmentForm;
				do current[] -> frag[];
					'-- ' -> screen.puttext;
					frag.name -> screen.puttext;
               ': ' -> screen.putText;
               frag.category -> symbolToName -> screen.putText;
					' --' -> screen.putline;
               (if dump then
                  (1, screen[], beta[])  -> frag.root.dump;
               else
                  (frag.root[], width, screen[], printer[]) -> viewer.presentOn;
               if);
               screen.newline;
               screen.newline;
				#);
		 if);
   if);
#)
