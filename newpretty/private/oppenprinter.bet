ORIGIN '../astviewer';
INCLUDE '~beta/containers/seqContainers';

-- ASTViewerLib: attributes --

OppenPrinter: PrettyPrinter
  (# output: ^Stream;
     columns: @integer;
     
     Block: Token
       (# type: @integer;
          size: @integer;
          indentation: @integer;
          fits: @boolean;
          
          length:: (# do size -> value #);

          description::
            (#
            do &Text[] -> value[];
               '{' -> value.put;
               (if type
                 //blockTypes.consistent then 'c' -> value.put;
                 //blockTypes.inConsistent then 'i' -> value.put;
               if);
               '[' -> value.put;
               length -> value.putInt;
               ']' -> value.put;
            #);
       #);
     
     scanner: @
       (# buffer: [0] ^Token;
          left: @integer;
          right: @integer;
          total: @integer;
          stack: @Deque
            (# element:: Block;
            #);
          blanks: @boolean;
          currentBlank: ^Blank;
          consumeBlank:
            (#
            do (if currentBlank[] <> NONE then
                  currentBlank[] -> append;
                  total + currentBlank.length -> total;
                  NONE -> currentBlank[];
               if);
               true -> blanks;
            #);

          start:
            (#
            do 3 * columns -> buffer.new;
               NONE -> currentBlank[];
               1 -> left;
               1 -> right;
               1 -> total;
               false -> blanks;
            #);
          next:
            (# theToken: ^Token;
               theWord: ^Word;
            enter theToken[]
            do (if theToken.kind
                //tokenKinds.word then
                  consumeBlank;
                  theToken[] -> append;
                  total + theToken.length -> total;
                  checkStack;
                  printAvailable;
                //tokenKinds.blank then
                  (if blanks then 
                      theToken[] -> currentBlank[];
                  if);
                //tokenKinds.beginBlock then
                  consumeBlank;
                  theToken[] -> pushBlock -> append;
                //tokenKinds.endBlock then
                  theToken[] -> append;
                  popBlock;
                  printAvailable;
               if);
            #);
          pushBlock:
            (# begin: ^BeginBlock;
               theBlock: ^Block;
            enter begin[]
            do &Block[] -> theBlock[];
               -total -> theBlock.size;
               theBlock[] -> stack.insertBack;
               begin.kind -> theBlock.kind;
               begin.type -> theBlock.type;
            exit theBlock[]   
            #);
          popBlock:
            (# theBlock: ^Block;
            do (if NOT stack.empty then
                  stack.removeBack -> theBlock[];
                  total + theBlock.size -> theBlock.size;
               if);
            #);
          checkStack:
            (# bottom: ^Block;
            do loop:
               (if NOT stack.empty then
                  stack.front -> bottom[];
                  (if bottom.size + total > columns then
                      columns + 1 -> bottom.size;
                      stack.removeFront;
                      restart loop;
                  if);
               if);
            #);
          printAvailable:
            (# theToken: ^Token;
               length: @integer;
            do loop:
               (if left <> right then
                  buffer[left][] -> theToken[];
                  (if theToken.kind
                    //tokenKinds.word then
                      theToken[] -> printer.printWord;
                    //tokenKinds.blank  then
                      buffer[(left mod buffer.range) + 1].length -> length;
                      (if length >= 0 then
                         (theToken[], length) -> printer.printBlank;
                       else
                         leave loop;  
                      if)
                    //tokenKinds.beginBlock then
                      theToken.length -> length;
                      (if length >= 0 then
                          theToken[] -> printer.pushBlock;
                       else
                          leave loop;   
                      if);
                    //tokenKinds.endBlock then
                      printer.popBlock;  
                  if);
                  (left mod buffer.range) + 1 -> left;
                  restart loop;
               if)
            #);
          display:
            (# index: @integer;
            do 1 -> index;
               loop:
                 (if index <> right then
                     buffer[index].description -> output.putLine;
                     index + 1 -> index;
                     restart loop;
                 if);
            #);  
          finish:
            (#
            do 
            #);  
          
          append:
            (# theToken: ^Token;
            enter theToken[]
            do theToken[] -> buffer[right][];
               (right mod buffer.range) + 1 -> right;
            #);
          
          
       #);
     printer: @
       (# space: @integer;
          stack: @Deque
            (# element:: Block;
            #);
          start:
            (#
            do columns -> space;
            #);

          printWord:
            (# theWord: ^Word;
            enter theWord[]
            do theWord.value[] -> output.putText;
               space - theWord.length -> space;
            #);
          printBlank:
            (# theBlank: ^Blank;
               length: @integer;
               top: ^Block;
               breaks: @boolean;
               printInfo:
                 (#
                 do '(* ' -> output.putText;
                    'L: ' -> output.putText;
                    (length + theBlank.spaces) -> output.putInt;
                    ' S: ' -> output.putText;
                    space -> output.putInt;
                    ' B: ' -> output.putText;
                    (if breaks then
                       'Y' -> output.put;
                    else
                       'N' -> output.put;   
                    if);
                    ' *)' -> output.puttext;
                 #);
            enter (theBlank[], length)
            do stack.back -> top[];
               (if top.type = blockTypes.consistent then
                    NOT top.fits -> breaks;
                else
                    (length + theBlank.spaces) > space -> breaks;
               if);
               (if breaks then
                   top.indentation - theBlank.indentation -> space;
                   output.newline;
                   (for (columns - space) repeat
                      ' ' -> output.put;
                   for);
               else
                   (for theBlank.spaces repeat
                      ' ' -> output.put;
                   for);
                   space - theBlank.spaces -> space;
               if);
            #);
          pushBlock:
            (# theBlock: ^Block;
            enter theBlock[]
            do space -> theBlock.indentation;
               theBlock.length <= space -> theBlock.fits;
               theBlock[] -> stack.insertBack;
            #);
          popBlock:
            (#
            do stack.removeBack;
            #);
       #);  
     
     start::
       (#
       do output[] -> THIS(OppenPrinter).output[];
          columns -> THIS(OppenPrinter).columns;
          scanner.start;
          printer.start;
       #);
     next::
       (# 
       do (if scanner.right <= scanner.buffer.range then
              theToken[] -> scanner.next;
          if);
       #);
     finish::
       (# 
       do scanner.finish;
       #); 
  #);
