ORIGIN '../astviewer';
INCLUDE '~beta/newmps/metagramsematt';
INCLUDE '~beta/postwimp/collections/map';
INCLUDE '~beta/containers/seqContainers';
INCLUDE 'oppenprinter';

-- ASTViewerLib: attributes --
ProductionMap: TextHashMap
  (# element:: pretty.Production;
  #);
ItemDeque: Deque
  (# element:: Item;
  #);
GrammarItems:
  (# T: [10] ^Item;
     N: [10] ^Item;
  #);

EchoPrettyPrinter: PrettyPrinter
  (# output: ^Stream;
     start::
       (#
       do output[] -> THIS(EchoPrettyPrinter).output[];
       #);
     next::
       (#
       do theToken.description -> output.putline;
       #);
  #);

openGrammar:
  (# name: ^Text;
     grammar: ^meta.AGrammar;
  enter name[]
  do (# grammarGroup: ^FragmentGroup;
        grammarFragment: ^FragmentForm;
     do ('-meta' -> (name.copy).append, screen[]) -> top.open -> grammarGroup[];
        grammarGroup.scan
          (#
          do current[] -> grammarFragment[];
          #);
        grammarFragment.root[] -> grammar[];
     #);
  exit grammar[]  
  #);
openPrettySpecification:
  (# name: ^Text;
     specification: ^pretty.PrettyPrint;
  enter name[]
  do (# group: ^FragmentGroup;
        frag: ^FragmentForm;
     do ('-pretty' -> (name.copy).append, screen[]) -> top.open -> group[];
        group.scan
          (#
          do current[] -> frag[];
          #);
        frag.root[] -> specification[];
     #);
  exit specification[]
  #);


buildProductionMap:
  (# specification: ^pretty.PrettyPrint;
     map: ^ProductionMap;
  enter specification[]
  do &ProductionMap[] -> map[];
     map.init;
     (# productionList: ^pretty.ProductionList;
     do specification.getProductionList -> productionList[];
        productionList.newScan
        (# constructor: ^pretty.Constructor;
           listProd: ^pretty.ListProd;
           productionName: ^NameAppl;
           name: ^Text;
        do (if current.symbol
             //pretty.Constructor then
                current[] -> constructor[];
                constructor.getProductionName -> productionName[];
                productionName.getText -> name[];
                (name[], constructor[]) -> map.associate;
             //pretty.ListProd then
                current[] -> listProd[];
                listProd.getProductionName -> productionName[];
                productionName.getText -> name[];
                (name[], listProd[]) -> map.associate;
                
           if);
        #);
     #);
  exit map[]
  #);

processGrammar:
  (# grammar: ^meta.AGrammar;
     grammarName: ^meta.GrammarName;
     grammarNameDecl: ^NameDecl;
     productions: ^meta.ProductionList;
     specification: ^pretty.PrettyPrint;
     productionList: ^pretty.ProductionList;
     map: ^ProductionMap;
     table: ^RuleTable;
  enter (grammar[], specification[])
  do grammar.getGrammarName -> grammarName[];
     grammarName.getNameDecl -> grammarNameDecl[];
     grammar.getProductionList -> productions[];
     specification.getProductionList -> productionList[];
     specification[] -> buildProductionMap -> map[];
     &RuleTable[] -> table[];
     productions.newScan
     (# symbol: @integer;
        theRule: ^Rule;
        prettyProduction: ^pretty.Production;
    do symbol + 1 -> symbol;
       current.getSynDeclText -> map.lookup -> prettyProduction[];
       (current[], prettyProduction[]) -> processProduction -> theRule[];
       theRule[] -> table.rules[symbol][];
       table.count + 1 -> table.count;
    #);
    
  exit table[]
  #);

processProduction:
  (# production: ^meta.Prod;
     prettyProduction: ^pretty.Production;
     theRule: ^Rule;
  enter (production[], prettyProduction[])
  do (if production.symbol
        //meta.Alternation then
            production[] -> processAlternation -> theRule[];
        //meta.ListOne then
            (production[], prettyProduction[]) -> processListOne -> theRule[];
        //meta.ListZero then
            production[] -> processListZero -> theRule[];
        //meta.Constructor then
            (production[], prettyProduction[]) -> processConstructor -> theRule[];
        //meta.Opt then
            production[] -> processOpt -> theRule[];
        if);
  exit theRule[]
  #);
processAlternation:
  (# alternation: ^meta.Alternation;
     theRule: ^Rule;
  enter alternation[]
  do &Rule[] -> theRule[];
     alternation.getLeftSide -> getLeftSideName -> theRule.name[];
     kinds.unExpanded -> theRule.kind;
  exit theRule[]
  #);
processListOne:
  (# listOne: ^meta.ListOne;
     prettyProduction: ^pretty.ListProd;
     theRule: ^Rule;
  enter (listOne[], prettyProduction[])
  do (# nonTerminal: ^Item;
        separator: ^Item;
        listSpec: ^pretty.ListSpec;
        current: ^Item;
     do &Rule[] -> theRule[];
        listOne.getLeftSide -> getLeftSideName -> theRule.name[];
        kinds.list -> theRule.kind;
        listOne.getSynCat -> processSynCat -> nonTerminal[];
        listOne.getTermOp -> processTermOp -> separator[];
        prettyProduction.getListSpec -> listSpec[];
        listSpec.getBlockType -> createBeginBlock -> theRule.beginning[];
        createEndBlock -> theRule.ending[];
        nonTerminal[] -> theRule.first[] -> current[];
        (if separator[] <> NONE then
           separator[] -> current.next[];
           separator[] -> current[];
        if);
        createDefaultBreak -> current.next[];
     #);   
  exit theRule[]
  #);
processListZero:
  (# listZero: ^meta.ListZero;
     theRule: ^Rule;
  enter listZero[]
  do &Rule[] -> theRule[];
     listZero.getLeftSide -> getLeftSideName -> theRule.name[];
     kinds.list -> theRule.kind;
     listZero.getSynCat -> processSynCat -> theRule.first[];
     listZero.getTermOp -> processTermOp -> theRule.first.next[];
  exit theRule[]
  #);
processConstructor:
  (# constructor: ^meta.Constructor;
     prettyProduction: ^pretty.Constructor;
     theRule: ^Rule;
  enter (constructor[], prettyProduction[])
  do (# ti: @integer;
        ni: @integer;
        current: ^Item;
        stream: ^pretty.ItemList;
        theGrammarItems: @GrammarItems;
        items: @ItemDeque;
        firstItem: ^Item;
        currentItem: ^Item;
     do &Rule[] -> theRule[];
        constructor.getLeftSide -> getLeftSideName -> theRule.name[];
        kinds.cons -> theRule.kind;
        constructor.getConsElemList -> processConsElemList -> theRule.first[];
        theRule.first[] -> current[];
        loop:
          (if current[] <> NONE then
            (if current.type
                //itemTypes.terminal then
                    ti + 1 -> ti;
                    current[] -> theGrammarItems.T[ti][];
                //itemTypes.nonterminal then
                    ni + 1 -> ni;
                    current[] -> theGrammarItems.N[ni][];
            if);
            current.next[] -> current[];
            restart loop;
          if);
        prettyProduction.getStream -> stream[];
        (theGrammarItems[], stream[], items[]) -> createItemsFromStream;
        items.scan
          (#
          do (if currentItem[] <> NONE then
                current[] -> currentItem.next[];
             else
                current[] -> firstItem[];
             if);
             NONE -> current.next[];
             current[] -> currentItem[];
          #);

        (if firstItem[] <> NONE then
           firstItem[] -> theRule.first[];
        if)  
        
     #)
  exit theRule[]
  #);
createItemsFromStream:
  (# theGrammarItems: ^GrammarItems;
     stream: ^pretty.ItemList;
     items: ^ItemDeque;
  enter (theGrammarItems[], stream[], items[])
  do stream.newScan
          (# 
             defaultTerm: ^pretty.DefaultTerm;
             altTerm: ^pretty.AltTerm;
             nonTerm: ^pretty.NonTerm;
             altBreak: ^pretty.AltBreak;
             theString: ^String;
             block: ^pretty.Block;
             no: ^Const;
             value: @integer;
             space: ^Const;
             indentation: ^Const;
          do (if current.symbol
               //pretty.DefaultTerm then
                  current[] -> defaultTerm[];
                  defaultTerm.getTerminalNo -> no[];
                  no.getValue -> value;
                  theGrammarItems.T[value][] -> items.insertBack;
               //pretty.AltTerm then
                  current[] -> altTerm[];
                  altTerm.getAlternativeTerminal -> theString[];
                  theString.getText -> createTerminalItem -> items.insertBack;
               //pretty.NonTerm then
                  current[] -> nonTerm[];
                  nonTerm.getNonTerminalNo -> no[];
                  no.getValue -> value;
                  theGrammarItems.N[value][] -> items.insertBack;
               //pretty.DefaultBreak then
                 createDefaultBreak ->items.insertBack;
               //pretty.AltBreak then
                 current[] -> altBreak[];
                 altBreak.getSpace -> space[];
                 altBreak.getIndention -> indentation[];
                 (space.getValue, indentation.getValue) -> createBreak -> items.insertBack;
               //pretty.Block then
                 current[] -> block[];
                 block.getBlockType -> createBeginBlock -> items.insertBack;
                 (theGrammarItems[], block.getItemList, items[]) -> createItemsFromStream;
                 createEndBlock -> items.insertBack;
             if);
          #);
  #); 

createTerminalItem:
  (# value: ^Text;
     theItem: ^Item;
     theWord: ^Word;
  enter value[]
  do &Item[] -> theItem[];
     &Word[] -> theWord[];
     tokenKinds.word -> theWord.kind;
     value[] -> theWord.value[];
     theWord[] -> theItem.produces[];
     theWord.value[] -> theItem.name[];
     itemTypes.terminal -> theItem.type;
  exit theItem[]
  #);
createDefaultBreak:
  (# theItem: ^Item;
  do (1, 0) -> createBreak -> theItem[];
  exit theItem[]
  #);
createBreak:
  (# theBlank: ^Blank;
     theItem: ^Item;
     spaces: @integer;
     indentation: @integer;
  enter (spaces, indentation)
  do &Blank[] -> theBlank[];
     tokenKinds.blank -> theBlank.kind;
     spaces -> theBlank.spaces;
     indentation -> theBlank.indentation;
     &Item[] -> theItem[];
     itemTypes.blank -> theItem.type;
     theBlank[] -> theItem.produces[];
     '$' -> theItem.name[];
     spaces -> theItem.name.putInt;
     ',' -> theItem.name.put;
     indentation -> theItem.name.putInt;
  exit theItem[]
  #);
createBeginBlock:
  (# blockType: ^pretty.BlockType;
     theItem: ^Item;
     theToken: ^BeginBlock;
  enter blockType[]
  do &Item[] -> theItem[];
     itemTypes.beginBlock -> theItem.type;
     &BeginBlock[] -> theToken[];
     tokenKinds.beginBlock -> theToken.kind;
     (if blockType.symbol
       //pretty.Consistent then 
          blockTypes.consistent -> theToken.type;
          '[c' -> theItem.name[];
       //pretty.InConsistent then 
          blockTypes.inConsistent -> theToken.type;
          '[i' -> theItem.name[];
     if);
     theToken[] -> theItem.produces[];
  exit theItem[]
  #);
createEndBlock:
  (# theItem: ^Item;
     theToken: ^EndBlock;
  do &Item[] -> theItem[];
     itemTypes.endBlock -> theItem.type;
     &EndBlock[] -> theToken[];
     tokenKinds.endBlock -> theToken.kind;
     theToken[] -> theItem.produces[];
     ']' -> theItem.name[];
  exit theItem[]
  #);
processConsElemList:
  (# consElemList: ^meta.ConsElemList;
     firstItem: ^Item;
     currentItem: ^Item;
     nextItem: ^Item;
  enter consElemList[]
  do loop: consElemList.newScan
       (# position: @integer;
       do position + 1 -> position;
          current[] -> processConsElem -> nextItem[];
          (if nextItem[] = NONE then
             leave loop;
          if);
          position -> nextItem.position;
          (if firstItem[] = NONE then
            nextItem[] -> firstItem[];
          else
            nextItem[] -> currentItem.next[];  
          if);
          nextItem[] -> currentItem[];
       #);
  exit firstItem[]
  #);
processConsElem:
  (# consElem: ^meta.ConsElem;
     theItem: ^Item;
  enter consElem[]
  do (if consElem.symbol
        //meta.Term then 
            consElem[] -> processTerm -> theItem[];
        //meta.SynCat then
            consElem[] -> processSynCat -> theItem[];
        //meta.TaggedSyn then
            consElem[] -> processTaggedSyn -> theItem[];
     if)
  exit theItem[]
  #);
processTermOp:
  (# termOp: ^AST;
     theItem: ^Item;
  enter termOp[]
  do (if termOp.kind <> kinds.optional then
        termOp[] -> processTerm -> theItem[];
     if);
  exit theItem[]
  #);
processTerm:
  (# term: ^meta.Term;
     theItem: ^Item;
     theWord: ^Word;
  enter term[]
  do term.getText -> createTerminalItem -> theItem[];
  exit theItem[]
  #);
processSynCat:
  (# synCat: ^meta.SynCat;
     theItem: ^Item;
  enter synCat[]
  do &Item[] -> theItem[];
     synCat.getSynText -> theItem.name[];
     itemTypes.nonterminal -> theItem.type;
  exit theItem[]
  #);
processTaggedSyn:
  (# taggedSyn: ^meta.TaggedSyn;
     theItem: ^Item;
  enter taggedSyn[]
  do &Item[] -> theItem[];
     taggedSyn.getSynText -> theItem.name[];
     itemTypes.nonterminal -> theItem.type;
  exit theItem[]
  #);

processOpt:
  (# opt: ^meta.Opt;
     theRule: ^Rule;
  enter opt[]
  do &Rule[] -> theRule[];
     opt.getLeftSide -> getLeftSideName -> theRule.name[];
     kinds.optional -> theRule.kind;
  exit theRule[]
  #);
getLeftSideName:
  (# leftSide: ^meta.LeftSide;
     synDeclName: ^meta.SynDeclName;
     decl: ^NameDecl;
     name: ^Text;
  enter leftSide[]
  do leftSide.getSynDeclName -> synDeclName[];
     synDeclName.getNameDecl -> decl[];
     decl.getText -> name[];
  exit name[]
  #);

-- ASTViewerInit: doPart --
do (# 
    do &MetaGrammar[] -> meta[];
       meta.init;
       meta[] -> grammarTable.meta[];
       &prettyprint[] -> pretty[];
       '~beta/grammars/pretty/prettyprint-parser' -> expandToFullPath -> pretty.init;
       (name[] -> openGrammar, name[] -> openPrettySpecification) -> processGrammar -> rules[];
       '\'' -> stringChar;
       (* &EchoPrettyPrinter[] -> thePrettyPrinter[]; *)
       &OppenPrinter[] -> thePrettyPrinter[];
    #);

-- ASTViewerPresent: doPart --
do (# 
      presentAst:
        (# node: ^AST;
        enter node[]
        do (if node.kind
             //kinds.interior then
                (if node.nodeClass
                  //kinds.cons then node[] -> presentCons;
                  //kinds.list then node[] -> presentList;
                if);
             //kinds.nameDecl
             //kinds.nameAppl
             //kinds.const then
               node[] -> presentLexemText;
             //kinds.string then
               node[] -> presentString;
             //kinds.optional then
               (** Nothing **)  
           else
             'KIND: ' -> output.putText;
            node.kind -> output.putInt;
            output.newLine;
           
           if); 
        #);
      presentCons:
        (# node: ^Cons;
           theRule: ^Rule;
           son: ^AST;
           current: ^Item;
        enter node[]
        do node.symbol -> rules.get -> theRule[];
           node.son[] -> son[];
           theRule.first[] -> current[];
           loop:
             (if current[] <> NONE then
                (if current.type = itemTypes.nonterminal then
                   son[] -> presentAst;
                   son.nextBrother -> son[];
                else
                   current.produces[] -> thePrettyPrinter.next;   
                if);
                current.next[] -> current[];
                restart loop;
             if);
        #);
      presentList:
        (# node: ^List;
           theRule: ^Rule;
           son: ^AST;
           current: ^Item;
        enter node[]
        do node.symbol -> rules.get -> theRule[];
           node.son[] -> son[];
           theRule.beginning[] -> current[];
           loop:
             (if current[] <> NONE then
                current.produces[] -> thePrettyPrinter.next;   
                current.next[] -> current[];
                restart loop;
             if);
           loop:
             (if son[] <> NONE then
                son[] -> presentAst;
                son.nextBrother -> son[];
                (if son[] <> NONE then
                  theRule.first[] -> current[];
                  separatorLoop:
                     (if current[] <> NONE then
                        (if current.produces[] <> NONE then
                           current.produces[] -> thePrettyPrinter.next;
                        if);
                        current.next[] -> current[];
                        restart separatorLoop;
                     if);
                  restart loop;
                if);
             if);
            theRule.ending[] -> current[];
            loop:
             (if current[] <> NONE then
                current.produces[] -> thePrettyPrinter.next;   
                current.next[] -> current[];
                restart loop;
             if); 
        #);
      presentLexemText:
        (# node: ^LexemText;
           theToken: ^Word;
        enter node[]
        do &Word[] -> theToken[];
           tokenKinds.word -> theToken.kind;
           node.getText -> theToken.value[];
           theToken[] -> thePrettyPrinter.next;
        #);
      presentString:
        (# node: ^String;
           theToken: ^Word;
        enter node[]
        do &Word[] -> theToken[];
           tokenKinds.word -> theToken.kind;
           node.getText -> escapeText -> theToken.value[];
           theToken[] -> thePrettyPrinter.next;
        #);
      escapeText:
        (# input: ^Text;
           value: ^Text;
        enter input[]
        do &Text[] -> value[];
           stringChar -> value.put;
           input[] -> value.putText;
           stringChar -> value.put;
        exit value[]
        #);  
   do (columns, output[]) -> thePrettyPrinter.start;
      root[] -> presentAst;
      thePrettyPrinter.finish;
   #);

-- RuleDescription: doPart --
do &Text[] -> value[];
    '<' -> value.put;
    name[] -> value.putText;
    '>' -> value.put;
    ' => ' -> value.putText;
    (if kind
        //kinds.optional then 'optional' -> value.putText;
        //kinds.list
        //kinds.cons then
          (# current: ^Item;
          do beginning[] -> current[];
             loop:
               (if current[] <> NONE then
                  current.description -> value.putText;
                  ' ' -> value.putText;
                  current.next[] -> current[];
                  restart loop;
               if);
             first[] -> current[];
             loop:
               (if current[] <> NONE then
                  current.description -> value.putText;
                  ' ' -> value.putText;
                  current.next[] -> current[];
                  restart loop;
               if);
              ending[] -> current[];
              loop:
               (if current[] <> NONE then
                  current.description -> value.putText;
                  ' ' -> value.putText;
                  current.next[] -> current[];
                  restart loop;
               if);
          #);
        //kinds.unExpanded then 'unExpanded' -> value.putText;
    if);

-- ItemDescription: doPart --
do &Text[] -> value[];
   (if type
     //itemTypes.terminal then
        '\'' -> value.put;
       name[] -> value.putText;
       '\'' -> value.put;
     //itemTypes.beginBlock
     //itemTypes.endBlock then
        name[] -> value.putText;
     //itemTypes.nonterminal then
       '<' -> value.put;
       name[] -> value.putText;
       '>' -> value.put;
     //itemTypes.blank then
       name[]-> value.putText;
    
   if);
